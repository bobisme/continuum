[change]
bone = "bn-4x90"
author = "fixture-author"
summary = "fixture: a network pack change with host/Lab, fault coverage, independence review and a version bump"

[pack]
covers = ["crates/continuum-effects-network/src/gov4_fixture_13_18.rs"]

host_lab_conformance_tests = ["crates/continuum-effects-network/tests/gov4_fixture_13_18.rs::host_matches_lab"]
fault_coverage_tests = [
  { test = "crates/continuum-effects-storage/tests/gov4_fixture_13_18.rs::crash_mid_write", fault = "crash" },
  { test = "crates/continuum-effects-storage/tests/gov4_fixture_13_18.rs::partitions_both_ways", fault = "partition" },
]

[pack.independence_review]
reviewer = "continuum-security"
review = "seal-rev-001"
verdict = "approved"

[pack.version_bump]
from = "0.3.0"
to = "0.4.0"
note = "continuum-effects-network widened its contract for this fixture change; consumers must re-pin"
