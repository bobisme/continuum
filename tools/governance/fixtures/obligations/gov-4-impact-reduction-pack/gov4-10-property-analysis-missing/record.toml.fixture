[change]
bone = "bn-2tm3"
author = "fixture-author"
summary = "fixture: a dpor reduction change with a full por_reduction record"

[por_reduction]
covers = ["crates/continuum-engine-dpor/src/gov4_fixture.rs"]
no_reduction_tests = [{ test = "crates/continuum-engine-dpor/tests/gov4_fixture.rs::vs_unreduced", oracle = "continuum-engine-explicit", subject = "continuum-engine-dpor" }]
dependence_mutation_tests = ["crates/continuum-engine-dpor/tests/gov4_fixture.rs::declares_conflicting_events_independent"]

[por_reduction.performance]
metric = "reduction ratio by observer"
note = "continuum-engine-dpor's reduction ratio improved for this change; recorded in the fixture benchmark"

