  "id": "gov-1-03-hashmap-in-canonical-value",
  "requirement": "GOV-1-03",
  "rule": "deterministic-collections",
  "substitute": {
    "crates/continuum-value/src/value.rs": [
      {
        "find": "use std::collections::{BTreeMap, BTreeSet};",
