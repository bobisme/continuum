{
  "description": "a writes x, b writes y, disjoint footprints, declared independent: swapping the order reaches the same state",
  "expect": "clean",
  "system": {
    "kind": "independent-swap",
    "system": {
      "name": "indep-pair",
      "variables": [
        {"name": "x", "type": {"kind": "int", "min": 0, "max": 1}},
        {"name": "y", "type": {"kind": "int", "min": 0, "max": 1}}
      ],
      "init": {"x": 0, "y": 0},
      "obligations": [],
      "transitions": [
        {"name": "a", "process": "p0", "guard": {"op": "eq", "args": [{"var": "x"}, {"const": 0}]}, "updates": {"x": {"const": 1}}, "reads": ["x"], "writes": ["x"]},
        {"name": "b", "process": "p1", "guard": {"op": "eq", "args": [{"var": "y"}, {"const": 0}]}, "updates": {"y": {"const": 1}}, "reads": ["y"], "writes": ["y"]}
      ],
      "independent": [["a", "b"]],
      "conflicts": []
    },
    "pair": ["a", "b"]
  }
}
