{
  "description": "no blob override: the honest snapshot taken after t0, restored and continued with t1, reaches the same state as replaying t0 then t1 from the root",
  "expect": "clean",
  "system": {
    "kind": "snapshot-restore",
    "system": {
      "name": "restore-base",
      "variables": [{"name": "x", "type": {"kind": "int", "min": 0, "max": 2}}],
      "init": {"x": 0},
      "obligations": [],
      "transitions": [
        {"name": "t0", "process": "p0", "guard": {"op": "eq", "args": [{"var": "x"}, {"const": 0}]}, "updates": {"x": {"const": 1}}, "reads": ["x"], "writes": ["x"]},
        {"name": "t1", "process": "p0", "guard": {"op": "eq", "args": [{"var": "x"}, {"const": 1}]}, "updates": {"x": {"const": 2}}, "reads": ["x"], "writes": ["x"]}
      ],
      "independent": [],
      "conflicts": []
    },
    "trace": ["t0", "t1"],
    "checkpoint": 1
  }
}
