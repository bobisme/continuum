{
  "description": "the transformed guard is not(not(eq(x, 0))) — a double-negated, semantically identical rewrite of the base guard eq(x, 0)",
  "expect": "clean",
  "system": {
    "kind": "guard-normalize",
    "base": {
      "name": "guard-base",
      "variables": [{"name": "x", "type": {"kind": "int", "min": 0, "max": 1}}],
      "init": {"x": 0},
      "obligations": [],
      "transitions": [
        {"name": "step", "process": "p0", "guard": {"op": "eq", "args": [{"var": "x"}, {"const": 0}]}, "updates": {"x": {"const": 1}}, "reads": ["x"], "writes": ["x"]}
      ],
      "independent": [],
      "conflicts": []
    },
    "transformed": {
      "name": "guard-base",
      "variables": [{"name": "x", "type": {"kind": "int", "min": 0, "max": 1}}],
      "init": {"x": 0},
      "obligations": [],
      "transitions": [
        {"name": "step", "process": "p0", "guard": {"op": "not", "args": [{"op": "not", "args": [{"op": "eq", "args": [{"var": "x"}, {"const": 0}]}]}]}, "updates": {"x": {"const": 1}}, "reads": ["x"], "writes": ["x"]}
      ],
      "independent": [],
      "conflicts": []
    }
  }
}
