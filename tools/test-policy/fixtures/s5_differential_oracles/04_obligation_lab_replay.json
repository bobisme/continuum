{
  "description": "gen-0: the Lab report claims obligation o_p0 is still open at the end of its run, but replaying the same run against the Continuum obligation model finds it discharged",
  "requirement": "TEST-5-04",
  "rule": "obligation-lab-replay-disagreement",
  "system": {
    "kind": "obligation",
    "system": {
      "conflicts": [],
      "independent": [["p0.s1", "p1.s0"]],
      "init": {"pc_p0": 0, "pc_p1": 0, "v0": 0, "v1": "a"},
      "name": "gen-0",
      "obligations": [{"name": "o_p0", "owner": "p0"}],
      "transitions": [
        {
          "guard": {"args": [{"args": [{"var": "pc_p0"}, {"const": 0}], "op": "eq"}, {"args": [{"var": "v0"}, {"const": 0}], "op": "eq"}], "op": "and"},
          "name": "p0.s0",
          "process": "p0",
          "reads": ["pc_p0", "v0"],
          "updates": {"pc_p0": {"args": [{"var": "pc_p0"}, {"const": 1}], "op": "add"}, "v1": {"const": "c"}},
          "writes": ["pc_p0", "v1"]
        },
        {
          "acquire": ["o_p0"],
          "guard": {"args": [{"var": "pc_p0"}, {"const": 1}], "op": "eq"},
          "name": "p0.s1",
          "process": "p0",
          "reads": ["obligation:o_p0", "pc_p0"],
          "updates": {"pc_p0": {"args": [{"var": "pc_p0"}, {"const": 1}], "op": "add"}},
          "writes": ["obligation:o_p0", "pc_p0"]
        },
        {
          "discharge": ["o_p0"],
          "guard": {"args": [{"var": "pc_p0"}, {"const": 2}], "op": "eq"},
          "name": "p0.s2",
          "process": "p0",
          "reads": ["obligation:o_p0", "pc_p0"],
          "updates": {"pc_p0": {"args": [{"var": "pc_p0"}, {"const": 1}], "op": "add"}, "v1": {"const": "b"}},
          "writes": ["obligation:o_p0", "pc_p0", "v1"]
        },
        {
          "guard": {"args": [{"args": [{"var": "pc_p1"}, {"const": 0}], "op": "eq"}, {"args": [{"var": "v0"}, {"const": 1}], "op": "lt"}], "op": "and"},
          "name": "p1.s0",
          "process": "p1",
          "reads": ["pc_p1", "v0"],
          "updates": {"pc_p1": {"args": [{"var": "pc_p1"}, {"const": 1}], "op": "add"}, "v1": {"const": "a"}},
          "writes": ["pc_p1", "v1"]
        }
      ],
      "variables": [
        {"name": "v0", "type": {"kind": "int", "max": 2, "min": 0}},
        {"name": "v1", "type": {"kind": "enum", "values": ["a", "b", "c"]}},
        {"name": "pc_p0", "type": {"kind": "int", "max": 3, "min": 0}},
        {"name": "pc_p1", "type": {"kind": "int", "max": 1, "min": 0}}
      ]
    },
    "lab_report": {
      "word": ["p0.s0", "p0.s1", "p0.s2", "p1.s0"],
      "claimed_open": ["o_p0"]
    }
  }
}
