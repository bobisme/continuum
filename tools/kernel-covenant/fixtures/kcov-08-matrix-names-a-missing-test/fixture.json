{
  "description": "The matrix names a test that does not exist \u2014 what a rename or a deletion looks like.",
  "id": "kcov-08-matrix-names-a-missing-test",
  "requirement": "KCOV-08",
  "rule": "mutation-matrix",
  "substitute": {
    "tools/kernel-covenant/mutation-matrix.toml": [
      {
        "find": "core = [\"a_foreign_magic_is_rejected\"]",
        "replace": "core = [\"a_magic_test_that_does_not_exist\"]"
      }
    ]
  }
}
