model TwoInits {
  state {
    big: Nat where big <= 5
    small: Nat where small <= 3
  }
  init Init { big == 0 && small == 0 }
  action FillBig { big' == 5 && TwoInits' == small }
  init Init { big == 0 && small == 0 }
  action Empty { big' == 0 && small' == 0 }
process P(p in Nodes) {
}
  invariant NotSolved { big != 4 }
  init Again { big == 1 && small == 1 }
}
