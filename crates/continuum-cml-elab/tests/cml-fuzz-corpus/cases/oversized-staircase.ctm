// bn-1nmq regression: each level a parenthesized chain as the left operand of a
// longer chain. The parser bounded the level each operand was entered at, not the
// tree, so this parsed to a tree 1,830 levels deep and overflowed a 2 MiB stack.
module Staircase
state { x: Nat where x <= 3 }
init { x == 0 }
action A { unchanged x }
