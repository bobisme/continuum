model Nest {
  state {
    big: Nat wher   small: Nat where small <= 3
  }
  init Init { big == 0 && small == 0 }
  action FillBig { big' == 18446744073709551616 && small' == small }
  action Empty { big' == 0 && small' == 0 }
  invariant NotSolved { big != 4 }
  invariant N { ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((big)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) >= 0 }
}
