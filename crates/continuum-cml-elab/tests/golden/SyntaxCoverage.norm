(model SyntaxCoverage
  (sort Proc)
  (enum Phase Idle Busy Done)
  (const Procs Set[Proc])
  (var inbox Map[Proc, Seq[{body: Seq[Nat], dst: Proc, src: Proc}]])
  (var label Map[Proc, Nat] (forall ((p Proc (const Procs))) (lt (index (state label) (bound p)) 10)))
  (var log Seq[(Proc, Nat)])
  (var phase Map[Proc, Phase])
  (init Start
    (eq (state phase) (map-comp ((p Proc (const Procs))) (bound p) (variant Phase Idle)))
    (eq (state inbox) (map-comp ((p Proc (const Procs))) (bound p) (seq Seq[{body: Seq[Nat], dst: Proc, src: Proc}])))
    (eq (state log) (seq Seq[(Proc, Nat)]))
    (eq (state label) (map-comp ((p Proc (const Procs))) (bound p) 0))
  )
  (action Receive ((q Proc))
    (require (ne (index (state inbox) (param q)) (seq Seq[{body: Seq[Nat], dst: Proc, src: Proc}])))
    (next inbox (update (state inbox) (param q) (seq.tail (index (state inbox) (param q)))))
    (next label (update (state label) (param q) (if (ge (index (state label) (param q)) 9) 0 (add (index (state label) (param q)) 1))))
    (next log (seq.append (state log) (tuple (field (seq.head (index (state inbox) (param q))) src) (seq.len (field (seq.head (index (state inbox) (param q))) body)))))
    (relational phase)
    (post (eq (index (primed phase) (field (seq.head (index (state inbox) (param q))) src)) (variant Phase Done)))
  )
  (action Reset ((p Proc))
    (require (eq (index (state phase) (param p)) (variant Phase Done)))
    (unchanged inbox)
    (unchanged label)
    (unchanged log)
    (next phase (update (state phase) (param p) (variant Phase Idle)))
  )
  (action Send ((p Proc) (q Proc) (n Nat))
    (require (eq (index (state phase) (param p)) (variant Phase Idle)))
    (require (ne (param p) (param q)))
    (next inbox (update (state inbox) (param q) (seq.append (index (state inbox) (param q)) (record (body (seq Seq[Nat] (param n) (add (param n) 1))) (dst (param q)) (src (param p))))))
    (unchanged label)
    (unchanged log)
    (next phase (update (state phase) (param p) (variant Phase Busy)))
  )
  (choice Step Receive Reset Send)
  (invariant Arithmetic
    (or (eq (sub (add (neg 1) (mod (div (mul 2 3) 1) 4)) 0) 5) (subseteq (intersect (set Set[Int] 1 2) (set Set[Int] 2)) (set Set[Int] 2)))
  )
  (invariant Collections
    (eq (set-comp ((n Int (range 0 3))) (mul (bound n) 2) (where (ne (bound n) 1))) (set Set[Int] 0 4 6))
    (eq (map.get (map Map[Int, Int] (1 2) (3 4)) 1) (some 2))
    (eq (diff (const Procs) (set Set[Proc])) (const Procs))
    (exists ((p Proc) (q Proc (const Procs))) (notin (bound p) (set Set[Proc] (bound q))))
  )
  (invariant LabelsBounded
    (forall ((p Proc (const Procs))) (in (index (state label) (bound p)) (range 0 9)))
  )
  (invariant Logic
    (implies true (implies false (not true)))
    (iff (ne "busy" "idle\n") (eq (tuple 1 2) (tuple 1 2)))
  )
  (fairness strong Receive)
  (fairness strong Reset)
  (behavior Live (and (always (eventually (eq (state phase) (state phase)))) (leads_to true false)))
)
