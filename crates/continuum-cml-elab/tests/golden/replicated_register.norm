(model ReplicatedRegister
  (sort Node)
  (sort Value)
  (const Nodes Set[Node])
  (const Quorum Set[Set[Node]])
  (var alive Set[Node])
  (var chosen Map[Nat, Value])
  (var stable Map[Node, Map[Nat, Value]])
  (init
    (eq (state chosen) (map Map[Nat, Value]))
    (eq (state stable) (map-comp ((n Node (const Nodes))) (bound n) (map Map[Nat, Value])))
    (eq (state alive) (const Nodes))
  )
  (action Choose ((epoch Nat) (value Value) (q Set[Node]))
    (require (in (param q) (const Quorum)))
    (require (forall ((n Node (param q))) (eq (map.get (index (state stable) (bound n)) (param epoch)) (some (param value)))))
    (require (in (map.get (state chosen) (param epoch)) (set Set[Option[Value]] (none Option[Value]) (some (param value)))))
    (unchanged alive)
    (next chosen (map.put (state chosen) (param epoch) (param value)))
    (unchanged stable)
  )
  (action Crash ((n Node))
    (require (in (param n) (state alive)))
    (next alive (diff (state alive) (set Set[Node] (param n))))
    (unchanged chosen)
    (unchanged stable)
  )
  (action Recover ((n Node))
    (require (notin (param n) (state alive)))
    (next alive (union (state alive) (set Set[Node] (param n))))
    (unchanged chosen)
    (unchanged stable)
  )
  (action Stabilize ((n Node) (epoch Nat) (value Value))
    (require (in (param n) (state alive)))
    (require (in (map.get (index (state stable) (param n)) (param epoch)) (set Set[Option[Value]] (none Option[Value]) (some (param value)))))
    (unchanged alive)
    (unchanged chosen)
    (next stable (update (state stable) (param n) (map.put (index (state stable) (param n)) (param epoch) (param value))))
  )
  (invariant Agreement
    (forall ((epoch Nat) (v1 Value) (v2 Value)) (implies (and (eq (map.get (state chosen) (bound epoch)) (some (bound v1))) (eq (map.get (state chosen) (bound epoch)) (some (bound v2)))) (eq (bound v1) (bound v2))))
  )
  (invariant StableWitness
    (forall ((epoch Nat) (value Value)) (implies (eq (map.get (state chosen) (bound epoch)) (some (bound value))) (exists ((q Set[Node] (const Quorum))) (forall ((n Node (bound q))) (eq (map.get (index (state stable) (bound n)) (bound epoch)) (some (bound value)))))))
  )
  (fairness weak Recover)
)
