(model DieHard
  (var big Nat (le (state big) 5))
  (var small Nat (le (state small) 3))
  (init Init
    (eq (state big) 0)
    (eq (state small) 0)
  )
  (action BigToSmall ()
    (next big (sub (state big) (sub (min (add (state big) (state small)) 3) (state small))))
    (next small (min (add (state big) (state small)) 3))
  )
  (action EmptyBig ()
    (next big 0)
    (unchanged small)
  )
  (action EmptySmall ()
    (unchanged big)
    (next small 0)
  )
  (action FillBig ()
    (next big 5)
    (unchanged small)
  )
  (action FillSmall ()
    (unchanged big)
    (next small 3)
  )
  (action SmallToBig ()
    (next big (min (add (state big) (state small)) 5))
    (next small (sub (state small) (sub (min (add (state big) (state small)) 5) (state big))))
  )
  (choice Next BigToSmall EmptyBig EmptySmall FillBig FillSmall SmallToBig)
  (invariant NotSolved
    (ne (state big) 4)
  )
  (invariant TypeOK
    (in (state big) (range 0 5))
    (in (state small) (range 0 3))
  )
  (behavior Spec (and (init-ref Init) (always (or (step Next) (stutter)))))
)
