(model CoffeeCan
  (const MaxBeans Nat)
  (var black Nat)
  (var white Nat)
  (init
    (in (state white) (range 0 (const MaxBeans)))
    (in (state black) (range 0 (const MaxBeans)))
    (ge (add (state white) (state black)) 1)
  )
  (action PickDifferentColor ()
    (require (ge (state white) 1))
    (require (ge (state black) 1))
    (next black (sub (state black) 1))
    (unchanged white)
  )
  (action PickSameColorBlack ()
    (require (ge (state black) 2))
    (next black (sub (state black) 1))
    (unchanged white)
  )
  (action PickSameColorWhite ()
    (require (ge (state white) 2))
    (next black (add (state black) 1))
    (next white (sub (state white) 2))
  )
  (choice Next PickDifferentColor PickSameColorBlack PickSameColorWhite)
  (invariant NotEmpty
    (ge (add (state white) (state black)) 1)
  )
  (invariant WhiteParity
    (or (eq (mod (state white) 2) 0) (eq (mod (state white) 2) 1))
  )
)
