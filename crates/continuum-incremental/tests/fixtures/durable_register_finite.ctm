// A finite, configuration-free concretization of notes/plan/examples/durable_register.ctm,
// for the PR-22A / IMPL-03 invalidation-precision baseline (bn-3gf6). The spike engine
// lowers without a run configuration, so sorts, sets and maps are unrolled: three
// replicas, one epoch, two values, and the three majority quorums.
//
// Replica i's slot: s_i holds the bytes (0 none, 1 or 2 a value) and p_i is 1 while a
// write is in flight. A slot is free (s 0, p 0), reserved (s 0, p 1), volatile (s v,
// p 1) or durable (s v, p 0). a_v is 1 once value v is acknowledged.
//
// Two parts of the example are folded into the encoding. `Abort` is `Lose` on a reserved
// slot, and `OneValuePerSlot` holds by construction, because a slot is one scalar.
model DurableRegisterFinite {
  state {
    s1: Nat where s1 <= 2
    s2: Nat where s2 <= 2
    s3: Nat where s3 <= 2
    p1: Nat where p1 <= 1
    p2: Nat where p2 <= 1
    p3: Nat where p3 <= 1
    a1: Nat where a1 <= 1
    a2: Nat where a2 <= 1
  }

  init Init { s1 == 0 && s2 == 0 && s3 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && a1 == 0 && a2 == 0 }

  // Replica 1 takes the write permit for its free slot.
  action Reserve1 { s1 == 0 && p1 == 0 && p1' == 1 && s1' == s1 && s2' == s2 && s3' == s3 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Submit1v1 { p1 == 1 && s1 == 0 && s1' == 1 && s2' == s2 && s3' == s3 && p1' == p1 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Submit1v2 { p1 == 1 && s1 == 0 && s1' == 2 && s2' == s2 && s3' == s3 && p1' == p1 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Sync1 { p1 == 1 && s1 != 0 && p1' == 0 && s1' == s1 && s2' == s2 && s3' == s3 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  // A crash loses replica 1's in-flight write, never a durable one.
  action Lose1 { p1 == 1 && s1' == 0 && p1' == 0 && s2' == s2 && s3' == s3 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  // Replica 2 takes the write permit for its free slot.
  action Reserve2 { s2 == 0 && p2 == 0 && p2' == 1 && s1' == s1 && s2' == s2 && s3' == s3 && p1' == p1 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Submit2v1 { p2 == 1 && s2 == 0 && s2' == 1 && s1' == s1 && s3' == s3 && p1' == p1 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Submit2v2 { p2 == 1 && s2 == 0 && s2' == 2 && s1' == s1 && s3' == s3 && p1' == p1 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Sync2 { p2 == 1 && s2 != 0 && p2' == 0 && s1' == s1 && s2' == s2 && s3' == s3 && p1' == p1 && p3' == p3 && a1' == a1 && a2' == a2 }

  // A crash loses replica 2's in-flight write, never a durable one.
  action Lose2 { p2 == 1 && s2' == 0 && p2' == 0 && s1' == s1 && s3' == s3 && p1' == p1 && p3' == p3 && a1' == a1 && a2' == a2 }

  // Replica 3 takes the write permit for its free slot.
  action Reserve3 { s3 == 0 && p3 == 0 && p3' == 1 && s1' == s1 && s2' == s2 && s3' == s3 && p1' == p1 && p2' == p2 && a1' == a1 && a2' == a2 }

  action Submit3v1 { p3 == 1 && s3 == 0 && s3' == 1 && s1' == s1 && s2' == s2 && p1' == p1 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Submit3v2 { p3 == 1 && s3 == 0 && s3' == 2 && s1' == s1 && s2' == s2 && p1' == p1 && p2' == p2 && p3' == p3 && a1' == a1 && a2' == a2 }

  action Sync3 { p3 == 1 && s3 != 0 && p3' == 0 && s1' == s1 && s2' == s2 && s3' == s3 && p1' == p1 && p2' == p2 && a1' == a1 && a2' == a2 }

  // A crash loses replica 3's in-flight write, never a durable one.
  action Lose3 { p3 == 1 && s3' == 0 && p3' == 0 && s1' == s1 && s2' == s2 && p1' == p1 && p2' == p2 && a1' == a1 && a2' == a2 }

  // Acknowledge value 1 once a majority holds it durably.
  action Ack1 {
    ((s1 == 1 && p1 == 0 && s2 == 1 && p2 == 0) || (s1 == 1 && p1 == 0 && s3 == 1 && p3 == 0) || (s2 == 1 && p2 == 0 && s3 == 1 && p3 == 0))
    a1' == 1
    s1' == s1 && s2' == s2 && s3' == s3 && p1' == p1 && p2' == p2 && p3' == p3 && a2' == a2
  }

  // Acknowledge value 2 once a majority holds it durably.
  action Ack2 {
    ((s1 == 2 && p1 == 0 && s2 == 2 && p2 == 0) || (s1 == 2 && p1 == 0 && s3 == 2 && p3 == 0) || (s2 == 2 && p2 == 0 && s3 == 2 && p3 == 0))
    a2' == 1
    s1' == s1 && s2' == s2 && s3' == s3 && p1' == p1 && p2' == p2 && p3' == p3 && a1' == a1
  }

  action Next = Reserve1 | Submit1v1 | Submit1v2 | Sync1 | Lose1 | Reserve2 | Submit2v1 | Submit2v2 | Sync2 | Lose2 | Reserve3 | Submit3v1 | Submit3v2 | Sync3 | Lose3 | Ack1 | Ack2

  behavior Spec = Init && always(step(Next) || stutter(state))
  invariant TypeOK { s1 in 0..2 && s2 in 0..2 && s3 in 0..2 && a1 in 0..1 && a2 in 0..1 }
  invariant Agreement { a1 == 0 || a2 == 0 } // no epoch is acknowledged with two values
  invariant AckedIsDurable { (a1 == 0 || ((s1 == 1 && p1 == 0 && s2 == 1 && p2 == 0) || (s1 == 1 && p1 == 0 && s3 == 1 && p3 == 0) || (s2 == 1 && p2 == 0 && s3 == 1 && p3 == 0))) && (a2 == 0 || ((s1 == 2 && p1 == 0 && s2 == 2 && p2 == 0) || (s1 == 2 && p1 == 0 && s3 == 2 && p3 == 0) || (s2 == 2 && p2 == 0 && s3 == 2 && p3 == 0))) }
}
