{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.dev/schema/assurance-result.json",
  "title": "Continuum Assurance Result",
  "type": "object",
  "$defs": {
    "envelope_dimension": {
      "description": "B11 envelope dimension: names its producing engine or carries a typed Unsupported(reason). A dimension is never silently omitted.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "engine",
            "summary"
          ],
          "properties": {
            "engine": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "unsupported"
          ],
          "properties": {
            "unsupported": {
              "description": "Typed Unsupported reason, e.g. sequential-consistency-only (plan B11).",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "format",
    "version",
    "claim",
    "verdict",
    "scope",
    "envelope",
    "evidence",
    "trusted_components",
    "limitations"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "inconclusive"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "inconclusive_reason"
        ]
      }
    }
  ],
  "properties": {
    "format": {
      "const": "continuum-assurance-result"
    },
    "version": {
      "type": "string"
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "predicate_hash",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "safety",
            "liveness",
            "refinement",
            "conformance",
            "hyperproperty",
            "timed",
            "probabilistic",
            "well-formedness"
          ]
        },
        "predicate_hash": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "description": "Budget exhaustion is never a verdict (plan §11.4); it is the BudgetExhausted error with a continuation.",
      "enum": [
        "established",
        "refuted",
        "inconclusive",
        "unsupported",
        "engine-error"
      ]
    },
    "inconclusive_reason": {
      "description": "Typed reason required by INV-008 when verdict is inconclusive (plan §11.4).",
      "enum": [
        "Unsupported",
        "ResourceExhausted",
        "EngineError",
        "InsufficientTelemetry",
        "AbstractionAmbiguity",
        "IncompleteProofSearch"
      ]
    },
    "envelope": {
      "description": "B11 assurance envelope: all nine dimensions required; each names its producing engine or carries a typed Unsupported(reason). Until the weak-memory lane ships (ADR-0032), memory_model reads Unsupported(sequential-consistency-only).",
      "type": "object",
      "required": [
        "bounds",
        "faults",
        "fairness",
        "values",
        "schedules",
        "memory_model",
        "observer",
        "proof_status",
        "unknowns"
      ],
      "properties": {
        "bounds": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "faults": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "fairness": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "values": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "schedules": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "memory_model": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "observer": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "proof_status": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "unknowns": {
          "$ref": "#/$defs/envelope_dimension"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "semantics_version",
        "subject_hash"
      ],
      "properties": {
        "semantics_version": {
          "type": "string"
        },
        "subject_hash": {
          "type": "string"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": true
        },
        "pack_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instrumentation_profile": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "formal_hash": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "engine",
          "artifact_hash"
        ],
        "properties": {
          "kind": {
            "enum": [
              "example",
              "sampled",
              "bounded-schedules",
              "dpor-complete",
              "finite-exact",
              "symbolic-bounded",
              "inductive",
              "parameterized",
              "liveness-proof",
              "refinement-proof",
              "production-observation",
              "differential",
              "certificate"
            ]
          },
          "engine": {
            "type": "string"
          },
          "engine_version": {
            "type": "string"
          },
          "artifact_hash": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": true
          },
          "complete": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "trusted_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "independently_checked": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "bound",
              "assumption",
              "unsupported",
              "telemetry",
              "solver-trust",
              "abstraction",
              "resource",
              "known-unsound"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reproducer": {
      "type": "string"
    },
    "certificate": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
