{
  "$id": "https://continuum.dev/schema/semantic-diff.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Fail-closed rule (plan §5.3): a protected intent change classified unknown, unsupported, or incomparable blocks ordinary promotion pending review — the policy decision must be block or review.",
      "if": {
        "properties": {
          "intent_changes": {
            "contains": {
              "properties": {
                "protected": {
                  "const": true
                },
                "relation": {
                  "enum": [
                    "unknown",
                    "unsupported",
                    "incomparable"
                  ]
                }
              },
              "required": [
                "protected",
                "relation"
              ]
            }
          }
        },
        "required": [
          "intent_changes"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "decision": {
                "enum": [
                  "block",
                  "review"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "after_intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "after_snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "before_intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "before_snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "diff_id": {
      "pattern": "^diff_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "impact": {
      "additionalProperties": false,
      "properties": {
        "invalidated": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "reused": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "unknown": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "invalidated",
        "reused",
        "unknown"
      ],
      "type": "object"
    },
    "intent_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "field": {
            "enum": [
              "properties",
              "assumptions",
              "observers",
              "abstraction_maps",
              "scope",
              "trust_boundaries",
              "bounds",
              "faults",
              "fairness",
              "completion_policy",
              "nondeterminism",
              "assurance",
              "optimization",
              "non_vacuity",
              "security_policy"
            ]
          },
          "protected": {
            "type": "boolean"
          },
          "relation": {
            "enum": [
              "unchanged",
              "strengthened",
              "weakened",
              "expanded",
              "contracted",
              "refined",
              "coarsened",
              "merged",
              "split",
              "upgraded",
              "downgraded",
              "added",
              "removed",
              "incomparable",
              "unsupported",
              "unknown"
            ]
          }
        },
        "required": [
          "field",
          "relation",
          "protected"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "review",
            "block",
            "unknown"
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "decision",
        "reasons"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "diff_id",
    "before_snapshot",
    "after_snapshot",
    "before_intent",
    "after_intent",
    "intent_changes",
    "semantic_changes",
    "impact",
    "policy"
  ],
  "title": "Semantic Diff",
  "type": "object"
}
