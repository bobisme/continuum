{
  "$id": "https://continuum.dev/schema/v1/semantic-diff.json",
  "schema_epoch": 1,
  "schema_kind": "artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Fail-closed rule (plan §5.3): a protected intent change classified unknown, unsupported, or incomparable blocks ordinary promotion pending review — the policy decision must be block or review.",
      "if": {
        "properties": {
          "intent_changes": {
            "contains": {
              "properties": {
                "protected": {
                  "const": true
                },
                "relation": {
                  "enum": [
                    "unknown",
                    "unsupported",
                    "incomparable"
                  ]
                }
              },
              "required": [
                "protected",
                "relation"
              ]
            }
          }
        },
        "required": [
          "intent_changes"
        ]
      },
      "then": {
        "properties": {
          "policy": {
            "properties": {
              "decision": {
                "enum": [
                  "block",
                  "review"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "after_intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "after_snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "before_intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "before_snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "diff_id": {
      "pattern": "^diff_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "impact": {
      "additionalProperties": false,
      "properties": {
        "invalidated": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "reused": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "unknown": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "invalidated",
        "reused",
        "unknown"
      ],
      "type": "object"
    },
    "intent_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "field": {
            "enum": [
              "properties",
              "assumptions",
              "observers",
              "abstraction_maps",
              "scope",
              "trust_boundaries",
              "bounds",
              "faults",
              "fairness",
              "completion_policy",
              "nondeterminism",
              "assurance",
              "optimization",
              "non_vacuity",
              "security_policy"
            ]
          },
          "fragment": {
            "description": "Declared semantic fragment (ADR-0025) the change's relation was classified in; outside declared fragments the relation is unsupported (RFC 0031).",
            "enum": [
              "Finite",
              "Symbolic",
              "Temporal",
              "Probabilistic",
              "Theorem",
              "Runtime"
            ]
          },
          "protected": {
            "$comment": "Fail-closed (review 5, A1): protection derives from the field enum — every member of `field` is in the RFC 0037 protected set, so a listed intent change is always protected. The constant keeps the wire shape while making an unprotected classification unrepresentable.",
            "const": true
          },
          "relation": {
            "enum": [
              "unchanged",
              "strengthened",
              "weakened",
              "expanded",
              "contracted",
              "refined",
              "coarsened",
              "merged",
              "split",
              "upgraded",
              "downgraded",
              "added",
              "removed",
              "incomparable",
              "unsupported",
              "unknown"
            ]
          }
        },
        "required": [
          "field",
          "relation",
          "protected"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$comment": "No `unknown` decision (review 5, A1): an unknown classification cannot be expressed as a structurally blocking decision in this artifact, so it fails closed to block or review at classification time.",
          "enum": [
            "allow",
            "review",
            "block"
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "decision",
        "reasons"
      ],
      "type": "object"
    },
    "requested_assurance": {
      "description": "Requested assurance for the classification itself — the RFC 0031 diff input.",
      "type": "string"
    },
    "schema_id": {
      "const": "https://continuum.dev/schema/semantic-diff.json",
      "description": "Artifact-class identity of the governing schema: its `$id` with the `v<schema_epoch>/` segment removed (schemas/README.md). Stable across schema epochs."
    },
    "schema_epoch": {
      "const": 1,
      "description": "Schema epoch this instance was written against (schemas/README.md). It advances only on a breaking change to this artifact class, is not one of the six independently versioned epochs (RFC 0026 `rule versioning.epoch_independence`), and pins no semantics."
    },
    "semantic_changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fragment": {
            "description": "Declared semantic fragment (ADR-0025) the change was classified in (RFC 0031).",
            "enum": [
              "Finite",
              "Symbolic",
              "Temporal",
              "Probabilistic",
              "Theorem",
              "Runtime"
            ]
          },
          "kind": {
            "description": "RFC 0031 semantic-change axis.",
            "enum": [
              "effects",
              "atomicity",
              "task_ownership",
              "cancellation_structure",
              "durability_ordering",
              "observer_publication",
              "correspondence"
            ]
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_id",
    "schema_epoch",
    "diff_id",
    "before_snapshot",
    "after_snapshot",
    "before_intent",
    "after_intent",
    "intent_changes",
    "semantic_changes",
    "impact",
    "policy"
  ],
  "title": "Semantic Diff",
  "type": "object"
}
