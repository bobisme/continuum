{
  "$id": "https://continuum.dev/schema/context-pack.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "envelope_dimension": {
      "$comment": "mirrored from assurance-result.schema.json; identity-checked by the validator",
      "description": "B11 envelope dimension: names its producing engine or carries a typed Unsupported(reason). A dimension is never silently omitted.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "engine",
            "summary"
          ],
          "properties": {
            "engine": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "unsupported"
          ],
          "properties": {
            "unsupported": {
              "description": "Typed Unsupported(reason) object (plan B11).",
              "type": "object",
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "description": "Typed Unsupported reason, e.g. sequential-consistency-only (plan B11).",
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "assurance_envelope": {
      "$comment": "mirrored from assurance-result.schema.json; identity-checked by the validator",
      "description": "B11 assurance envelope: all nine dimensions required; each names its producing engine or carries a typed Unsupported(reason). Until the weak-memory lane ships (ADR-0032), memory_model reads Unsupported(sequential-consistency-only).",
      "type": "object",
      "required": [
        "bounds",
        "faults",
        "fairness",
        "values",
        "schedules",
        "memory_model",
        "observer",
        "proof_status",
        "unknowns"
      ],
      "properties": {
        "bounds": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "faults": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "fairness": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "values": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "schedules": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "memory_model": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "observer": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "proof_status": {
          "$ref": "#/$defs/envelope_dimension"
        },
        "unknowns": {
          "$ref": "#/$defs/envelope_dimension"
        }
      },
      "additionalProperties": false
    },
    "redacted": {
      "$comment": "mirrored from redacted.schema.json; identity-checked by the validator",
      "additionalProperties": false,
      "description": "Typed Redacted(reason, commitment) stub (plan §4.5). Mirrors redacted.schema.json; inlined to keep this file self-contained.",
      "properties": {
        "commitment": {
          "description": "Content commitment (hash) of the redacted original.",
          "type": "string"
        },
        "original_class": {
          "description": "Artifact class of the redacted original (plan §4.4 prefix, e.g. crash, ctx, proof).",
          "type": "string"
        },
        "reason": {
          "enum": [
            "summarized",
            "lost",
            "purged"
          ]
        },
        "redacted": {
          "const": true
        }
      },
      "required": [
        "redacted",
        "reason",
        "commitment",
        "original_class"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "INV-008: inconclusive is never untyped (plan §11.4).",
      "if": {
        "properties": {
          "verdict": {
            "const": "inconclusive"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "inconclusive_reason"
        ]
      }
    }
  ],
  "properties": {
    "assurance": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "observed",
            "sampled",
            "bounded",
            "validated",
            "proved"
          ]
        },
        "envelope": {
          "$ref": "#/$defs/assurance_envelope"
        }
      },
      "required": [
        "class",
        "envelope"
      ],
      "type": "object"
    },
    "content_budget": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "nodes": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "content_hash": {
      "description": "Canonical content identity of the pack (ADR-0013).",
      "type": "string"
    },
    "context_id": {
      "pattern": "^ctx_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "debugger_branch": {
      "anyOf": [
        {
          "pattern": "^dbg_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Debugger branch the pack was assembled on, when any (plan §4.4 dbg_ handle)."
    },
    "evidence": {
      "items": {
        "pattern": "^ev_[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "expansions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "type": "string"
          },
          "estimated_items": {
            "minimum": 0,
            "type": "integer"
          },
          "relation": {
            "type": "string"
          }
        },
        "required": [
          "relation",
          "anchor"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "guarantees": {
      "items": {
        "enum": [
          "ReplayPreserving",
          "PropertyPreserving",
          "ProofRelevant",
          "HeuristicRelevant",
          "OneMinimal",
          "CardinalityMinimal",
          "CausallyMinimal",
          "ValueMinimal",
          "OwnerMinimal",
          "FaultMinimal",
          "ExplanationMinimal",
          "CausallyClosed",
          "CounterfactualUnderNamedModel"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "inconclusive_reason": {
      "description": "Typed reason required by INV-008 when verdict is inconclusive (plan §11.4); vocabulary mirrors assurance-result.schema.json. Unsupported and engine-error outcomes are inconclusive with reason Unsupported/EngineError, never verdicts.",
      "enum": [
        "Unsupported",
        "ResourceExhausted",
        "EngineError",
        "InsufficientTelemetry",
        "AbstractionAmbiguity",
        "IncompleteProofSearch"
      ]
    },
    "intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "omissions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "expandable": {
            "type": "boolean"
          },
          "expansion": {
            "additionalProperties": false,
            "description": "Expansion query retrieving the omitted items (RFC 0028).",
            "properties": {
              "anchor": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "anchor"
            ],
            "type": "object"
          },
          "kind": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "budget",
              "redaction",
              "unsupported",
              "heuristic-cutoff",
              "slice-irrelevant"
            ]
          }
        },
        "required": [
          "kind",
          "count",
          "reason"
        ],
        "if": {
          "properties": {
            "expandable": {
              "const": true
            }
          },
          "required": [
            "expandable"
          ]
        },
        "then": {
          "required": [
            "expansion"
          ]
        },
        "type": "object"
      },
      "type": "array"
    },
    "question": {
      "type": "string"
    },
    "redactions": {
      "description": "Redacted values referenced by this pack (plan §4.5, §18.4).",
      "items": {
        "$ref": "#/$defs/redacted"
      },
      "type": "array"
    },
    "replay": {
      "anyOf": [
        {
          "pattern": "^crash_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_epoch": {
      "description": "Pinned semantic epoch; ReplayPreserving is defined relative to it (RFC 0028).",
      "type": "string"
    },
    "selected": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "event",
              "state_delta",
              "source",
              "model",
              "proof",
              "assumption",
              "counterfactual",
              "obligation_flow",
              "order_constraint",
              "repair_surface",
              "unknown"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "verdict": {
      "description": "Verdict vocabulary aligned with assurance-result.schema.json: unsupported and engine-error outcomes are inconclusive with a typed reason (INV-008), never top-level verdicts.",
      "enum": [
        "satisfied",
        "refuted",
        "deadlock",
        "inconclusive"
      ]
    },
    "snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "snapshot",
    "intent",
    "question",
    "verdict",
    "assurance",
    "selected",
    "omissions",
    "expansions",
    "evidence",
    "replay",
    "guarantees",
    "semantic_epoch",
    "content_hash"
  ],
  "title": "Context Pack",
  "type": "object"
}
