{
  "$id": "https://continuum.dev/schema/context-pack.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assurance": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "observed",
            "sampled",
            "bounded",
            "validated",
            "proved"
          ]
        },
        "envelope": {
          "additionalProperties": false,
          "description": "Every dimension names its producer or reads a typed unsupported value; dimensions are never silently omitted (plan B11).",
          "properties": {
            "bounds": {
              "type": "object"
            },
            "fairness": {
              "type": [
                "string",
                "null"
              ]
            },
            "memory_model": {
              "enum": [
                "sequential-consistency",
                "c11-fragment",
                "unsupported"
              ]
            },
            "observer": {
              "type": [
                "string",
                "null"
              ]
            },
            "proof_status": {
              "enum": [
                "none",
                "finite-closure-certificate",
                "checked-certificate",
                "trusted-solver",
                "kernel-checked",
                "unsupported"
              ]
            },
            "schedules": {
              "enum": [
                "exhaustive",
                "reduced",
                "sampled",
                "unsupported"
              ]
            },
            "values": {
              "type": [
                "string",
                "null"
              ]
            },
            "unknowns": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "bounds",
            "schedules",
            "memory_model",
            "proof_status",
            "unknowns"
          ],
          "type": "object"
        }
      },
      "required": [
        "class",
        "envelope"
      ],
      "type": "object"
    },
    "content_budget": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "nodes": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "content_hash": {
      "description": "Canonical content identity of the pack (ADR-0013).",
      "type": "string"
    },
    "context_id": {
      "pattern": "^ctx_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "debugger": {
      "anyOf": [
        {
          "pattern": "^dbg_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "items": {
        "pattern": "^ev_[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "expansions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "type": "string"
          },
          "estimated_items": {
            "minimum": 0,
            "type": "integer"
          },
          "relation": {
            "type": "string"
          }
        },
        "required": [
          "relation",
          "anchor"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "guarantees": {
      "items": {
        "enum": [
          "ReplayPreserving",
          "PropertyPreserving",
          "ProofRelevant",
          "HeuristicRelevant",
          "OneMinimal",
          "CardinalityMinimal",
          "CausallyMinimal",
          "ValueMinimal",
          "OwnerMinimal",
          "FaultMinimal",
          "ExplanationMinimal",
          "CausallyClosed",
          "CounterfactualUnderNamedModel"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "omissions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "minimum": 0,
            "type": "integer"
          },
          "expandable": {
            "type": "boolean"
          },
          "expansion": {
            "additionalProperties": false,
            "description": "Expansion query retrieving the omitted items (RFC 0028).",
            "properties": {
              "anchor": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "anchor"
            ],
            "type": "object"
          },
          "kind": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "budget",
              "redaction",
              "unsupported",
              "heuristic-cutoff",
              "slice-irrelevant"
            ]
          }
        },
        "required": [
          "kind",
          "count",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "question": {
      "type": "string"
    },
    "replay": {
      "anyOf": [
        {
          "pattern": "^crash_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_epoch": {
      "description": "Pinned semantic epoch; ReplayPreserving is defined relative to it (RFC 0028).",
      "type": "string"
    },
    "selected": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "event",
              "state_delta",
              "source",
              "model",
              "proof",
              "assumption",
              "counterfactual",
              "obligation_flow",
              "order_constraint",
              "repair_surface",
              "unknown"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "summary"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "verdict": {
      "enum": [
        "satisfied",
        "refuted",
        "deadlock",
        "inconclusive",
        "unsupported",
        "engine_error"
      ]
    },
    "snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "snapshot",
    "intent",
    "question",
    "verdict",
    "assurance",
    "selected",
    "omissions",
    "expansions",
    "evidence",
    "semantic_epoch",
    "content_hash"
  ],
  "title": "Context Pack",
  "type": "object"
}
