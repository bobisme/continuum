{
  "$id": "https://continuum.dev/schema/repair-transaction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "gate_name": {
      "enum": [
        "base_replay",
        "patch_application",
        "intent_integrity",
        "exact_regression",
        "neighborhood",
        "property_mutation",
        "defect_mutants",
        "refinement_coverage",
        "certificate_rebuild",
        "incremental_parity",
        "code_and_security",
        "receipt_generation"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "promoted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "fail",
                      "inconclusive"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "receipt": {
            "pattern": "^receipt_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "semantic_diff": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "receipt",
          "semantic_diff"
        ]
      }
    },
    {
      "description": "Profile → permissible not_yet_enforced set: under phase-b only certificate_rebuild (gate 9) and incremental_parity (gate 10) may be not_yet_enforced.",
      "if": {
        "properties": {
          "gate_profile": {
            "const": "phase-b"
          }
        },
        "required": [
          "gate_profile"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "name": {
                    "not": {
                      "enum": [
                        "certificate_rebuild",
                        "incremental_parity"
                      ]
                    }
                  },
                  "status": {
                    "const": "not_yet_enforced"
                  }
                },
                "required": [
                  "name",
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "description": "The default profile enforces all twelve gates: no gate may be listed not_yet_enforced.",
      "if": {
        "properties": {
          "gate_profile": {
            "const": "default"
          }
        },
        "required": [
          "gate_profile"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "const": "not_yet_enforced"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "actor": {
      "type": "string"
    },
    "base_intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "base_snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "candidate_snapshot": {
      "anyOf": [
        {
          "pattern": "^ws_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "rust",
              "model",
              "proof",
              "correspondence",
              "domain",
              "intent"
            ]
          }
        },
        "required": [
          "kind",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cost_ledger": {
      "additionalProperties": false,
      "description": "Cumulative cost ledger across all versions of this transaction (plan §8.6); the promotion receipt includes it.",
      "properties": {
        "cpu_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "solver_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "wall_ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpu_ms",
        "wall_ms",
        "solver_ms",
        "memory_bytes",
        "tokens"
      ],
      "type": "object"
    },
    "evaluation_policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure": {
      "pattern": "^crash_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "gate_profile": {
      "description": "Phase-staged promotion profile (plan §21). Gates outside the profile must be listed with status not_yet_enforced, never omitted or passed.",
      "enum": [
        "phase-b",
        "phase-c",
        "phase-d",
        "default"
      ]
    },
    "gates": {
      "description": "All twelve §8.2 gates are listed at every status; gates not yet evaluated carry status pending, gates outside the phase profile carry not_yet_enforced — never omitted.",
      "minItems": 12,
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "$ref": "#/$defs/gate_name"
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "inconclusive",
              "not_applicable",
              "not_yet_enforced"
            ]
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hypothesis": {
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "pattern": "^receipt_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_id": {
      "pattern": "^rt_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_diff": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "applied",
        "evaluating",
        "ready",
        "blocked",
        "inconclusive",
        "promoted",
        "rejected",
        "superseded"
      ]
    },
    "supersedes": {
      "description": "Prior version of this transaction in its lineage (RFC 0032: every operation returns a new immutable version).",
      "pattern": "^rt_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "version": {
      "description": "Monotonic version within the transaction lineage (RFC 0032).",
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "repair_id",
    "version",
    "base_snapshot",
    "base_intent",
    "failure",
    "hypothesis",
    "candidate_snapshot",
    "status",
    "gate_profile",
    "gates",
    "cost_ledger"
  ],
  "title": "Repair Transaction",
  "type": "object"
}
