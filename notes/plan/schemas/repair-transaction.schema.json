{
  "$id": "https://continuum.dev/schema/repair-transaction.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "gate_name": {
      "enum": [
        "base_replay",
        "patch_application",
        "intent_integrity",
        "exact_regression",
        "neighborhood",
        "property_mutation",
        "defect_mutants",
        "refinement_coverage",
        "certificate_rebuild",
        "incremental_parity",
        "code_and_security",
        "receipt_generation"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "promoted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "minItems": 12,
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "fail",
                      "inconclusive"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "receipt": {
            "pattern": "^receipt_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "semantic_diff": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "receipt",
          "semantic_diff"
        ]
      }
    }
  ],
  "properties": {
    "actor": {
      "type": "string"
    },
    "base_intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "base_snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "candidate_snapshot": {
      "anyOf": [
        {
          "pattern": "^ws_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "rust",
              "model",
              "proof",
              "correspondence",
              "domain",
              "intent"
            ]
          }
        },
        "required": [
          "kind",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evaluation_policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure": {
      "pattern": "^crash_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "gate_profile": {
      "description": "Phase-staged promotion profile (plan §21). Gates outside the profile must be listed with status not_yet_enforced, never omitted or passed.",
      "enum": [
        "phase-b",
        "phase-c",
        "phase-d",
        "default"
      ]
    },
    "gates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "$ref": "#/$defs/gate_name"
          },
          "status": {
            "enum": [
              "pending",
              "pass",
              "fail",
              "inconclusive",
              "not_applicable",
              "not_yet_enforced"
            ]
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hypothesis": {
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "pattern": "^receipt_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "repair_id": {
      "pattern": "^rt_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_diff": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "applied",
        "evaluating",
        "ready",
        "blocked",
        "inconclusive",
        "promoted",
        "rejected",
        "superseded"
      ]
    }
  },
  "required": [
    "schema_version",
    "repair_id",
    "base_snapshot",
    "base_intent",
    "failure",
    "hypothesis",
    "candidate_snapshot",
    "status",
    "gate_profile",
    "gates"
  ],
  "title": "Repair Transaction",
  "type": "object"
}
