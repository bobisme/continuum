{
  "$id": "https://continuum.dev/schema/v1/repair-transaction.json",
  "schema_epoch": 1,
  "schema_kind": "artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "gate_name": {
      "enum": [
        "base_replay",
        "patch_application",
        "intent_integrity",
        "exact_regression",
        "neighborhood",
        "property_mutation",
        "defect_mutants",
        "refinement_coverage",
        "certificate_rebuild",
        "incremental_parity",
        "code_and_security",
        "receipt_generation"
      ]
    },
    "redacted": {
      "$comment": "mirrored from redacted.schema.json; identity-checked by the validator",
      "additionalProperties": false,
      "description": "Typed Redacted(reason, commitment) stub (plan §4.5). Mirrors redacted.schema.json; inlined to keep this file self-contained.",
      "properties": {
        "commitment": {
          "description": "Content commitment (hash) of the redacted original.",
          "type": "string"
        },
        "original_class": {
          "description": "Artifact class of the redacted original (plan §4.4 prefix, e.g. crash, ctx, proof).",
          "type": "string"
        },
        "reason": {
          "enum": [
            "summarized",
            "lost",
            "purged"
          ]
        },
        "redacted": {
          "const": true
        }
      },
      "required": [
        "redacted",
        "reason",
        "commitment",
        "original_class"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "A promoted transaction lists no pending/failed/inconclusive gate; not_yet_enforced beyond the active profile is forbidden by the profile conditionals below, which apply at every status including promoted (RFC 0032 gate profiles).",
      "if": {
        "properties": {
          "status": {
            "const": "promoted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "failed",
                      "inconclusive"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "receipt": {
            "pattern": "^receipt_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "semantic_diff": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "receipt",
          "semantic_diff"
        ]
      }
    },
    {
      "description": "Profile → permissible not_yet_enforced set (rfcs/0032 gate profiles): phase-b enforces gates 1–8, 11–12, so only certificate_rebuild (gate 9) and incremental_parity (gate 10) may be not_yet_enforced.",
      "if": {
        "properties": {
          "gate_profile": {
            "const": "phase-b"
          }
        },
        "required": [
          "gate_profile"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "name": {
                    "not": {
                      "enum": [
                        "certificate_rebuild",
                        "incremental_parity"
                      ]
                    }
                  },
                  "status": {
                    "const": "not_yet_enforced"
                  }
                },
                "required": [
                  "name",
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "description": "Profile → permissible not_yet_enforced set (rfcs/0032 gate profiles): phase-c adds gate 10 (incremental_parity), so only certificate_rebuild (gate 9) may be not_yet_enforced.",
      "if": {
        "properties": {
          "gate_profile": {
            "const": "phase-c"
          }
        },
        "required": [
          "gate_profile"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "name": {
                    "not": {
                      "enum": [
                        "certificate_rebuild"
                      ]
                    }
                  },
                  "status": {
                    "const": "not_yet_enforced"
                  }
                },
                "required": [
                  "name",
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "description": "phase-d enforces all twelve gates (rfcs/0032 gate profiles): no gate may be listed not_yet_enforced.",
      "if": {
        "properties": {
          "gate_profile": {
            "const": "phase-d"
          }
        },
        "required": [
          "gate_profile"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "const": "not_yet_enforced"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    },
    {
      "description": "The default profile enforces all twelve gates: no gate may be listed not_yet_enforced.",
      "if": {
        "properties": {
          "gate_profile": {
            "const": "default"
          }
        },
        "required": [
          "gate_profile"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "status": {
                    "const": "not_yet_enforced"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "actor": {
      "type": "string"
    },
    "base_intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "base_snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "candidate_snapshot": {
      "anyOf": [
        {
          "pattern": "^ws_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "rust",
              "model",
              "proof",
              "correspondence",
              "domain",
              "intent"
            ]
          }
        },
        "required": [
          "kind",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cost_ledger": {
      "additionalProperties": false,
      "description": "Cumulative cost ledger across all versions of this transaction (plan §8.6); the promotion receipt includes it. Dimension keys mirror verification-task.schema.json's budget dimensions.",
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "cpu_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "proof_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "solver_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "states": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "wall_ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cpu_ms",
        "wall_ms",
        "solver_ms",
        "memory_bytes",
        "tokens"
      ],
      "type": "object"
    },
    "evaluation_policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure": {
      "pattern": "^crash_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "gate_profile": {
      "description": "Phase-staged promotion profile (plan §21). Gates outside the profile must be listed with status not_yet_enforced, never omitted or passed.",
      "enum": [
        "phase-b",
        "phase-c",
        "phase-d",
        "default"
      ]
    },
    "gates": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "base_replay"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "patch_application"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "intent_integrity"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "exact_regression"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "neighborhood"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "property_mutation"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "defect_mutants"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "refinement_coverage"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "certificate_rebuild"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "incremental_parity"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "code_and_security"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "receipt_generation"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ],
      "description": "All twelve §8.2 gates are listed at every status; gate identity, not count, is enforced (uniqueItems, exactly twelve, one contains clause per gate). Gates not yet evaluated carry status pending, gates outside the phase profile carry not_yet_enforced — never omitted.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "$ref": "#/$defs/gate_name"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "pending",
              "inconclusive",
              "not_yet_enforced"
            ]
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array",
      "uniqueItems": true
    },
    "hypothesis": {
      "type": "string"
    },
    "performance_impact": {
      "description": "Performance impact of the change (plan §8.1 transaction contents).",
      "type": [
        "object",
        "string"
      ]
    },
    "policy_verdict": {
      "description": "Promotion policy verdict (plan §8.1); recomputed server-side at promotion time, never trusted from the client (RFC 0032).",
      "enum": [
        "allow",
        "review",
        "block"
      ]
    },
    "receipt": {
      "anyOf": [
        {
          "pattern": "^receipt_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "redacted_references": {
      "description": "Redacted values referenced by this artifact (plan §4.5, §18.4).",
      "items": {
        "$ref": "#/$defs/redacted"
      },
      "type": "array"
    },
    "repair_id": {
      "pattern": "^rt_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "schema_id": {
      "const": "https://continuum.dev/schema/repair-transaction.json",
      "description": "Artifact-class identity of the governing schema: its `$id` with the `v<schema_epoch>/` segment removed (schemas/README.md). Stable across schema epochs."
    },
    "schema_epoch": {
      "const": 1,
      "description": "Schema epoch this instance was written against (schemas/README.md). It advances only on a breaking change to this artifact class, is not one of the six independently versioned epochs (RFC 0026 `rule versioning.epoch_independence`), and pins no semantics."
    },
    "security_review": {
      "description": "Security review result for the change (plan §8.1 transaction contents).",
      "type": [
        "object",
        "string"
      ]
    },
    "semantic_diff": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "applied",
        "evaluating",
        "ready",
        "blocked",
        "inconclusive",
        "promoted",
        "rejected",
        "superseded"
      ]
    },
    "supersedes": {
      "description": "Prior version of this transaction in its lineage (RFC 0032: every operation returns a new immutable version).",
      "pattern": "^rt_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "version": {
      "description": "Monotonic version within the transaction lineage (RFC 0032).",
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_id",
    "schema_epoch",
    "repair_id",
    "version",
    "base_snapshot",
    "base_intent",
    "failure",
    "hypothesis",
    "candidate_snapshot",
    "status",
    "gate_profile",
    "gates",
    "cost_ledger"
  ],
  "title": "Repair Transaction",
  "type": "object"
}
