{
  "$id": "https://continuum.dev/schema/v1/benchmark-task.json",
  "schema_epoch": 1,
  "schema_kind": "artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "boolean"
        ]
      },
      "type": "object"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "grading": {
      "additionalProperties": false,
      "properties": {
        "hidden_variants": {
          "type": "boolean"
        },
        "intent_integrity": {
          "type": "boolean"
        },
        "minimum_assurance": {
          "type": "string"
        },
        "resource_normalized": {
          "type": "boolean"
        }
      },
      "required": [
        "intent_integrity",
        "hidden_variants",
        "resource_normalized"
      ],
      "type": "object"
    },
    "intent": {
      "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "public_description": {
      "type": "string"
    },
    "required_artifacts": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_id": {
      "const": "https://continuum.dev/schema/benchmark-task.json",
      "description": "Artifact-class identity of the governing schema: its `$id` with the `v<schema_epoch>/` segment removed (schemas/README.md). Stable across schema epochs."
    },
    "schema_epoch": {
      "const": 1,
      "description": "Schema epoch this instance was written against (schemas/README.md). It advances only on a breaking change to this artifact class, is not one of the six independently versioned epochs (RFC 0026 `rule versioning.epoch_independence`), and pins no semantics."
    },
    "task_id": {
      "type": "string"
    },
    "track": {
      "enum": [
        "model",
        "diagnose",
        "repair",
        "prove",
        "refine",
        "synthesize",
        "governance",
        "security"
      ]
    },
    "snapshot": {
      "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_epoch",
    "task_id",
    "track",
    "snapshot",
    "intent",
    "capabilities",
    "budget",
    "required_artifacts",
    "grading"
  ],
  "title": "ContinuumBench Task",
  "type": "object"
}
