{
  "$id": "https://continuum.dev/schema/workspace-snapshot.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dependencies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "epochs": {
      "additionalProperties": false,
      "properties": {
        "proof": {
          "type": "string"
        },
        "protocol": {
          "type": "string"
        },
        "semantic": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        }
      },
      "required": [
        "semantic",
        "protocol",
        "proof"
      ],
      "type": "object"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "overlay": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "intent": {
      "description": "Content identity of the governing Intent Contract. A reference only: the contract itself is stored and versioned in the intent registry, outside every writable or forkable snapshot (plan §4.2).",
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "pattern": "^ws_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "root_digest": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "root_digest",
    "files",
    "dependencies",
    "epochs",
    "intent"
  ],
  "title": "Workspace Snapshot",
  "type": "object"
}
