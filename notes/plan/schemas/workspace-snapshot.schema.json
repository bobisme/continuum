{
  "$id": "https://continuum.dev/schema/workspace-snapshot.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "named_digest_list": {
      "description": "Content identities of one snapshot component (plan §4.2); mirrors the dependencies shape.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cml_modules": {
      "$ref": "#/$defs/named_digest_list",
      "description": "Content identities of CML modules (plan §4.2)."
    },
    "configuration": {
      "$ref": "#/$defs/named_digest_list",
      "description": "Content identities of configuration (plan §4.2)."
    },
    "correspondence": {
      "$ref": "#/$defs/named_digest_list",
      "description": "Content identities of generated correspondence (plan §4.2, §16)."
    },
    "dependencies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "domain_packs": {
      "$ref": "#/$defs/named_digest_list",
      "description": "Content identities of domain-pack manifests (plan §4.2)."
    },
    "epochs": {
      "additionalProperties": false,
      "description": "Snapshot identity epochs (plan §4.2): toolchain and semantic epochs plus the proof epoch. The protocol epoch is a connection property (RFC 0026), not snapshot identity.",
      "properties": {
        "proof": {
          "type": "string"
        },
        "semantic": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        }
      },
      "required": [
        "semantic",
        "proof"
      ],
      "type": "object"
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "type": "string"
          },
          "overlay": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "intent": {
      "description": "Content identity of the governing Intent Contract. A reference only: the contract itself is stored and versioned in the intent registry, outside every writable or forkable snapshot (plan §4.2).",
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "pattern": "^ws_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "proof_environment": {
      "$ref": "#/$defs/named_digest_list",
      "description": "Content identities of the proof environment (plan §4.2)."
    },
    "root_digest": {
      "type": "string"
    },
    "rust_extraction": {
      "$ref": "#/$defs/named_digest_list",
      "description": "Content identities of the Rust semantic extraction (plan §4.2)."
    },
    "schema_version": {
      "const": "1.0"
    },
    "workspace_id": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "root_digest",
    "files",
    "dependencies",
    "epochs",
    "intent"
  ],
  "title": "Workspace Snapshot",
  "type": "object"
}
