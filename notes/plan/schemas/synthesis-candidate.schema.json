{
  "$id": "https://continuum.dev/schema/v1/synthesis-candidate.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "components": {
      "additionalProperties": false,
      "properties": {
        "abstraction": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "algorithm": {
          "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "implementation": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "invariant": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ranking": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "algorithm"
      ],
      "type": "object"
    },
    "counterexamples": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "descriptors": {
      "additionalProperties": true,
      "type": "object"
    },
    "evidence": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "forge_problem": {
      "pattern": "^forge_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "objectives": {
      "additionalProperties": {
        "type": "number"
      },
      "type": "object"
    },
    "schema_epoch": {
      "const": 1,
      "description": "Schema epoch this instance was written against (schemas/README.md). It advances only on a breaking change to this artifact class, is not one of the six independently versioned epochs (RFC 0026 `rule versioning.epoch_independence`), and pins no semantics."
    },
    "schema_id": {
      "const": "https://continuum.dev/schema/synthesis-candidate.json",
      "description": "Artifact-class identity of the governing schema: its `$id` with the `v<schema_epoch>/` segment removed (schemas/README.md). Stable across schema epochs."
    },
    "status": {
      "enum": [
        "proposed",
        "screened",
        "bounded",
        "validated",
        "proved",
        "refuted",
        "inconclusive",
        "archived"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_epoch",
    "candidate_id",
    "forge_problem",
    "components",
    "objectives",
    "descriptors",
    "status",
    "evidence"
  ],
  "schema_epoch": 1,
  "schema_kind": "artifact",
  "title": "Synthesis Candidate",
  "type": "object"
}
