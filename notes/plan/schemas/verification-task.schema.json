{
  "$id": "https://continuum.dev/schema/verification-task.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "redacted": {
      "$comment": "mirrored from redacted.schema.json; identity-checked by the validator",
      "additionalProperties": false,
      "description": "Typed Redacted(reason, commitment) stub (plan §4.5). Mirrors redacted.schema.json; inlined to keep this file self-contained.",
      "properties": {
        "commitment": {
          "description": "Content commitment (hash) of the redacted original.",
          "type": "string"
        },
        "original_class": {
          "description": "Artifact class of the redacted original (plan §4.4 prefix, e.g. crash, ctx, proof).",
          "type": "string"
        },
        "reason": {
          "enum": [
            "summarized",
            "lost",
            "purged"
          ]
        },
        "redacted": {
          "const": true
        }
      },
      "required": [
        "redacted",
        "reason",
        "commitment",
        "original_class"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "Never a silent Failed (plan §4.5): a failed task carries a typed reason.",
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failed_reason"
        ]
      }
    },
    {
      "description": "A suspended task is resumable by definition: it carries a non-null continuation (plan §11.4).",
      "if": {
        "properties": {
          "status": {
            "const": "suspended"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "continuation": {
            "pattern": "^cont_[A-Za-z0-9_-]+$",
            "type": "string"
          }
        },
        "required": [
          "continuation"
        ]
      }
    },
    {
      "description": "Budget exhaustion is never a silent dead end (plan §11.4): a BudgetExhausted failure carries a non-null continuation or a typed non_resumable_reason.",
      "if": {
        "properties": {
          "failed_reason": {
            "const": "BudgetExhausted"
          }
        },
        "required": [
          "failed_reason"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "continuation": {
                "pattern": "^cont_[A-Za-z0-9_-]+$",
                "type": "string"
              }
            },
            "required": [
              "continuation"
            ]
          },
          {
            "required": [
              "non_resumable_reason"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "budget": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "description": "Byte budget for returned context; byte budgets are the enforced context contract (RFC 0027).",
          "minimum": 0,
          "type": "integer"
        },
        "candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "cpu_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "proof_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "solver_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "states": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "wall_ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "continuation": {
      "anyOf": [
        {
          "pattern": "^cont_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "epochs": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string"
        },
        "proof": {
          "type": "string"
        },
        "semantic": {
          "type": "string"
        }
      },
      "required": [
        "semantic",
        "engine"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "pattern": "^ev_[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "failed_reason": {
      "description": "Typed failure reason drawn from the plan §10.3 error taxonomy (daemon-level codes; protocol-level codes are RFC 0026's concern). Required when status is failed.",
      "enum": [
        "StaleSnapshot",
        "UnsupportedSemanticFeature",
        "IntentMutationDenied",
        "InsufficientEvidence",
        "BudgetExhausted",
        "ContinuationEpochMismatch",
        "AmbiguousCorrespondence",
        "UntrustedDomainBoundary",
        "CertificateRejected",
        "ReplayDiverged",
        "CapabilityDenied",
        "PolicyGateFailed"
      ]
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "non_resumable_reason": {
      "description": "Typed reason a BudgetExhausted task carries no continuation (e.g. the engine cannot checkpoint this operation).",
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "pattern": "^[a-z]+\\.[a-z_]+$",
      "type": "string"
    },
    "priority_class": {
      "description": "Scheduling priority class for the task (plan §10 / RFC 0026 quotas).",
      "enum": [
        "interactive",
        "ci",
        "background"
      ]
    },
    "quota": {
      "description": "Reference to the quota this task's budget draws from (RFC 0026).",
      "type": "string"
    },
    "redacted_references": {
      "description": "Redacted values referenced by this artifact (plan §4.5, §18.4).",
      "items": {
        "$ref": "#/$defs/redacted"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0"
    },
    "snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "status": {
      "enum": [
        "created",
        "running",
        "suspended",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "task_id": {
      "pattern": "^task_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "operation",
    "snapshot",
    "intent",
    "idempotency_key",
    "status",
    "budget",
    "epochs"
  ],
  "title": "Verification Task",
  "type": "object"
}
