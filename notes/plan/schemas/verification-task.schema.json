{
  "$id": "https://continuum.dev/schema/verification-task.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "description": "Byte budget for returned context; byte budgets are the enforced context contract (RFC 0027).",
          "minimum": 0,
          "type": "integer"
        },
        "candidates": {
          "minimum": 0,
          "type": "integer"
        },
        "cpu_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "proof_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "solver_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "states": {
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "wall_ms": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "continuation": {
      "anyOf": [
        {
          "pattern": "^cont_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "epochs": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string"
        },
        "semantic": {
          "type": "string"
        }
      },
      "required": [
        "semantic",
        "engine"
      ],
      "type": "object"
    },
    "evidence": {
      "items": {
        "pattern": "^ev_[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "intent": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "operation": {
      "pattern": "^[a-z]+\\.[a-z_]+$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "snapshot": {
      "pattern": "^ws_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "status": {
      "enum": [
        "created",
        "running",
        "suspended",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "task_id": {
      "pattern": "^task_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "operation",
    "snapshot",
    "intent",
    "idempotency_key",
    "status",
    "budget",
    "epochs"
  ],
  "title": "Verification Task",
  "type": "object"
}
