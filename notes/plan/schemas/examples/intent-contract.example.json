      "site": "delivery_order"
    }
  ],
  "observers": [
    {
      "events": [
        "ReplyPublished"
      ],
      "id": "client",
      "state_projection": [
        "acknowledged"
      ]
    }
  ],
  "optimization": {
    "hard": [
      "progress"
    ],
    "non_vacuity": [
      "synced request eventually acknowledged"
    ],
    "soft": [
      "stable_writes"
    ]
  },
  "policy": {
    "assumptions": "review",
    "assurance": "no-downgrade",
    "bounds": "no-decrease",
    "completion_policy": "review",
    "fairness": "review",
    "faults": "no-removal",
    "non_vacuity": "no-removal",
    "observers": "review",
    "properties": "locked",
    "trust_boundaries": "no-expansion"
  },
  "schema_version": "1.0",
  "scope": {
    "abstraction_level": "protocol",
    "components": [
      "crate::register"
    ],
    "fragments": [
      "Finite"
    ]
  },
  "trust_boundaries": {
    "opaque": [
      "os-scheduler"
    ],
    "trusted": [
      "storage-pack:storage-posix-v1"
    ]
