// =====================================================================
// continuumd native protocol — normative interface definition
//
//   file:      schemas/continuumd-native-protocol.idl
//   owner RFC: rfcs/0026-continuumd-native-protocol.md
//   status:    normative (RFC 0026, "IDL and versioning")
//
// This file is the single machine-readable definition of the continuumd
// native protocol. Generated Rust/TypeScript clients and generated JSON
// Schema derive from it. RFC 0026's prose summarizes this file; where the
// prose and this file disagree, this file decides and the RFC is corrected
// (plan §25, "where plan prose and RFC disagree, the RFC is corrected and
// becomes normative" — the same rule applies one level down, between the
// RFC and its normative IDL).
//
// Every adapter (CLI, Cargo, LSP, DAP, MCP, SARIF, TUI, web) is a
// projection of this file and MUST NOT define semantics of its own
// (ADR-0036/0038/0042, RFC 0026 Summary).
//
// Normative language: the key words MUST, MUST NOT, REQUIRED, SHALL,
// SHALL NOT, SHOULD, SHOULD NOT, RECOMMENDED, MAY, and OPTIONAL in doc
// comments and `rule` bodies are to be interpreted as described in
// RFC 2119.
// =====================================================================


// ---------------------------------------------------------------------
// 1. Notation
//
// The IDL is a purpose-built declaration language. The technology choice
// RFC 0026 left open is decided here: a custom textual IDL rather than an
// existing schema language, because the protocol's wire-visible contracts
// -- three-valued field presence (`required` / `optional` / `nullable`),
// per-operation authority levels, task-starting and idempotency
// annotations, closed error sets per operation, and citable normative
// rules -- have no faithful encoding in JSON Schema, OpenAPI, or
// Protobuf, and an unfaithful encoding is exactly the drift this file
// exists to prevent. JSON Schema is a *generated* artifact of this file,
// not its source.
//
// Lexical rules:
//   - UTF-8, LF line endings.
//   - `//` starts a comment to end of line. `///` starts a doc comment,
//     which attaches to the next declaration, field, enum member, or
//     union variant and is part of the definition (generators emit it).
//   - Identifiers match `[A-Za-z_][A-Za-z0-9_]*`. Operation names are
//     `namespace.verb`; rule names are dotted identifiers.
//   - String literals are double-quoted; `"""` opens and closes a
//     multi-line string. Integers are decimal. Version literals are
//     strings of the form `"MAJOR.MINOR"`.
//   - Field, setting, and clause declarations end with `;`. Enum members
//     and union variants end with `,`, including the last one.
//
// Grammar (EBNF; `ident`, `string`, `integer`, `text` are lexical):
//
//   document      = { decl } ;
//   decl          = protocol | scalar | handle | alias | enum | struct
//                 | union | operation | rule ;
//   doc           = { "///" , text } ;
//   annotation    = "@" , ident , [ "(" , [ arg , { "," , arg } ] , ")" ] ;
//   arg           = string | integer | ident | ident , "=" , string ;
//   type          = ident
//                 | "list" , "<" , type , ">"
//                 | "map" , "<" , ident , "," , type , ">" ;
//   presence      = "required" | "optional" | "nullable" ;
//   field         = doc , ident , ":" , type , presence ,
//                   { annotation } , ";" ;
//   protocol      = doc , "protocol" , ident , "{" , { setting } , "}" ;
//   setting       = ident , "=" , ( string | integer
//                                 | "[" , [ literal_list ] , "]" ) , ";" ;
//   scalar        = doc , "scalar" , ident , ";" ;
//   handle        = doc , "handle" , ident , "=" , string , ";" ;
//   alias         = doc , "alias" , ident , "=" , type ,
//                   { annotation } , ";" ;
//   enum          = doc , { annotation } , "enum" , ident , "{" ,
//                   { enum_member } , "}" ;
//   enum_member   = doc , ident , [ "=" , string ] ,
//                   { annotation } , "," ;
//   struct        = doc , { annotation } , "struct" , ident , "{" ,
//                   { field } , "}" ;
//   union         = doc , { annotation } , "union" , ident , "{" ,
//                   { variant } , "}" ;
//   variant       = doc , ident , [ "(" , type , ")" ] , "," ;
//   operation     = doc , { annotation } , "operation" , op_name , "{" ,
//                   { clause } , "}" ;
//   op_name       = ident , "." , ident ;
//   clause        = "authority" , ident , ";"
//                 | "request" , body , ";"
//                 | "response" , body , ";"
//                 | "events" , body , ";"
//                 | "verdict" , ident , ";"
//                 | "errors" , "[" , [ ident , { "," , ident } ] ,
//                   "]" , ";" ;
//   body          = ident | "{" , { field } , "}" ;
//   rule          = doc , "rule" , dotted_ident , "{" , '"""' , text ,
//                   '"""' , "}" ;
//
// An anonymous `request`/`response`/`events` body is a struct whose
// generated name is the operation name in PascalCase with the suffix
// `Request`, `Response`, or `Event` (e.g. `workspace.create` request =>
// `WorkspaceCreateRequest`).
//
// Field presence is three-valued and wire-visible:
//   `required`  the field MUST be present and MUST NOT be null;
//   `nullable`  the field MUST be present and MAY be null — a named
//               absence, never an omission (plan INV-007);
//   `optional`  the field MAY be absent; absent and null are distinct
//               and MUST NOT be conflated.
//
// Annotations used in this file:
//   @readonly        performs no state change; needs no idempotency key.
//   @mutation        changes daemon state, including publishing a new
//                    immutable artifact; the request MUST carry
//                    `idempotency_key`. Orthogonal to `authority`: an
//                    operation can publish an artifact at `read`
//                    authority (e.g. `context.compile`) when the
//                    publication is the daemon's own record of a read.
//   @task_starting   MAY return `status = task_started` with a task
//                    handle instead of a completed result.
//   @privileged      privileged operation; audit-recorded (plan §18.5).
//   @audit_recorded  every call is written to the audit log.
//   @paginated       request accepts `page`, response returns
//                    `next_page_token`.
//   @streaming       long-lived; delivers `events` frames on the same
//                    connection.
//   @since("X.Y")    first protocol version defining the item. Omitted
//                    means the first minor of the current major (`3.0`),
//                    never `protocol.version`: once a minor bump is taken
//                    the two differ, and reading an unannotated item as
//                    "defined at the current minor" would silently
//                    re-date the whole 3.0 surface. Every item a later
//                    minor adds carries the annotation.
//   @deprecated("X.Y")  deprecated as of that version; still served.
//   @open            enum MAY gain members within a major version (see
//                    `rule versioning.enums`).
//   @pattern("re")   wire-format constraint on a string alias.
// ---------------------------------------------------------------------


// ---------------------------------------------------------------------
// 2. Protocol identity and versioning
// ---------------------------------------------------------------------

/// Identity and version metadata of this definition.
///
/// `version` is the wire value of the `protocol_version` envelope field
/// and the `"3.0"`-style spelling of RFC 0026: exactly one `.`, decimal
/// digits, no leading zeros, so parse and render round-trip
/// (`crates/continuum-value/src/epoch.rs`, `ProtocolEpoch`).
///
/// `majors_served` is the N and N−1 service window of RFC 0026: a daemon
/// implementing this file MUST accept connections on both majors and
/// MUST reject anything outside the window with
/// `ProtocolVersionUnsupported`.
protocol continuum.native {
  /// Version of this IDL document. Bumped on every change to the file,
  /// independently of the protocol version it defines.
  ///
  /// Revisions:
  ///   1.13 — the artifact-class spelling rule (bn-3ncfp); `version`
  ///         stays "3.6". Plan §4.4's class vocabulary travels in three
  ///         places — `Redacted.original_class`, `ArtifactRef.kind`, and
  ///         `CapabilityDescriptor.artifact_classes` — plus the keys of
  ///         `EpochAdvanceNotice`'s two maps, all as bare `String`. The
  ///         spelling was fixed only by doc comments, and they disagreed:
  ///         `ArtifactRef.kind` said "the plan §4.4 prefix without the
  ///         underscore", the other two said "prefix", and plan §4.4
  ///         writes a prefix with its `_`. The G2-02 acceptance campaign
  ///         (bn-1slz1, finding F3) showed the cost: a capability
  ///         provisioned with `ws_` was silently scoped to nothing, and
  ///         the same call under `ws` was admitted.
  ///
  ///         `rule artifact_class.spelling` now decides it. The canonical
  ///         spelling is the class **token** — the prefix without its
  ///         `_` — because that is what `ArtifactRef.kind` already
  ///         said, what `schemas/redacted.schema.json` already shows
  ///         (`crash`, `ctx`, `proof`), and what every conforming daemon
  ///         already emits. The rule lists the nineteen tokens, so the
  ///         vocabulary is declared in this file and not only in plan
  ///         prose. A prefix spelling or an unlisted token is a typed
  ///         refusal at provisioning and never an empty scope.
  ///
  ///         **Why not a closed enum.** Retyping the three fields from
  ///         `String` to an enum changes a declared field's type, which
  ///         `rule versioning.breaking_change` makes a major — the same
  ///         reason 1.11 gave for F6. The compatible form is a validated
  ///         string: the field keeps its type, and the rule fixes its
  ///         members. RFC 0026 F22 records the retype as owed at the next
  ///         major.
  ///
  ///         **Why no minor.** None of `rule
  ///         versioning.compatible_change`'s five changes occurs: no
  ///         operation, field, enum member, or error code is added, and
  ///         no server-side constraint is relaxed. No client request
  ///         carries a class — all three fields are daemon-emitted, and
  ///         capabilities are provisioned out of band (RFC 0026
  ///         "Capability administration") — so no request a client may
  ///         send is refused where it was admitted before. Every emission
  ///         site already spelled the token. One rule arrives
  ///         (`artifact_class.spelling`, 44 → 45); every count table is
  ///         unchanged.
  ///   1.12 — the `PublicationAborted` doc-comment correction
  ///         (bn-12plt), doc comments only; `version` stays "3.6".
  ///         The code's comment read "Nothing was published", which the
  ///         G1-06 acceptance campaign (bn-2vbqm) showed false at
  ///         operation grain: a composite seal that aborts at record k
  ///         answers this code while its earlier records are published
  ///         and receipted. INV-017 holds per artifact (RFC 0038), and
  ///         RFC 0026 correction 48 corrects the RFC to that contract.
  ///         No declaration moves — no field, presence marker, enum
  ///         member, annotation, rule, or error code — so no protocol
  ///         minor is taken, on the precedent of 1.10.
  ///   1.11 — the port-by-reference verb (bn-3of5h) and the single
  ///         protocol-minor bump 3.5 → 3.6 that covers it.
  ///         `workspace.create_by_reference` is the **75th** operation
  ///         and the third the registry has ever gained; it enters an
  ///         existing namespace, so the namespace count stays 19. It is
  ///         the one survivor of the DX-10 redesign pre-check
  ///         (`notes/plan/notes/DX10_BYTE_LEDGER.md` §8): of seven
  ///         candidates, six move a presence marker on a `required`
  ///         member or rewrite a rule and are none of
  ///         `rule versioning.compatible_change`'s five, and this one
  ///         moves no declaration at all.
  ///
  ///         **What it is.** `SnapshotComponents` is the largest single
  ///         argument this protocol carries — 17,208 B over the
  ///         instrument's 24 `workspace.create` calls, a mean 717 B per
  ///         request — and a local CLI never pays it, because it names a
  ///         corpus port and resolves the components from the
  ///         filesystem. The asymmetry was recorded, not assumed:
  ///         "a remote protocol client must transmit
  ///         `SnapshotComponents` in full"
  ///         (`notes/plan/notes/START_HERE_IMPLEMENTATION.md`, PR-10
  ///         IMPL-02). This verb is that sentence paid. It names the
  ///         same components by their content identity, and
  ///         `rule snapshot.by_reference` fixes what the identity is
  ///         (the canonical encoding of the value, which
  ///         `rule encoding.canonical_form` makes unique), what it
  ///         resolves to (that value, served exactly as the inline form
  ///         serves it), which two members do not come from it and why
  ///         (`intent`, because admission reads a scope claim from the
  ///         request; `epochs`, because they are the caller's
  ///         declaration and not the store's), and what an unresolvable
  ///         one is (`CapabilityDenied`, X2).
  ///
  ///         **Why a bump, and why only a minor.** The declared surface
  ///         was searched first, because serving already-declared
  ///         vocabulary is the cheaper payment and is what 1.5, 1.7,
  ///         1.8, and 1.10 each took. Nothing serves it. `workspace.fork`
  ///         names a *snapshot* and preserves its intent binding, so it
  ///         cannot open a lineage under a different contract;
  ///         `SnapshotComponents.file_components` is `optional` but the
  ///         nine component lists it sits beside are `required`, so
  ///         there is no absent form of the inline argument; and no
  ///         declared member anywhere takes a components identity. So
  ///         the honest artifact is a new operation, which is the
  ///         **first** change `rule versioning.compatible_change` names
  ///         — the `evidence.link` (3.3) and `whiteboard.compile` (3.5)
  ///         route, taken a third time. The minor is raised once, at the
  ///         end of the work, and the major window `[3, 2]` is
  ///         untouched, because a minor is not a window: a 3.0 through
  ///         3.5 client never sends this name, and an operation it never
  ///         names cannot reach it. `workspace.create` keeps all three
  ///         request members and every existing client keeps its bytes.
  ///
  ///         **Why `propose`.** RFC 0027's own row for the family: "a
  ///         `read`-only reviewer therefore reaches diffs through
  ///         `repair.review` […] and not through `workspace.diff`", and
  ///         the level the family carries is for the act — creating,
  ///         forking, and sealing publish candidate snapshots. This
  ///         operation publishes one. The tempting reading is that
  ///         naming already-held content is a *read*, which is the
  ///         argument `context` is `read` on; it does not transfer,
  ///         because what leaves this operation is a new `ws_` a caller
  ///         may then fork, seal, and verify against. A level below
  ///         `propose` would restore snapshot creation to exactly the
  ///         profile RFC 0027's Reviewer example denies it to, which is
  ///         the widening INV-015 and A7 forbid.
  ///
  ///         Counts move where an operation cannot enter without moving
  ///         them: the registry is **75** rows in **19** namespaces,
  ///         `propose` is **10**, `@mutation` is **47**, and the
  ///         `structural` verdict count is **28**. The named-struct
  ///         count stays 47 — the request and response are anonymous
  ///         bodies over `Commitment`, `SnapshotEpochs`,
  ///         `IntentHandle`, `WorkspaceHandle`, and `Diagnostic`, all
  ///         declared — `@task_starting` stays 26 and `@audit_recorded`
  ///         stays 7, both decisions and argued in RFC 0027. One rule
  ///         arrives (`snapshot.by_reference`, 43 → 44).
  ///
  ///         **Flags.** No RFC 0026 flag rides this bump and the
  ///         negative statement is owed rather than implied. F6 was
  ///         *touched and deliberately not paid* at 1.10, and it is not
  ///         payable here either: it is a `list<String>` where the
  ///         pack's vocabulary is a closed enum, and narrowing a
  ///         declared field's type is `rule versioning.breaking_change`
  ///         whatever else a minor carries — this revision adds a
  ///         declaration and narrows none. F15 sits nearest of all:
  ///         it names the same eight component lists this operation
  ///         carries by reference, and it stays raised, because a
  ///         reference to a set does not give the members of that set
  ///         the `name` beside each `digest` the schema requires — the
  ///         gap moves behind a commitment rather than closing. F1, F2,
  ///         F3, F8, F9, F10, F11, F16, F17, F18, and F21 do not ride
  ///         it either, each for the reason its own entry states, and
  ///         F17's residue is unchanged: `components` here is a
  ///         `Commitment`, the pattern-less alias the flag already
  ///         names, so this adds a fifth carrier and no new
  ///         pattern-less member.
  ///   1.10 — the context-compilation rule (bn-1y4qc), serving a verb
  ///         that has been declared since 3.0 and refused for as long
  ///         as no compiler existed. `context.compile` is not added
  ///         here; it is *answered*. RFC 0028's ten-stage pipeline
  ///         landed in `crates/continuum-context` (stages 1–8, with
  ///         stage 9 the register row's declared-disabled fallback and
  ///         stage 10 the byte packer), `continuumd`'s `context`
  ///         family runs it, and `rule errors.unsupported_surface`'s
  ///         reason for the old refusal — "an operation registered
  ///         ahead of its producing subsystem" — has expired for this
  ///         row.
  ///
  ///         The declared surface left four decisions open that no
  ///         normative wire text fixed, and `rule context.compilation`
  ///         states them: that `guarantees` is a request which never
  ///         becomes a claim and whose unknown token is
  ///         `MalformedRequest`; that `audience` selects rendering and
  ///         MUST NOT reach `context_id`; that the declared
  ///         `EvaluationVerdictValue` is the pack's own verdict and
  ///         assurance class rather than a second opinion, with the
  ///         envelope's `omissions` agreeing with the pack's manifest
  ///         record for record; and which of the operation's three
  ///         declared errors covers an absent producer
  ///         (`UnsupportedSemanticFeature`, uniform over every root so
  ///         it is not an existence oracle) against an absent input
  ///         (`InsufficientEvidence`). Each is a decision a conforming
  ///         daemon had to make and could previously have made two
  ///         ways.
  ///
  ///         **`version` stays `"3.5"`.** `rule
  ///         versioning.compatible_change` names the five changes that
  ///         raise the protocol minor — adding an operation, an
  ///         `optional` field, an `@open` enum member, an error code,
  ///         or relaxing a server-side constraint — and this revision
  ///         makes none of them. No field, member, code, struct, or
  ///         operation is added, removed, or moved: the registry is 74
  ///         rows in 19 namespaces, the named-struct count is 47,
  ///         `propose` is 9, `@mutation` is 46, `@task_starting` is
  ///         26, `@audit_recorded` is 7, and the `structural` verdict
  ///         count is 27 — every count table unchanged. One rule
  ///         arrives (`context.compilation`, 42 → 43).
  ///
  ///         The tempting fifth trigger is "relaxing a server-side
  ///         constraint", and it does not fire, for the reason 1.7
  ///         already gave and `rule errors.common` states as relaxed at
  ///         3.2: **whether a lane has shipped is a property of a
  ///         deployment, not of an operation.** A 3.0 client could
  ///         always name `context.compile`; it was always entitled to
  ///         an `ok`; what it got depended on the daemon it reached,
  ///         and it still does. A deployment with no compiler keeps
  ///         answering `UnsupportedSemanticFeature` after this revision
  ///         and conforms. Nothing a client may send changes, nothing a
  ///         conforming client could previously receive becomes
  ///         unreceivable, and no negotiated version gates any of it —
  ///         which is exactly the 1.7 and 1.8 argument, and is why
  ///         serving declared vocabulary is a revision of this file
  ///         rather than a bump of the protocol. It differs from 1.5,
  ///         which wrote down behaviour every conforming daemon already
  ///         had: here a daemon's answers do move, from a refusal to a
  ///         pack, and the four clauses above are the decisions that
  ///         move them.
  ///
  ///         No RFC 0026 flag is raised or paid. F6 (`guarantees` is
  ///         `list<String>` where the pack's is a closed enum) is
  ///         *touched* by clause 1 and deliberately not paid: paying it
  ///         changes a declared field's type, which `rule
  ///         versioning.breaking_change` makes a major, and the clause
  ///         states the reading the closed vocabulary already forces
  ///         inside the wider wire type — the correction-16 shape,
  ///         where the reading lands first and the declaration follows
  ///         a sweep that owns it. F10 (an `Opaque` pack payload naming
  ///         its `schema_id`) is unmoved and defers with the IDL's open
  ///         item 3.
  ///   1.9 — the whiteboard wire verb (bn-1as8e) and the single
  ///         protocol-minor bump 3.4 → 3.5 that covers it. This is the
  ///         second revision that moves the registry, and it moves it
  ///         for the second reason a registry may move: not a defect
  ///         paid with a verb (RFC 0027 correction 30 still forbids
  ///         that) but a subsystem the dossier already named arriving
  ///         on the wire. plan §11.5's whiteboard compiler, RFC 0038's
  ///         W1–W9, `schemas/whiteboard-note.schema.json`, and
  ///         `crates/continuum-evidence/src/whiteboard.rs` all landed
  ///         at bn-2qa0u with the wire explicitly deferred — "There is
  ///         no `whiteboard.compile` operation and no `EvidenceQuery`
  ///         field that names one" — and `whiteboard.compile` is that
  ///         paragraph paid. It is the **74th** operation and the
  ///         **19th** namespace.
  ///
  ///         The declared surface was searched before the verb was
  ///         minted, because serving already-declared vocabulary is a
  ///         revision of the 1.7/1.8 shape and needs no bump at all.
  ///         Nothing declared here serves it: no operation, no
  ///         `EvidenceQuery` member, and no struct names a note. The
  ///         two neighbours that read as candidates are neither.
  ///         `forge.create` takes a `sketch: Opaque` and is unserved,
  ///         but a sketch is RFC 0033's synthesis input — holes,
  ///         objectives, diversity descriptors, an assurance target —
  ///         and its response is a `ForgeHandle`, so serving a note
  ///         through it would be one verb doing two acts, which the
  ///         registry's "one act each" discipline forbids.
  ///         `context.compile` runs the other way, evidence root to
  ///         pack. A new operation was therefore the only honest
  ///         artifact, exactly as F14 found for `evidence.link`, and
  ///         per the F13 precedent the row arrives in plan §10.2, RFC
  ///         0027's authority table, and this file together.
  ///
  ///         Two questions RFC 0038 recorded as open are decided here
  ///         and stated as `rule whiteboard.compilation`. **Where the
  ///         compiler runs**: daemon-side, because docs/44's
  ///         "references must resolve" is a refusal only the holder of
  ///         the graph can perform, and because a client-side compiler
  ///         would put every proposal's node kind, claim identity, and
  ///         provenance actor on the wire as caller-filled fields —
  ///         which would make W2's "an author MUST NOT be able to name
  ///         the kind directly" unenforceable and the seven headings
  ///         decoration. **How the note crosses**: as an `Opaque`
  ///         governed by `whiteboard-note.schema.json`, not as a
  ///         declared struct, because INV-003 makes that schema
  ///         normative for a note's shape and a second declaration
  ///         here would be the second authority `rule
  ///         conformance.registry_agreement` exists to prevent one
  ///         namespace down. `IntentChangeSet.changes` and
  ///         `context.compile`'s `pack` are the precedent. The field
  ///         does **not** join RFC 0026 F3's four shapeless `Opaque`
  ///         members: it names a schema, so `rule envelope.no_prose`
  ///         is enforceable for it.
  ///
  ///         Counts, in the four places an operation cannot enter the
  ///         protocol without moving: the registry is **74** rows in
  ///         **19** namespaces, `propose` is **9**, `@mutation` is
  ///         **46**, the `structural` verdict count is **27**. One
  ///         struct arrives (`WhiteboardTaskProposal`, `@since("3.5")`,
  ///         46 → 47) and one rule (`whiteboard.compilation`, 41 → 42).
  ///         `@audit_recorded` stays 7 and `@task_starting` stays 26 —
  ///         both are decisions, argued in RFC 0027. F1, F2, F3, F8,
  ///         F9, F10, F11, F15, F16, F17, and F18 do **not** ride this
  ///         bump; the flags-preamble paragraph of RFC 0026 records
  ///         each reason, and F21 is raised there.
  ///   1.8 — the evidence-traversal rule (bn-35l6g), serving the last
  ///         declared-but-unserved clause of `EvidenceQuery`. `roots`
  ///         and `max_depth` have been declared since 3.0 and `roots`
  ///         has read "roots to traverse from" since 3.0, but nothing
  ///         said which way a traversal walks a *directed* edge, what
  ///         `max_depth` counts, or where an edge sits in that count —
  ///         so a daemon could serve `roots` as bare handle membership,
  ///         which is `max_depth = 0` and no traversal at all, and
  ///         silently drop the bound. Silently dropping a declared
  ///         bound is the "degrading, guessing" `rule
  ///         errors.unsupported_surface` forbids, and it was defensible
  ///         only while the graph held no edges to traverse: 3.3 added
  ///         `evidence.link`, so it holds them now and the old reason
  ///         has expired. `rule evidence.traversal` states it in six
  ///         clauses: an edge is an adjacency and is walked in either
  ///         direction, because an edge's direction is what it ASSERTS
  ///         and every `SUPPORTS`/`REFUTES`/`COUNTEREXAMPLE_TO` edge
  ///         names the claim as `to`, so a forward-only walk from a
  ///         claim would reach none of its own evidence; depth counts
  ///         edges, a root is 0, and an edge takes the GREATER of its
  ///         endpoints' depths, which is what makes an answer name no
  ///         dangling edge; absent `max_depth` is unbounded and `0` is
  ///         exactly the membership reading, so nothing a client could
  ///         previously ask becomes unaskable; the traversal walks the
  ///         whole graph and the other clauses filter what it reached,
  ///         since one clause changing another's meaning is not a
  ///         conjunction; and an absent or empty `roots` stays the
  ///         whole graph, the field's own declared sentence.
  ///         `evidence.subscribe` inherits all of it through `rule
  ///         subscription.delivery`'s "the same predicate
  ///         `evidence.query` answers with", which is why the daemon
  ///         serves one predicate and not two.
  ///         No field, member, code, struct, or operation is added,
  ///         removed, or moved: the registry is 73 rows, the
  ///         named-struct count is 46, and every count table is
  ///         unchanged. `rule versioning.compatible_change` names the
  ///         five changes that raise the protocol minor — adding an
  ///         operation, an `optional` field, an `@open` enum member, an
  ///         error code, or relaxing a server-side constraint — and
  ///         this revision makes none of them, so `version` stays
  ///         `"3.4"`. It is the 1.7 shape and its argument: what moves
  ///         is not a declaration but which of an operation's
  ///         already-declared answers a scenario lands on, the reading
  ///         1.6's F20 rider took for `verification.start` and 3.2's
  ///         item 9 took before it. It differs from 1.5, which wrote
  ///         down behavior every conforming daemon already had: here a
  ///         daemon's answers do move, from a strict subset of what
  ///         `roots` selects to what the declared word "traverse" says,
  ///         and a client that meant the subset writes `max_depth = 0`
  ///         and gets it. A client that never sends `roots` cannot
  ///         observe the revision at all.
  ///   1.7 — the subscription-delivery rule (bn-3080b), closing the
  ///         gap `evidence.subscribe` refused rather than papered
  ///         over. `@streaming` says an operation "delivers `events`
  ///         frames on the same connection" and each operation's
  ///         `events` clause says which struct they carry, but nothing
  ///         said what an event frame IS, how a client tells one from
  ///         a result, or which deltas a scope selects — so a daemon
  ///         that answered a `frontier` would have claimed a channel
  ///         no client could read, which is the empty success `rule
  ///         errors.unsupported_surface` forbids, and the daemon
  ///         refused the operation instead. `rule
  ///         subscription.delivery` states it: an event frame is the
  ///         declared event struct itself, framed and encoded like
  ///         every other frame and told apart from a `ResultEnvelope`
  ///         by its required members (the `ServerWelcome`/
  ///         `ServerReject` device); a delta selected by two
  ///         subscriptions on one connection is delivered once,
  ///         because an event names no subscription; a subscription
  ///         delivers only what was committed after it opened, since
  ///         everything earlier is the `frontier`; and a delta is in
  ///         scope exactly when the scope's `EvidenceQuery` selects
  ///         the artifact the delta's own kind names, by the predicate
  ///         `evidence.query` answers with. No field, member, code,
  ///         struct, or operation is added, removed, or moved: the
  ///         registry is 73 rows, the named-struct count is 46, and
  ///         every count table is unchanged. `rule
  ///         versioning.compatible_change` names the five changes that
  ///         raise the protocol minor and this revision makes none of
  ///         them, so `version` stays `"3.4"` — the IDL 1.5 precedent
  ///         exactly. What makes the rule statable now rather than a
  ///         flag is that whether a lane has shipped is a property of
  ///         a deployment, not of an operation (`rule errors.common`,
  ///         as relaxed at 3.2): a deployment that serves the channel
  ///         answers `ok`, one that does not keeps
  ///         `UnsupportedSemanticFeature`, and both conform.
  ///   1.6 — the fourth protocol-minor bundle, 3.3 → 3.4 (bn-3jrtz),
  ///         paying RFC 0026's F19 and F20 together under the
  ///         deferred-and-bundled discipline. F19: `Error.data` gains
  ///         its first declared shape — `CertificateRejection`
  ///         (`@since("3.4")`), the shape of `data` on a
  ///         `CertificateRejected` error — so the kernel's reason
  ///         *within* `Rejected` travels: `checker` names the trusted
  ///         checking-base crate, and `reason`/`field` are that
  ///         kernel's own stable diagnostic tokens, relayed verbatim
  ///         (the vocabulary stays the kernel's; a wire enum over it
  ///         would be the second authority bn-dtg61 declined).
  ///         `rule encoding.opaque_payloads`'s `Error.data` clause is
  ///         rewritten from "no struct or schema is declared for any
  ///         code" to the by-`code` resolution with this one shape
  ///         declared. Compatible under `rule
  ///         versioning.compatible_change`: `data` itself has been a
  ///         defined `optional` field since 3.0, and what 3.4 adds is
  ///         the declaration of its shape for one code — a new struct
  ///         declaration, which a pre-3.4 reader handles exactly as the
  ///         pre-3.4 text already obliged it to (an `Opaque` whose
  ///         shape its version does not declare, carried verbatim and
  ///         never guessed at). F20:
  ///         `verification.start` gains `task.resume`'s terminal
  ///         short-circuit — an identity resolving to a terminal,
  ///         non-`Completed` task answers `status = ok` on the
  ///         task-observing lane with `task` present and `result`
  ///         absent. No field, member, code, or operation moves with
  ///         F20; what moves is which of the operation's already-
  ///         declared answer shapes one scenario lands on, a lane
  ///         choice correction 45 types as "a fact about what the
  ///         operation did" and which a client is already required to
  ///         handle both spellings of ("a client MUST handle both
  ///         shapes") — the same nature of change as 3.2's item 9,
  ///         which made the `task_started`/`task_suspended` lanes
  ///         reachable at all. The registry is untouched: 73
  ///         operations, every count table unchanged; the named-struct
  ///         count is 46.
  ///   1.5 — the handshake bootstrap-encoding rule (bn-1h158), closing
  ///         the gap bn-1mhcr's canonical_cbor delivery found and
  ///         declined to paper over: `ClientHello` is the frame that
  ///         OFFERS the encodings, so it cannot already be spelled in
  ///         the one the offer has not yet selected, and `rule
  ///         handshake.negotiation` says which encoding is CHOSEN, not
  ///         which encoding the choosing itself is spelled in. Until
  ///         this revision that was true and unwritten — recorded only
  ///         as a comment in `crates/continuumd/src/transport/mod.rs`.
  ///         `rule handshake.bootstrap_encoding` is declared:
  ///         `ClientHello`, `ServerWelcome`, and `ServerReject` are
  ///         `canonical_json` unconditionally, independent of
  ///         `ClientHello.encodings` and of the negotiation outcome; the
  ///         negotiated encoding governs every frame from the first
  ///         `RequestEnvelope` onward. This is a doc-grade clarification
  ///         of behavior every conforming daemon already has —
  ///         `encode_hello` and `Server::open` have written
  ///         `canonical_json` unconditionally since the transport was
  ///         first built, and `Server::answer` has read and written the
  ///         negotiated encoding since bn-1mhcr — so no wire byte moves
  ///         and no field, operation, or enum member is added. `rule
  ///         versioning.compatible_change` names what raises the
  ///         protocol minor, and none of its five triggers fires here,
  ///         so `version` stays `"3.3"`: a declared rule over an
  ///         already-conforming wire is conformance, not a flag (the
  ///         bn-23j7s precedent).
  ///   1.4 — the RFC 0038 F14 disposition (bn-3sypm) and the single
  ///         protocol-minor bump 3.2 → 3.3 that covers it. This is the
  ///         first revision that moves the registry: RFC 0038 decided
  ///         which node kind a `CHECKED_BY` edge's to-handle names
  ///         (`receipt`), how an evidence identity is derived, and what
  ///         authority appends an edge, and `evidence.link` is that
  ///         decision on the wire — the **73rd** operation and the only
  ///         one that appends an evidence-graph edge, so INV-004's
  ///         "`evidence-graph-edge` requires `checker` on `CHECKED_BY`"
  ///         (plan §2 SD-11) has an artifact for the first time. Adding
  ///         an operation is the first change `rule
  ///         versioning.compatible_change` names, so the bump is a
  ///         minor and the major window is untouched; a 3.0, 3.1, or 3.2
  ///         client is served unchanged, because an operation it never
  ///         calls cannot reach it. Per the F13 precedent the row
  ///         arrives in plan §10.2, RFC 0027's authority table, and this
  ///         file together: the registry is **73** rows, `execute` is
  ///         41, `@mutation` is 45, `@audit_recorded` is 7, and the
  ///         `structural` verdict count is 26. `rule
  ///         evidence.edge_identity` is declared. F15, F16, F17, and
  ///         F18 do **not** ride this bump; each is deferred with its
  ///         reason recorded in RFC 0026.
  ///   1.3 — the bn-i4aem wire-defect reconciliation and the bn-3bhkp
  ///         codec decisions, and the single protocol-minor bump
  ///         3.1 → 3.2 that covers both. Wire changes, each compatible
  ///         under `rule versioning.compatible_change`:
  ///         `rule errors.common` gains `UnsupportedSemanticFeature`
  ///         among the always-admissible codes — a relaxed server-side
  ///         constraint — which is what resolves its contradiction with
  ///         `rule errors.unsupported_surface` for the three operations
  ///         declaring `errors []` and the twenty-two that do not
  ///         declare the code (item 1); `FileComponent` is declared and
  ///         `SnapshotComponents` gains `file_components:
  ///         list<FileComponent> optional` under `rule
  ///         snapshot.file_components`, so a snapshot's file *placement*
  ///         is on the wire instead of being recoverable only from
  ///         daemon-held state (item 2); and the three decisions a codec
  ///         needs and no normative source fixed are taken as `rule
  ///         encoding.canonical_form`, `rule encoding.union_tagging`,
  ///         and `rule encoding.opaque_payloads` (bn-3bhkp). Open item 3
  ///         is resolved for `arguments`, `payload`, and
  ///         `NextOperation.arguments`; its other two groups keep their
  ///         entries, and its misgrouping of `Error.data` is corrected.
  ///         Items 3, 4, 5, 6, 7, 8, and 11 of bn-i4aem's list are
  ///         deferred, each with its reason recorded in RFC 0026. No
  ///         operation is added, removed, or moved: the 72-row registry,
  ///         its five per-level counts, and its seven annotation counts
  ///         are unchanged.
  ///   1.2 — the RFC 0027 F1–F8 disposition (bn-3ayom), and the single
  ///         protocol-minor bump 3.0 → 3.1 that covers it together with
  ///         IDL 1.1's compatible fixes. Wire additions, each compatible
  ///         under `rule versioning.compatible_change`:
  ///         `CapabilityDescriptor` gains `profile: CapabilityProfile
  ///         optional`, and `CapabilityProfile` and `DataGrant` are
  ///         declared, giving admission test T3, docs/49's per-operation
  ///         Reviewer restriction, `observe.ingest`'s production-trace
  ///         grant, and RFC 0026's cross-principal sharing policy a wire
  ///         representation (RFC 0027 F1, F5); `ServerReject` is
  ///         declared with `rule handshake.rejection`, so a refused
  ///         connection is a typed frame rather than a transport failure
  ///         (RFC 0027 F4); `ResultEnvelope` gains `audit:
  ///         AuditCorrelationId optional` with `rule audit.correlation`,
  ///         so a caller can name the audit record its own privileged
  ///         call produced (RFC 0027 F7); `rule
  ///         conformance.adapter_mapping` is declared (RFC 0027 F6).
  ///         RFC 0027's F2, F3, and F8 are deferred with their reasons
  ///         recorded in their flag entries. No operation is added,
  ///         removed, or moved: the 72-row registry, its five per-level
  ///         counts, and its seven annotation counts are unchanged.
  ///   1.1 — the minimal additive fixes RFC 0026 flagged as F4–F7:
  ///         `StaleSnapshot` added to the `task.resume` and
  ///         `repair.resume` `errors` clauses (correction 22);
  ///         `evidence.verify` gains the `redacted` response field
  ///         (SD-09); `program.replay` gains `defect` and
  ///         `rule errors.defect_emission` is declared (plan §4.7);
  ///         open items 1 and 2 recorded as resolved by RFC 0026
  ///         "Capability administration" (corrections 20 and 21); the
  ///         `ExplanationLevel` attribution corrected to RFC 0039.
  ///         The wire additions above are compatible changes under
  ///         `rule versioning.compatible_change`, which raises the
  ///         protocol minor; `version` was left at "3.0" at 1.1 and the
  ///         bump was deferred to the sweep rather than taken silently.
  ///         It is taken once, at 1.2, and covers both revisions.
  ///   1.0 — first normative definition of protocol 3.0.
  idl_version = "1.13";
  /// The protocol version this document defines.
  ///
  /// 3.6 is the single minor bump for IDL 1.11, taken once at the end of
  /// that revision, and it is the third minor that adds an operation.
  /// `rule versioning.compatible_change` names "adding an operation"
  /// first among the five, so a registry that grows by one is still a
  /// minor: `workspace.create_by_reference` is a name a 3.0 through 3.5
  /// client never sends, and an operation it never names cannot reach
  /// it. No existing declaration moves — `workspace.create` keeps
  /// `components`, `overlay`, and `seal`; `SnapshotComponents` keeps all
  /// eleven members and their presence markers; no enum gains a member,
  /// no error code is minted, and no server-side constraint is relaxed
  /// — so the four later triggers stay unfired and the major window
  /// `[3, 2]` is untouched, because a minor is not a window.
  ///
  /// Two things about this bump were checked before it was taken. The
  /// first is that it was not avoidable: the declared surface carries no
  /// member and no operation that takes a components identity, and the
  /// two neighbours that read as candidates are neither.
  /// `workspace.fork` names a snapshot and *preserves* its intent
  /// binding, so it cannot open a lineage under a different contract —
  /// rebinding one is privileged and produces an intent diff — and
  /// `SnapshotComponents.file_components` is `optional` only beside nine
  /// `required` peers, so there is no absent form of the inline
  /// argument to serve. The second is the namespace: this is the first
  /// registry growth of the three that enters an **existing** one, and
  /// that is the argument rather than the convenience. RFC 0027's R-1
  /// says a namespace has no authority of its own and the row decides;
  /// what puts this row in `workspace` is that its act is the family's
  /// act — it publishes a candidate snapshot, which is what `create`,
  /// `fork`, and `seal` each do — and a second namespace for a second
  /// spelling of one argument would make "one act each" false in the
  /// other direction.
  ///
  /// The by-reference form is worth stating in bytes, because that is
  /// what it exists for and the number is measured rather than
  /// projected. `SnapshotComponents` is 17,208 B over the DX-10
  /// instrument's 24 `workspace.create` calls, 717 B on average; the
  /// same request by reference carries a commitment, the snapshot
  /// epochs, and the intent handle. The residue is deliberate: the
  /// intent and the epochs must travel whatever the mechanism
  /// (`rule snapshot.by_reference`), so this operation does not recover
  /// the whole line and never claimed to.
  ///
  /// 3.5 is the single minor bump for IDL 1.9, taken once at the end of
  /// that revision, and it is the second minor that adds an operation.
  /// `rule versioning.compatible_change` names "adding an operation"
  /// first among the five compatible changes, so a registry that grows
  /// by one is still a minor: `whiteboard.compile` is a name a 3.0
  /// through 3.4 client never sends, and an operation it never names
  /// cannot reach it. No existing declaration moves — no field is
  /// added to an existing struct, no enum gains a member, no error
  /// code is minted, and no server-side constraint is relaxed — so the
  /// three later triggers stay unfired and the major window `[3, 2]`
  /// is untouched, because a minor is not a window.
  ///
  /// Two things about this bump are worth naming, because both were
  /// checked before it was taken rather than after. The first is that
  /// it was not avoidable: revisions 1.5, 1.7, and 1.8 each left
  /// `version` alone by *serving already-declared vocabulary*, and the
  /// declared surface was searched for a whiteboard verb before one
  /// was minted (see the 1.9 revision note). There is none. The
  /// second is the new namespace. A nineteenth namespace holding one
  /// operation is not a novelty: `benchmark` has held exactly one row
  /// since 3.0. The alternative — folding `compile` into `evidence` —
  /// was rejected because RFC 0027's reason for that namespace's
  /// levels ("`evidence` is `read` except for `evidence.link`") is an
  /// argument about a graph's own read/verify/link surface, and it
  /// does not transfer to a note compiler whose authority is
  /// `propose`; a namespace whose rows spanned `read`, `execute`, and
  /// `propose` for three unrelated reasons would make R-1 ("a
  /// namespace has no authority of its own") true by exhaustion
  /// rather than by design.
  ///
  /// 3.4 is the single minor bump for IDL 1.6, taken once at the end of
  /// the bn-3jrtz bundle and covering both of its riders. F19 is an
  /// ordinary compatible addition: a new `@since("3.4")` struct
  /// declaring the shape of `Error.data` — a field defined since 3.0 —
  /// for one code. A pre-3.4 reader receiving it does what the pre-3.4
  /// text already obliged it to do with any `data` whose shape its
  /// version does not declare: carry the canonical value verbatim and
  /// never guess at it. F20 is the case worth naming,
  /// as the relaxation was at 3.2: it moves no declaration, but it
  /// flips which of `verification.start`'s two declared answer shapes
  /// an already-reachable scenario lands on (terminal non-`Completed`
  /// identity: `task_started` → `ok` on the observing lane). That is a
  /// wire-visible behavior change and is why F20 waited for a bump
  /// rather than landing silently (bn-y9f7i); it is admissible at a
  /// *minor* because both shapes were declared all along, "a client
  /// MUST handle both shapes" has been normative since 3.0, and the
  /// status lane is a statement about what the operation did, not a
  /// field a version defines (correction 45). The 3.2 precedent is
  /// exact: bn-i4aem's item 9 flipped a parked campaign's answer from
  /// `ok` to `task_suspended` at a minor for the same reason.
  ///
  /// IDL 1.5 (`rule handshake.bootstrap_encoding`, bn-1h158) does not
  /// move this value. It states a rule about which encoding a frame
  /// already sent in `canonical_json` is spelled in, not a wire shape a
  /// version negotiates — `rule versioning.compatible_change` lists
  /// what raises the minor and this revision does none of it, so a 3.3
  /// client and daemon are unaffected by the revision that documents
  /// what they already do.
  ///
  /// IDL 1.7 (`rule subscription.delivery`, bn-3080b) does not move it
  /// either, on the same reading and with one difference worth
  /// naming. The rule states how a frame the `@streaming` annotation
  /// has declared since 3.0 is spelled, and it declares no field,
  /// member, struct, or operation, so none of the five triggers fires.
  /// The difference from 1.5 is that 1.5 wrote down what every
  /// conforming daemon already did, whereas nothing had delivered an
  /// `events` frame at all — which is why the rule takes the three
  /// open decisions explicitly rather than reporting them. A 3.4
  /// client that never subscribes is unaffected, and one that does was
  /// already required by `@streaming` to expect frames it did not
  /// request.
  ///
  /// 3.1 was the single minor bump for IDL 1.1's compatible fixes and
  /// IDL 1.2's F1–F8 sweep together, ratified by the user on
  /// 2026-07-31 and taken by bn-3ayom on 2026-08-01.
  ///
  /// 3.2 is the single minor bump for IDL 1.3, taken once at the end of
  /// that revision and covering all of it: the defect reconciliation,
  /// the `file_components` addition, and the three encoding rules. It
  /// follows the 3.1 precedent exactly — one uninterrupted stretch of
  /// compatible work raises the minor once, rather than once per edit.
  /// A 3.0 or 3.1 client is served unchanged: every 1.3 change is an
  /// `optional` field, a new declaration, a new `rule`, or a relaxed
  /// server-side constraint, and `rule versioning.compatible_change`
  /// forbids a daemon from emitting a field the negotiated version does
  /// not define. The relaxation is the one case worth naming: a 3.1
  /// client can already receive `UnsupportedSemanticFeature` from any
  /// operation, because `ErrorCode` is `@open` and a client is required
  /// to treat any code it does not expect as a non-retryable typed
  /// failure (`rule versioning.error_codes`).
  ///
  /// 3.3 is the single minor bump for IDL 1.4, and it is the first one
  /// that adds an operation. `rule versioning.compatible_change` names
  /// "adding an operation" first among the compatible changes, so a
  /// registry that grows by one is still a minor: an operation a 3.0,
  /// 3.1, or 3.2 client never names cannot reach that client, and no
  /// existing declaration moved. What makes the growth safe to state
  /// rather than to assume is the F13 discipline — the row exists in
  /// plan §10.2, in RFC 0027's authority table, and here, or it exists
  /// nowhere (`rule conformance.registry_agreement`). 3.5 is the second,
  /// and the F13 discipline is now mechanically enforced rather than
  /// remembered: the dossier validator parses all three sources and
  /// fails closed on any disagreement, preferring none.
  version = "3.6";
  /// Protocol majors a conforming daemon serves concurrently: N, N−1.
  majors_served = [3, 2];
  /// Wire encodings; exactly one is negotiated per connection.
  encodings = ["canonical_json", "canonical_cbor"];
  /// The owning specification.
  rfc = "rfcs/0026-continuumd-native-protocol.md";
  /// The operation registry this document implements in full.
  operation_registry = "plan.md §10.2";
  /// The authority table each operation's `authority` clause mirrors.
  authority_registry = "rfcs/0027-agent-tool-protocol.md";
}

rule versioning.compatible_change {
  """
  Within a protocol major, only compatible changes are permitted, and
  each MUST raise the minor version: adding an operation; adding an
  `optional` field; adding an enum member to an `@open` enum; relaxing a
  server-side constraint; adding an error code (see
  `rule versioning.error_codes`). Servers MUST ignore unknown optional
  request fields and MUST NOT emit fields the negotiated version does not
  define.
  """
}

rule versioning.breaking_change {
  """
  Removing or renaming any declaration or field; changing a field's type
  or presence marker; adding a `required` or `nullable` field; adding or
  removing a member of a closed enum; changing an operation's authority
  level, verdict type, or the meaning of an existing error code — each is
  a breaking change and MUST advance the protocol major. A breaking
  change MUST publish the typed per-artifact-class compatibility
  statement `Preserved | Revalidate | Incompatible` required by plan
  §4.6 before it is applied.
  """
}

rule versioning.enums {
  """
  Enums are closed unless annotated `@open`. A daemon MUST NOT emit a
  member the negotiated version does not define. A client receiving an
  unknown member of a closed enum MUST treat the message as malformed. A
  client receiving an unknown member of an `@open` enum MUST NOT infer
  semantics from it, MUST NOT crash, and MUST surface it verbatim to its
  caller as unknown.
  """
}

rule versioning.error_codes {
  """
  `ErrorCode` is `@open`: adding a code is a minor change, because
  clients are required to treat an unrecognized code as a non-retryable
  typed failure and MUST NOT infer semantics from it. Removing a code or
  changing what an existing code means is a breaking change.
  """
}

rule versioning.epoch_independence {
  """
  Protocol, semantic, intent, evidence, proof, and corpus epochs are
  versioned independently (docs/12 §7) and MUST NOT be conflated. A
  protocol-major bump does not, by itself, invalidate, reinterpret, or
  orphan any published artifact: evidence and receipt schemas MUST remain
  readable by every future verifier for their declared evidence epoch,
  regardless of which protocol majors the daemon still serves (plan §4.3,
  schemas/README.md). Retiring a protocol major never orphans an
  artifact.
  """
}

rule versioning.handle_stability {
  """
  Handles remain valid across daemon upgrades within a protocol major.
  Continuations additionally pin engine and semantic epochs and MUST be
  rejected with `ContinuationEpochMismatch` on mismatch — never silently
  re-run (RFC 0026, plan §9.6).
  """
}


// --- the canonical form of both encodings (@since 3.2) ---------------
//
// `encodings` above names two encodings and RFC 0026 requires them to
// carry "identical canonical field order", without ever saying what that
// order is. The three rules below say it. Each is a decision this file
// takes because no other normative source took it, and each cites the
// discipline it follows rather than a preference.

rule encoding.canonical_form {
  """
  Both encodings are canonical: one message has exactly one byte
  spelling under the negotiated encoding, and re-encoding a decoded
  message MUST reproduce it byte for byte (`rule
  conformance.golden_traces`, "a golden vector is a byte sequence, not a
  shape").

  **Field order is ascending Unicode code-point order of the field
  name**, in both encodings and at every nesting depth. This is RFC
  0037's ID5 rule — "object keys sorted ascending by Unicode code point"
  — applied to the wire rather than restated for it, and it is the order
  `crates/continuum-intent/src/canonical_json.rs` already implements for
  Intent Contract documents. Declaration order is NOT the canonical
  order: an `optional` field a message omits has no declaration position
  to occupy, a `map<String, T>` has no declaration order at all, and a
  reader would have to hold this file to know the order of a document it
  can otherwise read. Code-point order is a property of the message.
  A canonical-CBOR encoder therefore orders map keys by field name in
  code-point order and MUST NOT use the length-first map ordering the
  CBOR specification's own deterministic-encoding section fixes: this
  protocol fixes one order for both encodings, and the IDL is the source
  of it.

  The order binds the *reader* as well as the writer: a reader MUST
  reject a message whose keys are not in that order rather than
  re-ordering them, with `MalformedRequest`. A reader that silently
  re-sorted would accept a second byte spelling of a message that
  already has one, which is the property this rule exists to establish
  and the one `rule ordering.deterministic` is stated against.

  The remaining spellings, each fixed once:
    - no insignificant whitespace in `canonical_json`;
    - integers in shortest decimal form, no sign, no leading zeros; no
      floating-point value appears anywhere in this protocol;
    - `U64` is a JSON number when it is exactly representable and a
      decimal string otherwise (IDL §3), and a `U64` outside exact
      representation encoded as a number is `MalformedRequest`;
    - `Bytes` is base64url without padding in JSON, a byte string in
      CBOR;
    - identity-bearing strings are NFC, and a non-canonical spelling is
      rejected rather than normalized (ADR-0013);
    - `required` fields are present and non-null; a `nullable` field is
      present and MAY be null; an `optional` field is absent or present
      and non-null. Emitting `null` for an `optional` field, or omitting
      a `nullable` one, is `MalformedRequest` — absent and null are
      distinct in both directions.
  """
}

rule encoding.union_tagging {
  """
  A `union` is encoded **externally tagged**: a one-member object whose
  single key is the variant identifier this file declares and whose
  value is the variant's payload — `{"semantic": {…}}`, `{"produced":
  {…}}`. A message carrying no key, more than one key, or a key that is
  not a declared variant of that union is `MalformedRequest`.

  This is the shape the `variant` production already has (`ident`, then
  its payload type), so the encoding names the variant with the
  identifier the declaration gives it and adds nothing. Internal tagging
  — a tag field inside the payload object — is rejected: the tag is not
  a declared field of the payload struct, and `rule
  envelope.unknown_fields` forbids a daemon from emitting a field the
  negotiated version does not define, so an internally tagged union
  would be non-conforming against this file by construction. It is also
  what makes the union tag load-bearing where RFC 0026 requires it: the
  same token `refuted` is a member of `SemanticVerdict` and of
  `EvaluationVerdict`, and the tag is what disambiguates them.

  A union is closed: adding or removing a variant changes the
  declaration and is a breaking change under `rule
  versioning.breaking_change`. A reader MUST fail closed on an
  unrecognized variant key rather than surfacing it, which is the
  closed-enum treatment of `rule versioning.enums` — an `@open` union
  does not exist in this file.
  """
}

rule encoding.opaque_payloads {
  """
  An `Opaque` field carries a structured value, never free-form bytes,
  and what governs it is decided by the *carrying field*, not by the
  codec:

    - `RequestEnvelope.arguments` is the request struct of the operation
      the same envelope's `operation` field names, and
      `ResultEnvelope.payload` is that operation's response struct.
      `NextOperation.arguments` is the request struct of the operation
      that struct's own `operation` field names. Each resolution is a
      function of the message alone — the naming field is `required` in
      the same object — so a reader needs no connection state, no
      registry lookup beyond this file, and no prose to decode them.
      A payload that does not validate against the named struct is
      `MalformedRequest`;
    - every other `Opaque` names a schema in `schemas/` in its doc
      comment and is carried verbatim as a canonical value of the
      negotiated encoding. The codec does not interpret it and MUST NOT
      re-order, re-spell, or re-encode it into a different shape; the
      canonical form of the enclosing message applies to it because it
      is itself canonical.

  `Error.data` is neither of the two resolutions above; its shape is
  "determined by `code`", and the carrying object's own required `code`
  field is what resolves it — the same function-of-the-message-alone
  property the envelope payloads have. As of 3.4 exactly one code
  declares a shape: `data` on a `CertificateRejected` error is the
  `CertificateRejection` struct, encoded as a canonical value of the
  negotiated encoding like any other declared struct (F19). For every
  code that declares no shape a daemon MUST leave `data` absent rather
  than inventing one. See open item 3.
  """
}


// ---------------------------------------------------------------------
// 3. Primitive types
// ---------------------------------------------------------------------

/// Boolean. JSON `true`/`false`; CBOR major type 7 simple values 20/21.
scalar Bool;

/// Unsigned 32-bit integer.
scalar U32;

/// Unsigned 64-bit integer. JSON encodes it as a number only when it is
/// exactly representable; otherwise as a decimal string. CBOR uses an
/// unsigned integer.
scalar U64;

/// UTF-8 string. Canonical form is NFC; a daemon MUST reject
/// non-canonical spellings of identity-bearing strings (ADR-0013).
scalar String;

/// Opaque byte string. JSON encodes it base64url without padding; CBOR
/// uses a byte string.
scalar Bytes;

/// RFC 3339 timestamp in UTC with millisecond precision.
scalar Timestamp;

/// Non-negative duration in milliseconds.
scalar DurationMs;

/// Non-negative byte count.
scalar ByteCount;

/// A structured value whose shape is defined by a named schema in
/// `schemas/` or by a struct declared in this file, carried inline. The
/// carrying field's doc comment names it; the value MUST validate against
/// it. `Opaque` never means "free-form": there is no untyped payload
/// anywhere in this protocol.
///
/// An `Opaque` value governed by a schema in `schemas/` carries its own
/// identity: since SD-08 every artifact instance declares the class
/// identity `https://continuum.dev/schema/<name>.json` in `schema_id` and
/// the epoch of the document it was written against in `schema_epoch`
/// (`schemas/README.md`). A receiver resolves the governing document —
/// `https://continuum.dev/schema/v<schema_epoch>/<name>.json` — from the
/// payload alone, and MUST reject a payload whose `schema_epoch` it does
/// not implement rather than best-effort decoding it (plan §4.6, docs/09
/// T13). Declaring those identities in the IDL instead of in prose is
/// open item 3.
///
/// How an `Opaque` is encoded is `rule encoding.opaque_payloads`: the
/// envelope's `arguments` and `payload` resolve to the request and
/// response structs of the operation the same envelope names, and every
/// other `Opaque` is carried verbatim as a canonical value.
scalar Opaque;


// ---------------------------------------------------------------------
// 4. Handles (plan §4.4 artifact-class registry)
//
// A handle is `<prefix><opaque>` where the opaque part matches
// `[A-Za-z0-9_-]+`. Handles carry a kind prefix and are otherwise
// structureless. Content-addressed identities are derivable by anyone
// holding the content, so handles are identifiers, not secrets, and
// confer no authority; authorization is always checked independently of
// handle possession (plan §4.4, ADR-0037). Capability tokens (`cap_*`)
// are the sole exception: they are minted randomly and DO confer
// authority.
// ---------------------------------------------------------------------

/// Workspace snapshot (`schemas/workspace-snapshot.schema.json`).
handle WorkspaceHandle = "ws_";
/// Intent Contract (`schemas/intent-contract.schema.json`).
handle IntentHandle = "in_";
/// Signed, content-addressed intent bundle (plan §4.2.1).
handle IntentBundleHandle = "inb_";
/// Elaborated model.
handle ModelHandle = "model_";
/// Causal execution graph (`schemas/cir.schema.json`).
handle CausalGraphHandle = "cir_";
/// Crashpack (`schemas/crashpack.schema.json`).
handle CrashpackHandle = "crash_";
/// Context Pack (`schemas/context-pack.schema.json`).
handle ContextHandle = "ctx_";
/// Proof artifact.
handle ProofArtifactHandle = "proof_";
/// Proof state.
handle ProofStateHandle = "ps_";
/// Task.
handle TaskHandle = "task_";
/// Evidence-graph node or edge.
handle EvidenceHandle = "ev_";
/// Debugger branch.
handle DebugHandle = "dbg_";
/// Signed or checked receipt.
handle ReceiptHandle = "receipt_";
/// Repair transaction (`schemas/repair-transaction.schema.json`).
handle RepairHandle = "rt_";
/// Forge synthesis archive.
handle ForgeHandle = "forge_";
/// Resumable task continuation.
handle ContinuationHandle = "cont_";
/// Capability token. Minted randomly; confers authority.
handle CapabilityHandle = "cap_";
/// Semantic or intent diff (`schemas/semantic-diff.schema.json`).
handle DiffHandle = "diff_";
/// Engine-defect report (plan §4.7).
handle DefectHandle = "defect_";

/// Any handle of any registered artifact class. Used where an operation
/// accepts or returns artifacts of several classes; the prefix names the
/// class.
alias ArtifactHandle = String @pattern("^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$");

/// Client-unique request identifier, echoed in the result.
alias RequestId = String @pattern("^req_[A-Za-z0-9_-]+$");

/// Actor identity, e.g. `agent:repairer-1`, `human:bob`, `service:tlc`.
alias ActorId = String @pattern("^(agent|human|service|ci):[A-Za-z0-9._:-]+$");

/// Protocol version, `MAJOR.MINOR`, no leading zeros.
alias ProtocolVersion = String @pattern("^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$");

/// The content identity of one epoch (plan §4.6). Printable ASCII with
/// no spaces, e.g. `cml/0.2`, `leanprover/lean4:v4.32.1`,
/// `tla-examples@91c22ea`. Compared exactly; never ordered.
alias EpochIdentity = String @pattern("^[!-~]+$");

/// Content commitment (hash) in the dossier's canonical digest form.
alias Commitment = String;

/// Opaque, deterministic pagination cursor.
alias PageToken = String;

/// Stable identifier of an operation in the plan §10.2 registry.
alias OperationName = String @pattern("^[a-z]+\\.[a-z_]+$");

/// Correlation identity of an audit-log record (plan §18.5).
///
/// Deliberately not a handle and not a plan §4.4 artifact class: the
/// audit log is not the content-addressed store, this identity is not
/// dereferenceable through any operation in this file, and it carries no
/// class prefix that would suggest otherwise. It names a record so a
/// caller can cite the one its own call produced; what it names is read
/// through the audit surface, not through the protocol.
/// `rule audit.correlation` fixes how it is derived.
alias AuditCorrelationId = String @pattern("^[A-Za-z0-9_-]+$") @since("3.1");


// ---------------------------------------------------------------------
// 5. Common vocabularies
//
// Most enums below are the wire form of a vocabulary already fixed by the
// dossier; the citation in each doc comment is the source of truth for
// its members. A generator MUST NOT invent members, and a schema
// generated from this file MUST agree member-for-member with the cited
// JSON Schema. Where a doc comment carries no citation, the dossier had
// no vocabulary and this file is the first normative definition:
// `Encoding`, `Audience`, `DiffLayer`, `TargetKind`,
// `ExplorationStrategy`, `StructuralOutcome`, `DiagnosticSeverity`,
// `TaskEventKind`, and `EvidenceEventKind` are registered here.
// `Portfolio` is promoted here from the non-normative sketch that named
// it (docs/55); `ExplanationLevel` is promoted from RFC 0039, its sole
// source — docs/55 names neither that enum, the `level` argument, nor
// any of its members — as the `ExplanationLevel` declaration records.
// ---------------------------------------------------------------------

/// The five authority levels, ordered `read < propose < execute <
/// revise-intent < promote` (RFC 0027). Agent-facing installations MUST
/// omit `promote` and `revise_intent` by default.
enum AuthorityLevel {
  read,
  propose,
  execute,
  revise_intent = "revise-intent",
  promote,
}

/// Wire encoding of a connection. One encoding per connection,
/// negotiated at open; canonical field order is identical in both, and
/// what that order is is fixed by `rule encoding.canonical_form`.
enum Encoding {
  /// Canonical JSON (ADR-0013 canonical form), for debugging.
  canonical_json,
  /// CBOR with the same canonical field order, for performance.
  canonical_cbor,
}

/// Result-envelope status (RFC 0026, "Result envelope").
enum ResultStatus {
  /// The operation completed; `verdict` carries its typed outcome.
  ok,
  /// The operation failed; `error` is present and `verdict` is null.
  error,
  /// A long operation was started; `task` is present.
  task_started,
  /// A long operation suspended; `task` and `continuation` are present.
  task_suspended,
}

/// Task lifecycle states (plan §4.1;
/// `schemas/verification-task.schema.json`).
enum TaskStatus {
  created,
  running,
  suspended,
  completed,
  failed,
  cancelled,
}

/// Claim-level verdict vocabulary
/// (`schemas/assurance-result.schema.json`). Budget exhaustion is never
/// a verdict; `Unsupported` and engine errors are not verdicts either —
/// they are `inconclusive` with a typed reason (INV-008).
enum SemanticVerdict {
  established,
  refuted,
  inconclusive,
}

/// Evaluation-outcome vocabulary of a Context Pack
/// (`schemas/context-pack.schema.json`).
enum EvaluationVerdict {
  satisfied,
  refuted,
  deadlock,
  inconclusive,
}

/// Typed `Inconclusive` reason required by INV-008 wherever a verdict is
/// `inconclusive` (`schemas/assurance-result.schema.json`).
enum InconclusiveReason {
  Unsupported,
  ResourceExhausted,
  EngineError,
  InsufficientTelemetry,
  AbstractionAmbiguity,
  IncompleteProofSearch,
}

/// Evidence-graph status lattice (plan §11.4, RFC 0038). There is no
/// `draft` status. Promotion into `validated` or `proved` is
/// service-restricted; agent votes and confidence never change status.
enum EvidenceStatus {
  proposed,
  observed,
  sampled,
  bounded,
  validated,
  proved,
  refuted,
  inconclusive,
  superseded,
}

/// Assurance class of a result (`schemas/context-pack.schema.json`).
enum AssuranceClass {
  observed,
  sampled,
  bounded,
  validated,
  proved,
}

/// Evidence kinds (`schemas/assurance-result.schema.json`).
enum EvidenceKind {
  example,
  sampled,
  bounded_schedules = "bounded-schedules",
  dpor_complete = "dpor-complete",
  finite_exact = "finite-exact",
  symbolic_bounded = "symbolic-bounded",
  inductive,
  parameterized,
  liveness_proof = "liveness-proof",
  refinement_proof = "refinement-proof",
  production_observation = "production-observation",
  differential,
  certificate,
}

/// Evidence-graph node kinds (`schemas/evidence-graph-node.schema.json`).
enum EvidenceNodeKind {
  intent_claim,
  assumption,
  property,
  model,
  program,
  proof_goal,
  candidate,
  invariant_candidate,
  ranking_candidate,
  abstraction_map,
  counterexample,
  explanation,
  repair_hypothesis,
  patch,
  run,
  certificate,
  receipt,
  benchmark_result,
  conflict,
  decision,
}

/// The 13 evidence-graph edge types (plan §11.3,
/// `schemas/evidence-graph-edge.schema.json`).
enum EvidenceEdgeKind {
  SUPPORTS,
  REFUTES,
  DEPENDS_ON,
  REFINES,
  EXPLAINS,
  REPAIRS,
  INVALIDATES,
  GENERALIZES,
  COUNTEREXAMPLE_TO,
  CHECKED_BY,
  DERIVED_FROM,
  CONFLICTS_WITH,
  SUPERSEDES,
}

/// Semantic fragment (`schemas/intent-contract.schema.json`).
enum Fragment {
  Finite,
  Symbolic,
  Temporal,
  Probabilistic,
  Theorem,
  Runtime,
}

/// Policy decision of a diff or gate evaluation
/// (`schemas/semantic-diff.schema.json`).
enum PolicyDecision {
  allow,
  review,
  block,
}

/// Omission reason (INV-007; `schemas/context-pack.schema.json`).
enum OmissionReason {
  budget,
  redaction,
  unsupported,
  heuristic_cutoff = "heuristic-cutoff",
  slice_irrelevant = "slice-irrelevant",
}

/// Reason a value was redacted (plan §4.5;
/// `schemas/redacted.schema.json`).
enum RedactionReason {
  summarized,
  lost,
  purged,
}

/// Typed per-artifact-class compatibility statement published by every
/// epoch advance (plan §4.6).
enum Compatibility {
  Preserved,
  Revalidate,
  Incompatible,
}

/// Scheduling priority class of a task
/// (`schemas/verification-task.schema.json`).
enum PriorityClass {
  interactive,
  ci,
  background,
}

/// Intended reader of a result's context payload. Advisory for
/// selection and rendering; it never changes a verdict, never widens
/// authority, and never suppresses an omission or an uncertainty
/// (RFC 0027 Safety).
enum Audience {
  agent,
  human,
  ci,
}

/// Verification portfolio profile (docs/55 sketch, normative here).
enum Portfolio {
  interactive,
  promotion,
  custom,
}

/// The 12 repair gates, in order
/// (`schemas/repair-transaction.schema.json`, plan §8.2).
enum GateName {
  base_replay,
  patch_application,
  intent_integrity,
  exact_regression,
  neighborhood,
  property_mutation,
  defect_mutants,
  refinement_coverage,
  certificate_rebuild,
  incremental_parity,
  code_and_security,
  receipt_generation,
}

/// Gate outcome (`schemas/repair-transaction.schema.json`).
enum GateStatus {
  passed,
  failed,
  pending,
  inconclusive,
  not_yet_enforced,
}

/// Expansion relation vocabulary (RFC 0027 "Context policy").
enum ExpansionRelation {
  causal_predecessors,
  causal_successors,
  conflicts_with,
  same_owner,
  property_automaton_step,
  proof_dependency,
  source_span,
  assumption_uses,
  abstraction_of,
  refinement_of,
  alternate_branch,
}

/// What an operation is aimed at.
@open
enum TargetKind {
  property,
  claim,
  obligation,
  refinement,
  module,
  program,
  benchmark_task,
  all_claims,
}


// ---------------------------------------------------------------------
// 6. Envelopes
// ---------------------------------------------------------------------

/// The budget dimensions of `schemas/verification-task.schema.json`.
/// The same nine dimensions are used for requested budget, reported
/// cost, and quota accounting; no other dimension exists (plan §8.6,
/// SD-12 "one budget/cost dimension list").
struct Budget {
  wall_ms: DurationMs optional;
  cpu_ms: DurationMs optional;
  memory_bytes: ByteCount optional;
  states: U64 optional;
  solver_ms: DurationMs optional;
  proof_ms: DurationMs optional;
  /// Advisory and tokenizer-relative; never the enforced contract.
  tokens: U64 optional;
  candidates: U64 optional;
  /// The enforced context contract (RFC 0027).
  bytes: ByteCount optional;
}

/// Actual spend, reported in the same nine dimensions as `Budget`.
/// A dimension the engine does not measure is absent, never zero.
struct Cost {
  wall_ms: DurationMs optional;
  cpu_ms: DurationMs optional;
  memory_bytes: ByteCount optional;
  states: U64 optional;
  solver_ms: DurationMs optional;
  proof_ms: DurationMs optional;
  tokens: U64 optional;
  candidates: U64 optional;
  bytes: ByteCount optional;
  /// Tokenizer identity, REQUIRED whenever `tokens` is reported.
  tokenizer_id: String optional;
}

/// Bounds on what the daemon returns (RFC 0026 request envelope,
/// RFC 0027 "Context policy").
struct OutputPolicy {
  /// Enforced byte ceiling on the result payload.
  max_bytes: ByteCount optional;
  /// Advisory token ceiling; bytes remain the enforced contract.
  max_tokens: U64 optional;
  /// Ceiling on returned graph nodes.
  max_nodes: U64 optional;
  audience: Audience optional;
}

/// W3C Trace Context / OpenTelemetry propagation.
struct TraceContext {
  traceparent: String required;
  tracestate: String optional;
}

/// Page request for a list-returning operation.
struct Page {
  page_size: U32 optional;
  page_token: PageToken optional;
}

/// The epochs a result, artifact, or continuation is pinned to.
///
/// All six independently versioned epochs (docs/12 §7,
/// `crates/continuum-value/src/epoch.rs`) MUST be named in every result:
/// an epoch the daemon cannot pin reads `null` — a named absence, never
/// an omitted field. `engine` is engine identity (plan §4.7
/// "Engine-defect lifecycle"), not one of the six; it is carried here
/// because continuations pin it.
struct EpochSet {
  /// The negotiated protocol version; never null on a served
  /// connection.
  protocol: ProtocolVersion required;
  semantic: EpochIdentity nullable;
  intent: EpochIdentity nullable;
  evidence: EpochIdentity nullable;
  proof: EpochIdentity nullable;
  corpus: EpochIdentity nullable;
  /// Engine identity (plan §4.7), pinned by continuations.
  engine: EpochIdentity nullable;
}

/// A typed `Redacted(reason, commitment)` stub (plan §4.5;
/// `schemas/redacted.schema.json`). A redacted value is reported, never
/// silently dropped; claims requiring the hidden data downgrade per plan
/// §18.4.
struct Redacted {
  redacted: Bool required;
  reason: RedactionReason required;
  commitment: Commitment required;
  /// Artifact class of the redacted original: a plan §4.4 class token,
  /// per `rule artifact_class.spelling`.
  original_class: String required;
}

/// One dimension of the nine-dimension assurance envelope (plan B11;
/// `schemas/assurance-result.schema.json`): it names its producing
/// engine or carries a typed `Unsupported(reason)`. A dimension is never
/// silently omitted.
union EnvelopeDimension {
  produced(ProducedDimension),
  unsupported(UnsupportedDimension),
}

struct ProducedDimension {
  engine: String required;
  summary: String required;
}

struct UnsupportedDimension {
  /// Typed reason, e.g. `sequential-consistency-only`.
  reason: String required;
}

/// The nine-dimension assurance envelope. All nine dimensions are
/// REQUIRED on every semantic verdict (plan B11); the member list is
/// identical to `schemas/assurance-result.schema.json` and
/// `schemas/context-pack.schema.json`, which the validator holds
/// identical to each other (SD-12).
struct AssuranceEnvelope {
  bounds: EnvelopeDimension required;
  faults: EnvelopeDimension required;
  fairness: EnvelopeDimension required;
  values: EnvelopeDimension required;
  schedules: EnvelopeDimension required;
  memory_model: EnvelopeDimension required;
  observer: EnvelopeDimension required;
  proof_status: EnvelopeDimension required;
  unknowns: EnvelopeDimension required;
}

/// A typed artifact reference in a result.
struct ArtifactRef {
  /// Artifact class: a plan §4.4 class token, per
  /// `rule artifact_class.spelling`.
  kind: String required;
  handle: ArtifactHandle required;
  /// Content commitment, when the artifact is content-addressed.
  commitment: Commitment optional;
  /// Present when the referenced content is redacted (plan §4.5).
  redacted: Redacted optional;
}

/// Something the result deliberately left out (INV-007).
struct Omission {
  reason: OmissionReason required;
  /// What was omitted, in typed terms — never free-form prose about the
  /// user's source.
  subject: String required;
  /// Handle whose expansion would recover it, when one exists.
  recoverable_by: ArtifactHandle optional;
}

/// A typed warning. Warnings never carry interpolated source text
/// (INV-016).
struct Warning {
  code: String required;
  detail: String required;
}

/// A typed diagnostic attached to a structural operation.
struct Diagnostic {
  severity: DiagnosticSeverity required;
  code: String required;
  detail: String required;
  /// Source correspondence, when the diagnostic has one.
  span: SourceSpan optional;
}

enum DiagnosticSeverity {
  error,
  warning,
  note,
}

struct SourceSpan {
  file: String required;
  start_line: U32 required;
  start_column: U32 required;
  end_line: U32 required;
  end_column: U32 required;
}

/// An allowed next operation with pre-filled arguments. This is the safe
/// recovery and discovery surface (plan §0.2): a client MAY execute it
/// as given. It is never a command string, never shell, and never
/// contains interpolated source, log, or model text (INV-016).
struct NextOperation {
  operation: OperationName required;
  /// Arguments matching that operation's request struct.
  arguments: Opaque required;
  /// Why this operation is offered, in typed terms.
  rationale: String optional;
}

/// The stable error codes of plan §10.3.
///
/// `@open` per `rule versioning.error_codes`: a client MUST treat an
/// unrecognized code as a non-retryable typed failure.
@open
enum ErrorCode {
  /// The named snapshot is not the current one, or is not sealed where
  /// sealing is required.
  StaleSnapshot,
  /// The request needs a semantic feature this daemon does not
  /// implement. Registered-but-unshipped operations use this code.
  UnsupportedSemanticFeature,
  /// A protected Intent Contract field was mutated without the
  /// `revise-intent` capability, or against an intent lock (plan §5.4).
  IntentMutationDenied,
  /// The evidence present does not meet the required assurance class.
  InsufficientEvidence,
  /// Task budget was exhausted. Never a semantic verdict (docs/49); it
  /// carries the continuation when one exists, or a typed
  /// `non_resumable_reason`.
  BudgetExhausted,
  /// A continuation's pinned engine or semantic epoch does not match the
  /// daemon's current epochs. The daemon MUST NOT silently re-run.
  ContinuationEpochMismatch,
  /// A source construct maps to more than one semantic element and the
  /// correspondence cannot be decided (plan §16).
  AmbiguousCorrespondence,
  /// The request crosses a trust boundary the Intent Contract does not
  /// authorize (plan §18).
  UntrustedDomainBoundary,
  /// An independent checker rejected a certificate or proof artifact.
  CertificateRejected,
  /// A replay diverged from the recorded execution.
  ReplayDiverged,
  /// The presented capability's level or scope does not permit the
  /// operation. Checked before any semantic work runs (RFC 0027).
  CapabilityDenied,
  /// A promotion gate or intent policy blocked the operation.
  PolicyGateFailed,
  /// An intent bundle's acceptance signature chain failed verification,
  /// or the referenced bundle is absent. CI fails closed on this code
  /// (plan §4.2.1, RFC 0037).
  AcceptanceChainInvalid,
  /// An evidence-graph status promotion lost its compare-and-set against
  /// the claim's current status (plan §11.7, RFC 0038). Re-read and
  /// retry; the lattice never regresses.
  StatusConflict,
  /// A capability's concurrency or resource quota is exhausted (plan
  /// §4.5). Distinct from `BudgetExhausted`, which is task-budget spend
  /// and carries a continuation.
  QuotaExhausted,
  /// An artifact or continuation declares a schema or semantic epoch
  /// unknown or incompatible with this daemon. Typed rejection, never
  /// best-effort decoding (docs/09 T13).
  EpochUnsupported,
  /// An atomic publication aborted (e.g. disk exhaustion, plan §4.5).
  /// Atomicity is per artifact (INV-017, RFC 0038): the artifact whose
  /// publication aborted is not published, and nothing is truncated. A
  /// composite publication (`workspace.create` or
  /// `workspace.create_by_reference` with `seal`, `workspace.seal`) MAY
  /// leave earlier records published, each complete and receipted, and
  /// never leaves its root published (RFC 0026 "Atomicity of
  /// publication", correction 48).
  PublicationAborted,
  /// No protocol version is common to client and daemon, or the client's
  /// major falls outside the N / N−1 window.
  ProtocolVersionUnsupported,
  /// The same `idempotency_key` was replayed with a different canonical
  /// request.
  IdempotencyKeyReused,
  /// The request does not parse, does not validate against this file, or
  /// uses an unknown closed-enum member.
  MalformedRequest,
}

/// A typed error. `recovery` is the only recovery channel: a list of
/// allowed operations with pre-filled arguments, never free-form
/// commands (RFC 0026 "Rejected alternatives").
struct Error {
  code: ErrorCode required;
  /// Stable, non-interpolated explanation of the code in context.
  detail: String required;
  /// Typed, machine-readable specifics of this occurrence; the shape is
  /// determined by `code`. `CertificateRejected` is the first code that
  /// declares one — `CertificateRejection`, as of 3.4 (F19) — and for
  /// every other code no shape is declared and the field stays absent
  /// (`rule encoding.opaque_payloads`).
  data: Opaque optional;
  /// Allowed operations from this state.
  recovery: list<NextOperation> required;
  /// Present when the failure is resumable (`BudgetExhausted`).
  continuation: ContinuationHandle optional;
  /// Present when `BudgetExhausted` is not resumable: the typed reason
  /// no continuation exists
  /// (`schemas/verification-task.schema.json`).
  non_resumable_reason: String optional;
  /// Whether an identical retry can succeed without any change by the
  /// caller.
  retryable: Bool required;
}

/// The declared `Error.data` shape for `code = CertificateRejected` —
/// the kernel's reason *within* `Rejected`, carried to the wire (RFC
/// 0026 F19, bn-dtg61's verdict-fidelity audit, bn-1dj05).
///
/// Every vocabulary here has exactly one owner and none of them is this
/// protocol. `checker` names the trusted checking-base crate whose
/// verdict this error relays — the same identity `detail` already
/// spells and `proof_status` reports. `reason` and `field` are that
/// kernel's *own* stable diagnostic tokens (`Rejection::reason()` and
/// `Field::as_str()` in the owning `continuum-kernel-*` crate),
/// relayed verbatim and never interpreted: the daemon does not close,
/// enumerate, or re-spell them, because transcribing four kernels'
/// rejection vocabularies into a wire enum would put a second authority
/// over vocabularies those crates own — the exact move bn-dtg61
/// declined at source. A reader switches on `checker` first; a token it
/// does not recognize is surfaced verbatim (INV-016), never guessed at.
///
/// The rejection's numeric specifics (offsets, counts, indices) do not
/// travel: they are recoverable by re-running the named kernel over the
/// same bytes, which any holder of the artifact can do — the recovery
/// bn-dtg61's audit already names.
@since("3.4")
struct CertificateRejection {
  /// The kernel crate whose `Rejected` verdict this error relays,
  /// e.g. `continuum-kernel-core`.
  checker: String required;
  /// That kernel's own stable reason token, e.g. `trailing-bytes`,
  /// relayed verbatim.
  reason: String required;
  /// That kernel's own token for the wire position the rejection names,
  /// e.g. `state-vector`, when the rejection names one. Absent when it
  /// does not; never invented.
  field: String optional;
}

/// The request envelope of every operation (RFC 0026).
struct RequestEnvelope {
  /// The negotiated protocol version. A request naming a different
  /// version than the connection negotiated MUST be rejected with
  /// `ProtocolVersionUnsupported`.
  protocol_version: ProtocolVersion required;
  request_id: RequestId required;
  /// REQUIRED for `@mutation` operations, absent for `@readonly` ones.
  idempotency_key: String optional;
  actor: ActorId required;
  /// Checked below the adapter, independently of handle possession.
  capability: CapabilityHandle required;
  operation: OperationName required;
  /// Explicit null when the operation takes no snapshot. The field name
  /// is `snapshot` everywhere, schemas included.
  snapshot: WorkspaceHandle nullable;
  /// Explicit null when the operation takes no intent.
  intent: IntentHandle nullable;
  /// The operation's request struct.
  arguments: Opaque required;
  /// REQUIRED for `@task_starting` operations.
  budget: Budget optional;
  output_policy: OutputPolicy optional;
  trace: TraceContext optional;
  /// Page request; REQUIRED to be honored by `@paginated` operations.
  page: Page optional;
}

/// The result envelope of every operation (RFC 0026).
struct ResultEnvelope {
  request_id: RequestId required;
  status: ResultStatus required;
  /// Operation-specific typed verdict, never bare prose. Null when the
  /// operation declares no `verdict` clause, and on `status = error`.
  verdict: Verdict nullable;
  /// Present exactly when `status = error`.
  error: Error optional;
  /// REQUIRED on every semantic verdict (plan B11). Every dimension
  /// names a producer or reads `Unsupported`.
  assurance: AssuranceEnvelope optional;
  artifacts: list<ArtifactRef> required;
  /// Present when `status` is `task_started` or `task_suspended`, and on
  /// results of task-observing operations.
  task: TaskHandle optional;
  /// Present when `status = task_suspended`, and on a resumable failure.
  continuation: ContinuationHandle optional;
  /// The INV-007 omission manifest. Empty list means nothing was
  /// omitted; the field is never absent.
  omissions: list<Omission> required;
  warnings: list<Warning> required;
  /// Actual spend per budget dimension.
  cost: Cost required;
  /// All six epochs, each pinned or explicitly null.
  epochs: EpochSet required;
  /// Allowed operations from this state — the safe recovery and
  /// discovery surface (plan §0.2).
  next_operations: list<NextOperation> required;
  /// Present on `@paginated` operations; null on the last page.
  next_page_token: PageToken optional;
  /// The operation's response struct. Null on `status = error`.
  payload: Opaque nullable;
  /// The audit record this call produced. REQUIRED on every result of an
  /// `@audit_recorded` operation and on every admission denial, which is
  /// audited whether or not it succeeded (plan §18.5). Absent where the
  /// call was not recorded; a caller MUST NOT read absence as "the
  /// record was withheld". See `rule audit.correlation`, which forbids
  /// this field from becoming an existence oracle.
  audit: AuditCorrelationId optional @since("3.1");
}

/// The typed verdict families. An operation's `verdict` clause names the
/// variant it returns; an operation without a `verdict` clause returns
/// `verdict: null`.
union Verdict {
  /// Claim-level verdict plus its INV-008 reason when inconclusive.
  semantic(SemanticVerdictValue),
  /// Evaluation outcome of a run or check.
  evaluation(EvaluationVerdictValue),
  /// Outcome of a policy or gate decision.
  policy(PolicyVerdictValue),
  /// Outcome of a structural (non-semantic) operation.
  structural(StructuralVerdictValue),
}

struct SemanticVerdictValue {
  verdict: SemanticVerdict required;
  /// REQUIRED when `verdict = inconclusive` (INV-008).
  inconclusive_reason: InconclusiveReason optional;
  /// The assurance class this verdict is supported at.
  assurance_class: AssuranceClass required;
}

struct EvaluationVerdictValue {
  verdict: EvaluationVerdict required;
  /// REQUIRED when `verdict = inconclusive` (INV-008).
  inconclusive_reason: InconclusiveReason optional;
  assurance_class: AssuranceClass required;
}

struct PolicyVerdictValue {
  decision: PolicyDecision required;
  /// Gates evaluated, with their outcomes.
  gates: list<GateOutcome> required;
}

struct StructuralVerdictValue {
  outcome: StructuralOutcome required;
}

enum StructuralOutcome {
  created,
  updated,
  sealed,
  accepted,
  rejected,
  locked,
  cancelled,
  unchanged,
  acknowledged,
}

struct GateOutcome {
  name: GateName required;
  status: GateStatus required;
  evidence: list<EvidenceHandle> required;
}

rule envelope.no_prose {
  """
  Every result field is typed. A daemon MUST NOT return prose in place of
  a verdict, a status, or a reason, and MUST NOT interpolate source,
  logs, model text, or production payloads into `detail`, `rationale`,
  `next_operations`, or any tool description (INV-003, INV-016). Prose
  renderings are adapter projections of these fields.
  """
}

rule envelope.assurance_required {
  """
  A result whose `verdict` is `semantic` or `evaluation` MUST carry the
  nine-dimension `assurance` envelope, and every dimension MUST name a
  producing engine or carry a typed `Unsupported(reason)` (plan B11).
  Hiding uncertainty to save tokens is prohibited (RFC 0027 Safety).
  """
}

rule envelope.epochs_named {
  """
  Every result MUST name all six epochs. An epoch the result cannot pin
  reads null; it is never an absent field. An unsupported or empty task
  still returns a valid machine result naming every epoch and carries no
  success flag.
  """
}

rule envelope.unknown_fields {
  """
  Within a protocol major, a daemon MUST ignore unknown `optional`
  request fields and MUST NOT emit fields the negotiated version does not
  define. A daemon MUST NOT best-effort decode an artifact whose declared
  epoch it does not know: it returns `EpochUnsupported` (docs/09 T13).
  """
}

rule idempotency.replay {
  """
  A mutation replayed with the same `idempotency_key` and a
  byte-identical canonical request MUST return the same task or artifact
  identity. The same key with a different request MUST be rejected with
  `IdempotencyKeyReused`. Keys are scoped per actor and MUST be honored
  for at least the retention window the daemon declares in
  `ServerLimits.idempotency_retention_ms` (default 24h).
  """
}

rule audit.correlation {
  """
  `ResultEnvelope.audit` names the audit record the call produced, so a
  caller can cite it rather than describe it. It MUST be present on every
  result of an `@audit_recorded` operation, on every `@privileged` call
  (which `@audit_recorded` covers), and on every result whose error is
  `CapabilityDenied`, because a denial that leaves no audit record is
  indistinguishable from an attack that was never tried (plan §18.5).

  The identity MUST be a function of the request identity alone —
  `request_id` and `actor` — and MUST NOT vary with the outcome, the
  decision, the presented capability, or whether a named artifact exists.
  Two denials that differ only in whether the artifact exists therefore
  carry the same value and remain byte-identical envelopes, which is the
  existence-oracle rule this field would otherwise break (RFC 0026, plan
  §4.5). A per-record random identity is prohibited for that reason.

  It MUST NOT carry, encode, or be derived from a `cap_*` token: the
  identity is emitted to the caller, and a capability is a secret that
  never appears in a result (RFC 0027 S5). The record it names is read
  through the audit surface, not through this protocol; nothing here
  makes the audit log readable to the caller.
  """
}

rule authorization.independent_of_handles {
  """
  The `capability` in the request envelope is checked below the adapter,
  independently of handle possession, before any semantic work runs. A
  call above the capability's level fails with `CapabilityDenied`.
  Possession of an artifact handle never implies authorization
  (ADR-0037). Every `@privileged` call is audit-recorded with actor,
  capability, inputs, and decision (plan §18.5).
  """
}

rule ordering.deterministic {
  """
  Every list a result returns MUST be deterministically ordered by
  content identity or by an explicitly declared sort key. Two identical
  requests against the same snapshot and epochs MUST return identical
  bytes under the same encoding.
  """
}

rule pagination.deterministic {
  """
  `@paginated` operations accept `page_size` and an opaque `page_token`
  and return `next_page_token`, null on the last page. Paging MUST be
  stable against the pinned snapshot and epochs: two identical page
  requests return identical pages. A `page_token` minted under different
  epochs MUST be rejected with `EpochUnsupported`.
  """
}


// ---------------------------------------------------------------------
// 7. Connection handshake and capability negotiation
//
// The handshake is connection-level, not an operation: it precedes any
// request envelope and is therefore not part of the plan §10.2 operation
// registry. Minting, scoping, delegating, and revoking capabilities is a
// separate administrative surface (plan §4.5) that is out of scope for
// this IDL version; see the Open items at the end of this file.
// ---------------------------------------------------------------------

/// Inclusive range of protocol versions a client accepts.
struct VersionRange {
  low: ProtocolVersion required;
  high: ProtocolVersion required;
}

/// First frame on a connection, sent by the client.
struct ClientHello {
  /// The client's supported range. The daemon selects the highest common
  /// version.
  protocol_versions: VersionRange required;
  /// Encodings the client accepts, most preferred first.
  encodings: list<Encoding> required;
  /// Client software identity, for the audit log.
  client: String required;
  actor: ActorId required;
  /// The capability the connection presents. Every request on the
  /// connection is authorized against a capability; a connection MAY
  /// present a narrower one per request.
  capability: CapabilityHandle required;
  /// Optional feature identifiers the client understands. Unknown
  /// identifiers MUST be ignored by the daemon.
  features: list<String> optional;
}

/// Second frame, sent by the daemon on success.
struct ServerWelcome {
  /// The selected version: the highest one common to both sides.
  protocol_version: ProtocolVersion required;
  encoding: Encoding required;
  /// The majors this daemon serves concurrently: N and N−1.
  majors_served: list<U32> required;
  /// Daemon software identity, for the audit log and defect reports.
  server: String required;
  /// The authority the presented capability actually confers, after
  /// scoping. A client MUST NOT infer authority from anything else.
  grant: CapabilityDescriptor required;
  limits: ServerLimits required;
  /// Feature identifiers the daemon supports, intersected with the
  /// client's.
  features: list<String> required;
  /// The epochs this daemon is currently serving new work under.
  epochs: EpochSet required;
  /// Epoch advances announced but not yet applied. Plan §4.6 requires
  /// each advance to publish its typed per-artifact-class compatibility
  /// statement before it is applied; this is where a client reads it.
  pending_advances: list<EpochAdvanceNotice> required;
}

/// Second frame, sent by the daemon when it refuses the connection.
///
/// The alternative to `ServerWelcome`, never sent beside it. Without it a
/// client cannot tell a typed refusal from a transport failure, which is
/// the gap RFC 0027 raised as F4. The two frames are told apart by their
/// required fields and neither validates as the other: `ServerWelcome`
/// requires `protocol_version`, this frame requires `code`.
@since("3.1")
struct ServerReject {
  /// Why the connection was refused. `rule handshake.rejection` fixes
  /// the admissible set.
  code: ErrorCode required;
  /// Stable, non-interpolated explanation of the code. Never a rendering
  /// of a capability, a token, or anything the client supplied
  /// (INV-016).
  detail: String required;
  /// Whether an identical reconnection can succeed without any change by
  /// the caller. False for every code this version admits; the field is
  /// declared because `ErrorCode` is `@open` and a later minor may add a
  /// connection-level refusal an identical retry can satisfy.
  retryable: Bool required;
  /// The majors this daemon serves: N and N−1. Present so a client
  /// refused for its version learns the window from the refusal itself;
  /// it never received a `ServerWelcome` and has no other channel for
  /// it.
  majors_served: list<U32> required;
}

/// An announced epoch advance (plan §4.6). Advancing never mutates an
/// existing artifact: re-derived artifacts receive new identities linked
/// to their predecessors by `SUPERSEDES` edges. The daemon may hold at
/// most two epochs concurrently during migration; new work defaults to
/// the newest, and continuations resume only under their pinned epoch.
struct EpochAdvanceNotice {
  /// Which epoch advances: `protocol`, `semantic`, `intent`,
  /// `evidence`, `proof`, or `corpus`.
  epoch: String required;
  from: EpochIdentity required;
  to: EpochIdentity required;
  /// Compatibility statement per artifact class, keyed by the plan §4.4
  /// class token (`rule artifact_class.spelling`).
  compatibility: map<String, Compatibility> required;
  /// Estimated invalidation blast radius by artifact class, keyed by
  /// class token (`rule artifact_class.spelling`).
  blast_radius: map<String, U64> required;
}

/// What a `cap_*` capability confers (RFC 0027 "Authority levels and
/// capabilities").
struct CapabilityDescriptor {
  capability: CapabilityHandle required;
  actor: ActorId required;
  level: AuthorityLevel required;
  /// Snapshots in scope; empty means unrestricted within `level`.
  snapshots: list<WorkspaceHandle> required;
  /// Intents in scope; empty means unrestricted within `level`.
  intents: list<IntentHandle> required;
  /// Artifact classes in scope, as plan §4.4 class tokens
  /// (`rule artifact_class.spelling`); empty means all.
  artifact_classes: list<String> required;
  expires_at: Timestamp nullable;
  /// Whether the holder may delegate, and how deeply.
  delegation_depth: U32 required;
  /// The narrowing surface beyond level and scope. Absent is the
  /// fail-closed reading and is exactly equivalent to an empty profile:
  /// no privileged operation granted, no additional data grant held, no
  /// cross-principal sharing. See `rule capability.profile_narrowing`.
  profile: CapabilityProfile optional @since("3.1");
}

/// A grant a capability carries beyond its level and scope, for the
/// operations that require one in addition to their `authority` clause.
///
/// `@open` per `rule versioning.enums`: a client MUST NOT infer semantics
/// from an unrecognized member, which for a grant is the fail-closed
/// reading — a grant it cannot name is a grant it MUST NOT assume it
/// holds. Adding a member is therefore a compatible change.
@open
@since("3.1")
enum DataGrant {
  /// The production-trace grant `observe.ingest` requires in addition to
  /// `authority execute` (plan §18.2, with the capture-time contract of
  /// plan §18.4; RFC 0027 R-4).
  production_trace,
}

/// What a capability grants and withholds beyond its level and scope
/// (RFC 0027, "The admission predicate").
///
/// This is the wire form of admission test T3 and of the per-operation
/// restrictions a level cannot express: two capabilities with identical
/// levels and scopes differ here in whether they admit `intent.accept`,
/// which before 3.1 was deployment folklore rather than a wire fact.
/// Every field narrows; none widens. A profile can only subtract from
/// what `level` and the scope lists already permit.
@since("3.1")
struct CapabilityProfile {
  /// The `@privileged` operations this capability may invoke (T3). An
  /// operation absent from this list is denied however high the level.
  /// Naming a non-`@privileged` operation here grants nothing.
  privileged_operations: list<OperationName> required;
  /// Operations this capability may not invoke whatever its level
  /// permits — docs/49's Reviewer cell, which a total order cannot
  /// express (RFC 0027 correction 22). An operation named both here and
  /// in `privileged_operations` is denied.
  denied_operations: list<OperationName> required;
  /// Additional grants this capability carries, for operations that
  /// require one beyond their authority level.
  data_grants: list<DataGrant> required;
  /// Whether this capability's publications may be deduplicated against
  /// content another principal already holds. RFC 0026 requires the
  /// sharing policy to be a capability property rather than a
  /// daemon-global flag, because a global flag cannot be scoped,
  /// delegated, or revoked. False does not weaken the indistinguishable-
  /// cost rule: a publication MUST report the same `cost` either way.
  cross_principal_sharing: Bool required;
}

/// Server-declared operational limits, negotiated once per connection.
struct ServerLimits {
  /// Minimum time idempotency keys are honored. Default 86_400_000 ms.
  idempotency_retention_ms: DurationMs required;
  max_page_size: U32 required;
  max_result_bytes: ByteCount required;
  /// Concurrency quota this capability draws on; `QuotaExhausted` is
  /// returned when it is exceeded.
  max_concurrent_tasks: U32 required;
}

rule handshake.negotiation {
  """
  At connection open the client sends `ClientHello` and the daemon
  replies with `ServerWelcome` naming the highest version common to the
  client's range and the daemon's served set, or rejects the connection
  with `ProtocolVersionUnsupported`. The daemon MUST NOT select a version
  outside the client's range. The daemon MUST serve majors N and N−1; a
  client on the previous major is rejected only when it falls outside
  this window. One encoding is selected for the life of the connection.
  """
}

rule handshake.bootstrap_encoding {
  """
  `ClientHello`, `ServerWelcome`, and `ServerReject` MUST be encoded in
  `canonical_json`, regardless of `ClientHello.encodings` and regardless
  of which encoding negotiation selects. `ClientHello` is the frame that
  OFFERS the encodings, so it cannot already be spelled in the one the
  offer has not yet selected; `ServerWelcome` and `ServerReject` are the
  frames that carry the negotiation's own outcome, sent before that
  outcome has anywhere else to apply. `rule handshake.negotiation` fixes
  which encoding is CHOSEN — this rule fixes which encoding the choosing
  itself is spelled in, and the two are independent: a connection that
  negotiates `canonical_cbor` still exchanged its hello, welcome, and any
  reject in `canonical_json`.

  The negotiated encoding governs every frame from the first one that
  follows the handshake onward — the first `RequestEnvelope` and every
  `RequestEnvelope` or `ResultEnvelope` after it, in both directions, for
  the life of the connection. There is no third, mixed state: a
  connection is bootstrapping (three frames, `canonical_json`, at most)
  or negotiated (every frame thereafter, the one encoding `ServerWelcome`
  named).
  """
}

rule handshake.rejection {
  """
  The daemon's second frame is exactly one of `ServerWelcome` or
  `ServerReject`, never both and never neither. A refusal MUST be the
  typed frame: RFC 0026 requires the daemon to reject a connection whose
  version falls outside the served window and one whose capability does
  not admit it, and a client that receives only a closed socket cannot
  tell either refusal from a network failure.

  `ServerReject.code` MUST be `ProtocolVersionUnsupported` or
  `CapabilityDenied`, and `retryable` MUST be false for both. A
  capability refusal MUST NOT distinguish an unregistered token from an
  expired, a revoked, or an unauthorized one: every admission failure is
  one answer (RFC 0027 X1), and the connection frame is not an exception.
  `detail` MUST NOT vary with which of them occurred.

  The frame is sent before any version is negotiated, so it cannot be
  gated on the negotiated version. A daemon MUST send it only when the
  client's offered `VersionRange` reaches a version that defines it —
  `high` at or above `"3.1"` — and MUST close the connection without a
  frame otherwise, because a frame the client cannot parse is not a typed
  refusal. `ServerReject` is terminal: the connection carries no request
  after it.

  A malformed `ClientHello` and an encoding mismatch are outside this
  set. The protocol fixes no code for either — `MalformedRequest` is
  defined against a request envelope, and the handshake precedes any —
  so both remain transport-level closes until a code is declared here.
  """
}

rule capability.profile_narrowing {
  """
  `CapabilityDescriptor.profile` can only deny. An absent profile is the
  fail-closed reading and is equivalent to one whose lists are empty and
  whose `cross_principal_sharing` is false; a daemon MUST NOT read
  absence as "unrestricted".

  Admission composes as a conjunction (RFC 0027 T1–T4). A
  `privileged_operations` entry admits a `@privileged` operation only
  where the level and scope tests already admit it, so no profile entry
  reaches an operation the level denies. A `denied_operations` entry
  denies unconditionally, and an operation named in both lists is denied.
  A `data_grants` member is an additional requirement satisfied, never a
  substitute for a level: `observe.ingest` still requires `execute`.

  A delegated capability's profile MUST be a narrowing of its parent's:
  `privileged_operations` and `data_grants` subsets of the parent's,
  `denied_operations` a superset, and `cross_principal_sharing` false
  wherever the parent's is false. Composed with the level, scope, expiry,
  and depth rules, this is what makes a child's admission set a verified
  subset of its parent's (RFC 0027 D6, D7) rather than a review
  obligation.

  The profile is what the connection's capability confers and is reported
  in `ServerWelcome.grant`; it is never inferred from a successful call
  and never widened by one (RFC 0027 A7, A9).
  """
}

rule artifact_class.spelling {
  """
  Every field this file documents as an artifact class carries a class
  token: `Redacted.original_class`, `ArtifactRef.kind`, each member of
  `CapabilityDescriptor.artifact_classes`, and each key of
  `EpochAdvanceNotice.compatibility` and `.blast_radius`. A class token
  is the plan §4.4 prefix without its trailing `_`. The tokens at this
  protocol version are exactly: `ws`, `in`, `inb`, `model`, `cir`,
  `crash`, `ctx`, `proof`, `ps`, `task`, `ev`, `dbg`, `receipt`, `rt`,
  `forge`, `cont`, `cap`, `diff`, `defect`. The prefix spelling (`ws_`)
  names no class and is not an alias: one class has one spelling
  (ADR-0013).

  A daemon MUST NOT emit any other string in these positions. A
  capability whose `artifact_classes` names a string that is not a token
  MUST be refused where it is provisioned, with a refusal that names the
  string and, for a prefix spelling, the token it meant. A daemon MUST
  NOT register such a capability, and MUST NOT serve it as an empty or
  narrowed scope: a scope that silently matches nothing is a
  mis-provisioning the deployment cannot see.

  A client receiving a string outside the list treats it as an unknown
  member of an `@open` enum (`rule versioning.enums`): it MUST NOT infer
  semantics from it and MUST surface it verbatim as unknown. A new class
  is added by revising this list, and that raises the protocol minor.
  The fields stay `String` within major 3, because narrowing a declared
  field's type is `rule versioning.breaking_change` (RFC 0026 F22).
  """
}

rule handshake.no_session_state {
  """
  The handshake establishes version, encoding, and authority only. No
  semantic state is session-scoped: a dropped connection MUST NOT change
  the meaning of anything (INV-002). Reconnecting with the same handles
  and a valid capability continues the work.
  """
}


// ---------------------------------------------------------------------
// 8. Tasks, continuations, and streams
// ---------------------------------------------------------------------

/// A task record, as returned by `task.status`
/// (`schemas/verification-task.schema.json` is the artifact form).
struct TaskRecord {
  task: TaskHandle required;
  operation: OperationName required;
  status: TaskStatus required;
  snapshot: WorkspaceHandle nullable;
  intent: IntentHandle nullable;
  /// Typed terminal reason; REQUIRED when `status = failed`. A `Failed`
  /// task is never silent (plan §4.5).
  failed_reason: ErrorCode optional;
  /// REQUIRED when `status = suspended`; a suspended task is resumable
  /// by definition (plan §11.4).
  continuation: ContinuationHandle optional;
  /// REQUIRED when `failed_reason = BudgetExhausted` and no continuation
  /// exists.
  non_resumable_reason: String optional;
  budget: Budget required;
  cost: Cost required;
  epochs: EpochSet required;
  priority_class: PriorityClass required;
  /// Semantic milestones reached so far, in order.
  milestones: list<Milestone> required;
  /// Evidence committed so far. Monotonic: entries are never removed.
  committed_evidence: list<EvidenceHandle> required;
}

struct Milestone {
  name: String required;
  at: Timestamp required;
}

/// A progress event on a task subscription. Events are hints; committed
/// artifacts and `task.status` are authoritative.
struct TaskEvent {
  task: TaskHandle required;
  at: Timestamp required;
  kind: TaskEventKind required;
  milestone: Milestone optional;
  cost: Cost optional;
  status: TaskStatus optional;
}

enum TaskEventKind {
  milestone,
  progress,
  status_change,
  evidence_committed,
}

/// A committed evidence-graph delta on an evidence subscription. Unlike
/// task progress events, evidence deltas reference committed artifacts.
struct EvidenceEvent {
  at: Timestamp required;
  kind: EvidenceEventKind required;
  node: EvidenceHandle optional;
  edge: EvidenceHandle optional;
  /// Status after the transition, for `status_transition` events.
  status: EvidenceStatus optional;
  /// The claim whose status changed.
  claim_id: String optional;
}

enum EvidenceEventKind {
  node_published,
  edge_published,
  status_transition,
  conflict_materialized,
}

rule task.no_generic_start {
  """
  There is no generic `task.start`. Long operations are started by the
  `@task_starting` operations declared in this file
  (`verification.start`, `model.check`, `forge.create`, and peers). Each
  is idempotent under `idempotency_key`.
  """
}

rule task.status_monotonic {
  """
  `task.status` is monotonic: reported milestones and committed evidence
  only grow, and a terminal status never changes. A `Failed` task always
  carries a typed `failed_reason`; there is no silent failure (plan
  §4.5).
  """
}

rule task.cancel_correct {
  """
  `task.cancel` triggers request, drain, finalize. It MUST leave either
  committed partial evidence plus a valid continuation, or nothing
  published (INV-009, plan B19). Cancellation MUST NOT truncate a
  publication in progress (INV-017).
  """
}

rule task.resume {
  """
  `task.resume` validates continuation identity, snapshot, and epochs.
  Stale inputs are rejected with `StaleSnapshot`; mismatched epochs with
  `ContinuationEpochMismatch`; an epoch the daemon no longer holds with
  `EpochUnsupported`. Resume MAY add evidence; it MUST NOT replace prior
  artifacts under the same identity.
  """
}

rule task.update_budget {
  """
  `task.update_budget` adjusts the budget of a running task. Raising a
  dimension extends the current run. Lowering a dimension below committed
  spend triggers suspension-with-continuation (plan B18): the task
  transitions to `Suspended` with committed partial evidence plus a valid
  continuation. Silent truncation of a campaign is prohibited (INV-009).
  """
}

rule subscription.hints_only {
  """
  `task.subscribe` streams progress events; they are hints. Committed
  artifacts and `task.status` are authoritative. `evidence.subscribe`
  streams typed evidence-graph deltas for a declared scope; the graph
  itself remains authoritative on reconnect. A dropped subscription
  changes nothing (INV-002); a client MUST be able to recover the same
  state by re-reading.
  """
}

rule subscription.delivery {
  """
  How a `@streaming` operation's `events` frames reach the client. The
  annotation says they are delivered "on the same connection" and each
  operation's `events` clause says which struct they carry; this rule
  states the three things a transport needs and no normative source
  fixed.

  1. An event frame IS the declared event struct — `EvidenceEvent` for
  `evidence.subscribe`, `TaskEvent` for `task.subscribe` — framed
  exactly as every other frame on the connection and spelled in the
  negotiated encoding, written after the operation's initial response.
  There is no event envelope: a frame and a `ResultEnvelope` are told
  apart by their required members, which is the device `ServerWelcome`
  and `ServerReject` already use (`rule handshake.rejection`).
  `ResultEnvelope` requires `request_id` and `status`, which no event
  struct declares; `EvidenceEvent` requires `at` and `kind`, which
  `ResultEnvelope` does not.

  2. An event therefore carries no subscription identity, and that
  decides two questions it would otherwise leave open. A delta selected
  by more than one subscription open on one connection is delivered
  ONCE, because two frames naming one committed artifact are
  indistinguishable from two committed artifacts. And a subscription
  delivers only deltas committed after it was opened: everything
  committed before is the initial response's `frontier`, so no artifact
  is both reported as frontier and delivered as a delta.

  3. A delta names an artifact — the `node` for `node_published`,
  `status_transition`, and `conflict_materialized`, the `edge` for
  `edge_published` — and it is in a subscription's scope exactly when
  that scope's `EvidenceQuery` selects that artifact, by the same
  predicate `evidence.query` answers with. A delta whose kind's member
  is absent names no artifact and is in no scope.

  The predicate is evaluated against the graph as it stands when the
  frame is written, not against the graph at the instant of the delta:
  the graph is authoritative and a delta is a pointer into it, never a
  copy of it (`rule subscription.hints_only`). It is evaluated ONCE per
  delta per subscription, at the first delivery after that delta was
  committed, and a delta the scope did not select then is not
  reconsidered — a subscription is a cursor, not a filter re-run over
  history. So a scope whose clauses a later write would have brought an
  earlier delta inside MAY be silent about that delta, and the client
  recovers it by re-reading rather than by replay. That is the same
  guarantee `task.subscribe` gives from the other direction and the
  reason both are stated as hints: what a stream delivers is never more
  than a subset of what the graph holds, and MUST NOT be relied on as
  more.

  None of this is session state in the sense INV-002 forbids. A
  subscription is a delivery cursor over an append-only, daemon-held
  log of committed deltas, so dropping the connection loses the cursor
  and no artifact, and re-reading yields a superset of what the stream
  delivered.
  """
}

@since("3.3")
rule evidence.edge_identity {
  """
  An evidence-graph artifact is named by what it *is*, through one
  identity seam at artifact class `ev`, and never by who wrote it or
  when (RFC 0038 D2, D4).

  A node's identity derives from the artifact it is about and the
  profile it was captured under. An edge's identity derives from the
  domain tag `evidence-graph-edge/v1`, its `kind`, its `from` and `to`
  handles, and — for `CHECKED_BY` — its `checker`. Each part is framed
  by its byte length, so no pair of inputs can spell another pair's
  preimage by concatenation, and the tag is outside the artifact-handle
  character class, so no node preimage can spell an edge preimage.

  `provenance` is outside both, as `status` and `idempotency_key`
  already are: a replayed write MUST return the original identity
  across processes and producers, and an identity carrying a clock or an
  actor cannot. A checker's retry therefore converges on one edge.
  """
}

rule evidence.traversal {
  """
  What `EvidenceQuery.roots` and `EvidenceQuery.max_depth` select. The
  two fields have been declared since 3.0 and `roots` has said
  "roots to traverse from" since 3.0, but nothing said which way a
  traversal walks a directed edge, what `max_depth` counts, or where an
  edge sits in the count — so a daemon could serve `roots` only as
  handle membership, which is `max_depth = 0` and no traversal at all.
  This rule states it. It adds no field, member, code, struct, or
  operation, and changes no response shape: what moves is which handles
  an already-declared scope selects.

  1. **Scope is a neighborhood, and an edge is an adjacency.** A
     traversal reaches an artifact from a root across an edge in EITHER
     direction. An edge's direction is what it ASSERTS, not which way
     relevance runs: `counterexample REFUTES claim` is evidence about
     the claim and evidence about the counterexample both, and a
     forward-only walk from a claim would reach none of the evidence
     offered to it — every `SUPPORTS`, `REFUTES`, and `COUNTEREXAMPLE_TO`
     edge names the claim as `to`. This is RFC 0038's own reason for a
     graph ("one counterexample refutes several candidates; one
     invariant supports many properties") and docs/44's "each task
     contains only relevant graph slice and handles" — a slice around a
     subject is a neighborhood. Picking one arrow as "the" direction
     would be inventing an answer no source took.

  2. **Depth counts edges.** An artifact named in `roots` is at depth 0.
     A node is at depth `d + 1` when an edge incident to a depth-`d`
     node names it, and its depth is the least such value — the
     shortest undirected path from any root. An edge's depth is the
     GREATER of its two endpoints' depths, or 0 if the edge is itself
     named in `roots`, in which case both its endpoints are at depth 0
     too. An artifact is in scope when its depth is at most `max_depth`.

  3. **`max_depth` absent is unbounded; `max_depth = 0` is membership.**
     Absent, the traversal reaches every artifact connected to a root.
     Zero selects the roots and nothing else, so a client that means
     handle membership can still say so — the reading a pre-rule daemon
     served for every `roots` is still expressible, and is now the
     bound it always was rather than the whole of the field.

  4. **An answer names no dangling edge.** Because an edge's depth is
     the greater of its endpoints', an edge in scope has both its
     endpoints in scope. A returned edge whose endpoints the same answer
     omitted would be a reference the client cannot resolve, and
     "references must resolve" is the graph's own structural refusal
     (RFC 0038's whiteboard compiler, docs/44). The node-property
     clauses — `node_kinds`, `statuses`, `claim_id` — select no edge at
     all when present, so they cannot break this.

  5. **The traversal walks the whole graph; the other clauses filter
     what it reached.** Every clause of an `EvidenceQuery` is a
     conjunction. Depth is computed over the graph as it stands, not
     over the sub-graph the other clauses admit: a walk that could only
     pass through nodes matching `statuses` would mean "paths through
     `validated` nodes", which no source declared and which would make
     one clause change another's meaning.

  6. **Empty or absent `roots` is the whole graph, and `max_depth` then
     selects nothing away.** This is the field's own declared sentence.
     With no root there is nothing to measure a depth from, and a bound
     on a distance that does not exist cannot exclude anything; a daemon
     MUST NOT read an absent `roots` as an empty neighborhood.

  `evidence.subscribe` inherits all of this unchanged, because `rule
  subscription.delivery` says a delta is in scope exactly when the
  scope's `EvidenceQuery` selects the artifact "by the same predicate
  `evidence.query` answers with". As that rule already states, the
  predicate is evaluated against the graph as it stands when the frame
  is written, so an edge committed after a delta can bring a later
  delta inside a scope and does not retroactively deliver an earlier
  one — a subscription is a cursor, and re-reading is what recovers the
  difference.
  """
}

@since("3.5")
rule whiteboard.compilation {
  """
  What `whiteboard.compile` does with a note. plan §11.5 states the
  seven headings, `schemas/whiteboard-note.schema.json` states the
  note's shape, and RFC 0038 W1–W9 state what each section compiles to;
  none of the three said anything about a wire, and RFC 0038 recorded
  two questions as open. Both are decided here.

  1. **Compilation is the daemon's, and the note is what crosses.** An
     entry's `references` MUST each name an artifact the graph holds a
     node about (docs/44 "references must resolve", W4), and a
     conclusion's supporting edges are drawn to *every* node the graph
     holds about each cited artifact (W6) — neither is computable by a
     party that does not hold the graph, and a client resolving against
     a stale `evidence.query` answer would be asserting a fact about
     the graph rather than reading one. The stronger reason is what a
     client-side compiler would have to put on the wire: a proposal
     carries a node kind, a claim identity, and a `provenance.actor`,
     so a wire of *proposals* is a wire of caller-filled fields, and a
     field a caller can fill is a field a caller can lie in (RFC 0038
     D3). W2 says "an author MUST NOT be able to name the kind
     directly: if it could, the seven headings would be decoration",
     and only a daemon that reads the sections itself can hold that.

  2. **The note is an `Opaque` and its schema decides its shape.** The
     request carries the note as `note: Opaque required`, governed by
     `schemas/whiteboard-note.schema.json` — the third group of open
     item 3 and `rule encoding.opaque_payloads`'s "a schema-governed
     value carried verbatim". It is deliberately **not** declared as a
     struct here: INV-003 makes that schema normative for a note, and a
     second declaration of the same twelve-member document would create
     exactly the disagreement `rule conformance.registry_agreement`
     forbids one namespace down, with no source entitled to decide it.
     `IntentChangeSet.changes` and `context.compile`'s `pack` are the
     precedent. The field is not one of RFC 0026 F3's four shapeless
     `Opaque` members, because it names a schema.

     A daemon MUST validate the note against that schema **before
     reading any member of it**, and MUST refuse a non-conforming note
     with `MalformedRequest`. INV-016: a note is untrusted source, and
     the order matters — a daemon that read `author` or `goal` first
     would be acting on a document it had not yet decided was one.

  3. **A note's `author` MUST be the admitted capability's actor.** A
     mismatch is `CapabilityDenied`. The field cannot simply be
     trusted: every node compiled from the note takes it as
     `provenance.actor` (W9), so a trusting daemon would let a caller
     append under another principal's name — the thing `observe.ingest`
     and `evidence.link` both refuse by taking the actor from the grant
     and declaring no request field for it. Nor can it be overwritten,
     because the note is a document the caller holds and a daemon that
     rewrote a member would be compiling something other than what it
     was handed. Requiring agreement is RFC 0027 T4 at the note's
     granularity, and its refusal is T4's: "an attempt to act as
     another principal is an authorization failure and MUST NOT be
     distinguishable from any other one."

  4. **A compiled node's identity is what the node asserts.** The
     preimage is the domain tag `whiteboard-note/v1`, the node's kind,
     its subject handle, and its claim identity, each framed by its byte
     length, resolved through the same `ContentIdentifier` seam at
     artifact class `ev` that names every other evidence artifact
     (`rule evidence.edge_identity`). The tag carries a `/`, which is
     outside the artifact-handle character class, so no `observe.ingest`
     node preimage can spell one of these and no edge preimage can
     either.

     The note handle, the author, and the time are outside it, as
     `provenance` is outside a node's and an edge's identity: RFC 0038
     D4 requires a replayed write to return the original node identity
     "across processes and producers", and two agents who write the
     same line about the same claim are making one assertion, not two.
     Which section proposed a node is recoverable from its kind, because
     the six proposing sections name six distinct kinds (W2) — so the
     "known fact and candidate invariant about one claim are two
     assertions" property W2 states survives an identity that names no
     section. The `SUPPORTS` edges a decision draws take `rule
     evidence.edge_identity` unchanged.

  5. **Nothing a note says is a status, and nothing it proposes is
     accepted.** Every compiled node lands at `proposed`. This
     operation writes no status, mints no promotion, and cannot reach
     RFC 0038's compare-and-set, so RFC 0027 A5's "no operation in the
     registry sets a status" survives the addition verbatim. Refusal is
     whole-note (W8): a daemon MUST return a complete compilation or
     refuse, and MUST NOT append a subset — INV-017's per-artifact
     atomicity read at the note's granularity, and the reason two
     entries in tension stay two proposals rather than being resolved
     by authoring order (plan §11.7).
  """
}

rule context.compilation {
  """
  What a daemon that *serves* `context.compile` answers with. The
  operation has been declared since 3.0 and refused
  `UnsupportedSemanticFeature` for as long as no compiler existed
  (`rule errors.unsupported_surface`); serving it is the 1.7/1.8 shape —
  already-declared vocabulary answered rather than refused — and the
  declaration leaves four real decisions open that no wire text fixed.
  All four are stated here; none of them adds, removes, or moves a
  declaration.

  1. **`guarantees` is a request and never becomes a claim.** The field
     is `list<String>` (RFC 0028 F6) and shares its spelling with the
     pack's own `guarantees`, which is a closed thirteen-member set of
     *checked* claims. A daemon MUST NOT echo a requested guarantee it
     did not achieve (RFC 0028 C1), MUST record a
     requested-but-unachieved guarantee in the pack's omission manifest,
     and MUST refuse a token outside the closed vocabulary with
     `MalformedRequest` — forward compatibility here is achieved by
     rejecting, never by ignoring, which is the same reading `rule
     versioning.enums` gives a closed enum. The wire type cannot state
     any of this, which is why the rule does.

  2. **`audience` selects rendering and MUST NOT reach `context_id`.**
     RFC 0028: "two `context.compile` requests differing only in
     `audience` MUST produce the same `ctx_*`". A daemon MUST derive a
     pack's identity from the compiled question and MUST NOT admit
     `audience` — or the envelope's `budget`, which `rule
     versioning.compatible_change`'s companion RFC 0030 places in
     execution identity — into it. A caller that changes only the
     audience is asking one question twice.

  3. **The declared `verdict` is the pack's, not a second opinion.** The
     operation declares `verdict EvaluationVerdictValue`; that value's
     `verdict` MUST equal the pack's `verdict` and its
     `assurance_class` MUST equal the pack's `assurance.class` (RFC
     0028, "Wire surface"). A pack whose question is not about an
     evaluation outcome carries `inconclusive` with a typed
     `InconclusiveReason` and MUST NOT default to `satisfied`; a daemon
     that has neither an evaluation verdict nor a typed reason MUST
     refuse with `InsufficientEvidence` rather than choose one. The
     envelope's `omissions` list is the wire projection of the pack's
     manifest and MUST agree with it record for record.

  4. **Which refusal covers an absent producer, and which an absent
     input.** `UnsupportedSemanticFeature` is the answer where the
     deployment holds no producer able to compile from the named root —
     it is a fact about the deployment, uniform over every root, and a
     daemon MUST answer it identically whether or not it holds the root
     named, because a distinguishable answer would be the existence
     oracle RFC 0027 X2 closes. `InsufficientEvidence` is the answer
     where the deployment *can* compile but the named root selects
     nothing to compile from. `BudgetExhausted` remains declared and is
     the ceiling branch; a daemon that does not pack a root pack MUST
     NOT repurpose it.

  Serving is a property of a deployment, not of the operation (`rule
  errors.common`, as relaxed at 3.2): a deployment holding a compiler
  answers `ok`, one that does not keeps `UnsupportedSemanticFeature`,
  and both conform. That is why this rule raises no flag and takes no
  version.
  """
}

rule errors.common {
  """
  Every operation MAY additionally return `MalformedRequest`,
  `ProtocolVersionUnsupported`, `CapabilityDenied`, `QuotaExhausted`,
  `EpochUnsupported`, and `UnsupportedSemanticFeature`; every
  `@mutation` operation MAY additionally return `IdempotencyKeyReused`
  and `PublicationAborted`; every operation taking a non-null `snapshot`
  MAY additionally return `StaleSnapshot`. An operation's `errors`
  clause lists the codes it may return beyond these. A daemon MUST NOT
  return a code outside that union for the operation.

  `UnsupportedSemanticFeature` joined the always-admissible set at 3.2,
  and the reason is that it had to: `rule errors.unsupported_surface`
  REQUIRES that code of any operation whose producing subsystem has not
  shipped, while this rule forbade it for the three operations declaring
  `errors []` and the twenty-two that do not name it — so for those
  twenty-five the two rules could not both be obeyed, and a daemon had
  to break one of them or return a code that names something false.
  Fifty of the seventy-two already declared it, so admitting it
  everywhere moves the wire very little and states what was already
  true: whether a lane has shipped is a property of a deployment, not of
  an operation, and every operation can meet a deployment that does not
  implement it. Those fifty clauses keep the code; a clause that names a
  code the union already admits is redundant, not wrong, and removing
  fifty entries would be churn with no wire effect. The compatible
  direction is `rule versioning.compatible_change`'s "relaxing a
  server-side constraint", and a client is unaffected because `ErrorCode`
  is `@open` and an unrecognized code is already required to be treated
  as a non-retryable typed failure.
  """
}

rule errors.unsupported_surface {
  """
  Operations registered in plan §10.2 ahead of their producing subsystem
  (the `observe` family, and any operation whose lane has not shipped)
  MUST fail with the typed `UnsupportedSemanticFeature` rather than
  degrading, guessing, or returning an empty success. The code is inside
  every operation's union as of 3.2 (`rule errors.common`), so obeying
  this rule never requires returning a code that rule forbids; before
  3.2 it did, for twenty-five of the seventy-two.
  """
}

rule errors.defect_emission {
  """
  A `ReplayDiverged`, an incremental-parity mismatch, an engine crash, or
  an explanation-validation failure MUST publish a `defect_*` artifact,
  and the result reporting the condition MUST carry that handle in
  `artifacts` (plan §4.7). A client MUST NOT have to reconstruct a defect
  report from an error string. An engine defect is never a semantic
  verdict about the client's program: the task reports typed
  inconclusiveness (INV-008) and the assurance envelope names the
  dimensions it could not establish.
  """
}


// ---------------------------------------------------------------------
// 9. Shared operation types
// ---------------------------------------------------------------------

/// What an operation is aimed at.
struct Target {
  kind: TargetKind required;
  id: String required;
}

/// Content identities of the ten plan §4.2 snapshot components
/// (`schemas/workspace-snapshot.schema.json`).
struct SnapshotComponents {
  /// Content identities of the source files. This list says *what* the
  /// snapshot's files are and not *where* they go; `file_components`
  /// says where (`rule snapshot.file_components`).
  files: list<Commitment> required;
  cml_modules: list<Commitment> required;
  rust_extraction: list<Commitment> required;
  domain_packs: list<Commitment> required;
  dependencies: list<Commitment> required;
  /// Toolchain and semantic epochs of the snapshot. The protocol epoch
  /// is a connection property and is NOT part of snapshot identity
  /// (plan §4.6; SD-13).
  epochs: SnapshotEpochs required;
  /// Reference to the governing Intent Contract — the identity only,
  /// never the contract itself (plan §4.2, INV-001).
  intent: IntentHandle required;
  correspondence: list<Commitment> required;
  proof_environment: list<Commitment> required;
  configuration: list<Commitment> required;
  /// The `files` components with the workspace-relative path each one
  /// sits at, so a snapshot is reconstructable from the request that
  /// creates it. See `rule snapshot.file_components`.
  file_components: list<FileComponent> optional @since("3.2");
}

/// One source-file component: the path the content sits at, and the
/// content identity of the content itself.
///
/// `schemas/workspace-snapshot.schema.json` requires both members of
/// every `files` item (`path` and `digest`), so this struct is what the
/// normative artifact class already says a file component is; before 3.2
/// the wire carried only the second of the two.
struct FileComponent {
  /// Workspace-relative path, the schema's `files[].path`.
  path: String required;
  /// Content identity of the file, the schema's `files[].digest`.
  commitment: Commitment required;
}

struct SnapshotEpochs {
  semantic: EpochIdentity required;
  proof: EpochIdentity required;
  /// The snapshot's toolchain *epoch*, which is what plan §4.2 and
  /// `schemas/workspace-snapshot.schema.json` both declare. It is not a
  /// content identity of a toolchain declaration file; no plan §4.2
  /// component is.
  toolchain: EpochIdentity optional;
}

rule snapshot.file_components {
  """
  When `SnapshotComponents.file_components` is present it MUST have the
  same length as `files` and its `commitment` values MUST equal `files`
  element for element, in order: the two fields are one statement about
  one set of files, and `files` is its projection onto content
  identities. A daemon MUST reject a disagreement with
  `MalformedRequest` rather than preferring either list, and MUST place
  each file at its declared `path`.

  When it is absent the request declares no placement and a daemon MUST
  NOT invent one: it either resolves the placement out of band — content
  reaches a daemon out of band in any case, since no operation in this
  file carries file bytes — or refuses. Two files with identical bytes
  at two paths are two components, and before 3.2 the wire could not say
  so, which is what made a snapshot unreconstructable from the
  `workspace.create` request that named it.

  The field is `optional` rather than replacing `files`, because
  changing that field's type is a breaking change under `rule
  versioning.breaking_change` and this revision is a minor. The eight
  other component lists carry the same gap against the same schema —
  `named_digest_list` requires a `name` beside each `digest` — and are
  recorded as RFC 0026 F15 rather than paid here: fixing them the same
  way is eight more optional fields for a gap nothing has reached, and
  fixing them properly is the major-version type change this one is a
  compatible stand-in for.
  """
}

rule snapshot.by_reference {
  """
  `workspace.create_by_reference.components` is the content identity of a
  `SnapshotComponents` value, taken over that value's **`canonical_json`**
  encoding — `rule encoding.canonical_form` fixes exactly one byte
  spelling per value per encoding, so the commitment is a function of the
  components and a client derives the same one the daemon does. The
  encoding is named here and is NOT the connection's: an identity that
  moved with the negotiated encoding would give one component set two
  names on two connections, which is what content addressing exists to
  prevent, and `rule handshake.bootstrap_encoding` already fixes
  `canonical_json` unconditionally for exactly this kind of reason —
  "independent of `ClientHello.encodings` and of the negotiation
  outcome". A daemon MUST
  resolve it to the stored value and then serve the request **as
  `workspace.create` serves the same components inline**: the same
  checks, the same identity derivation, the same lineage, the same
  response. Two spellings of one argument MUST NOT become two
  behaviours.

  The resolved value's own `intent` and `epochs` members are NOT read on
  this lane; the request's are what govern, and both are `required`
  there. `intent` because admission decides T2 and T3 from the request
  before any handler runs (INV-015): a governing contract hidden behind a
  reference is a scope claim the admission predicate cannot see, and a
  create that inherited another caller's intent would re-govern a
  snapshot by naming bytes. `epochs` because they are the caller's
  declaration about the snapshot, checked against the epochs the
  deployment serves — a daemon reading them out of its own store would
  be checking itself, and the same components at two semantic epochs are
  two snapshots.

  How a daemon comes to hold a value is out of band, exactly as content
  is: "content reaches a daemon out of band in any case, since no
  operation in this file carries file bytes" (`rule
  snapshot.file_components`). A conforming daemon MAY additionally record
  the components of a `workspace.create` it accepted, under this
  identity, so the inline form registers what the by-reference form can
  then name. It MUST NOT invent a set it does not hold: an unresolvable
  commitment is `CapabilityDenied`, byte identical with every other
  denial (RFC 0027 X2), never a distinguishable not-found.

  The reference is a **content** identity and therefore survives
  everything a handle survives: it is valid on a new connection, after a
  reconnection, and across a daemon upgrade within the major (`rule
  versioning.handle_stability`), and it names the same components on
  every daemon that holds them. That is what separates it from a
  session-scoped alias, which `rule handshake.no_session_state` forbids
  and which no conforming reader could refuse.
  """
}

/// An in-memory editor buffer overlaid on a snapshot's files.
struct FileOverlay {
  path: String required;
  content: Bytes required;
}

/// Policy governing whether and how a Context Pack is compiled with a
/// result (RFC 0027 "Context policy").
struct ContextPolicy {
  /// Compile a Context Pack on failure. Default behavior when absent is
  /// to compile one pack plus `next_operations`.
  compile_on_failure: Bool required;
  audience: Audience optional;
  budget: Budget optional;
}

/// A change proposed to an Intent Contract.
struct IntentChangeSet {
  /// The contract fields being changed, with their proposed values, in
  /// the form of `schemas/intent-contract.schema.json`.
  changes: Opaque required;
  /// Free of untrusted interpolation; typed rationale for reviewers.
  rationale: String required;
}

/// One `Experiment` line of a whiteboard note, compiled
/// (RFC 0038 W3, docs/44 "experiments become task proposals").
///
/// plan §11.2's twenty node kinds have no task kind, so an experiment
/// proposes a *task* rather than a node: it carries no claim identity,
/// no subject, and therefore no handle — a task proposal is not a graph
/// artifact and nothing publishes one. What it can honestly name is
/// which line it came from and what that line would be run against.
///
/// The line's own prose is deliberately absent. It is the caller's text,
/// the caller holds the note it sent, and echoing untrusted text back
/// into a result is exactly what `rule envelope.no_prose` and INV-016
/// forbid; `index` is how a client recovers the sentence from the
/// document it already has.
@since("3.5")
struct WhiteboardTaskProposal {
  /// Position in the note's `experiments` array, counting from zero.
  index: U32 required;
  /// The prior artifacts the experiment would be run against, in the
  /// note's own order. Every one resolved before the compilation
  /// happened (RFC 0038 W4).
  references: list<Commitment> required;
}

/// A filter over the evidence graph.
struct EvidenceQuery {
  node_kinds: list<EvidenceNodeKind> optional;
  edge_kinds: list<EvidenceEdgeKind> optional;
  statuses: list<EvidenceStatus> optional;
  /// Claim identity or property identifier to scope the query to.
  claim_id: String optional;
  /// Roots to traverse from; empty means the whole graph in scope.
  /// Which way a traversal walks an edge, and where an edge sits in the
  /// depth count, are `rule evidence.traversal`.
  roots: list<EvidenceHandle> optional;
  /// The traversal's bound, in edges (`rule evidence.traversal`).
  /// Absent is unbounded; `0` selects the roots alone.
  max_depth: U32 optional;
}


// =====================================================================
// 10. Operations
//
// The complete plan §10.2 registry: 75 operations in 19 namespaces.
// Each operation's `authority` clause mirrors RFC 0027's registry table
// exactly; a generator MUST fail if the two disagree.
// =====================================================================

// --- workspace -------------------------------------------------------

/// Create an immutable workspace snapshot from content identities, a
/// working tree, or an overlay (plan §4.2). A tool call never means
/// "whatever is on disk"; it means a named snapshot.
@mutation
operation workspace.create {
  authority propose;
  request {
    components: SnapshotComponents required;
    /// Editor buffers overlaid on `components`.
    overlay: list<FileOverlay> optional;
    /// Seal the snapshot on creation.
    seal: Bool optional;
  };
  response {
    snapshot: WorkspaceHandle required;
    sealed: Bool required;
    diagnostics: list<Diagnostic> required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, AcceptanceChainInvalid];
}

/// Create an immutable workspace snapshot from a component set this
/// daemon already holds, named by that set's content commitment instead
/// of enumerated inline (plan §4.2, `rule snapshot.by_reference`).
///
/// `workspace.create` is untouched and is what a client sends when the
/// daemon holds no such set. The two are one act with two spellings of
/// one argument: a daemon serves this one by resolving `components` to
/// the very `SnapshotComponents` value the inline form would have
/// carried, so equal components yield the same `ws_` handle whichever
/// spelling named them, and neither form's bytes move.
///
/// Two members of that value do **not** come from the reference and
/// travel on every request. `intent` is the governing contract, and
/// admission reads it from the *request* before any handler runs (RFC
/// 0027 T2/T3, INV-015) — a scope claim a daemon cannot read from the
/// request is a scope claim admission cannot check. `epochs` are the
/// caller's own declaration and are checked against the epochs the
/// daemon serves; a daemon that read them out of what it stored would be
/// checking itself. A component set is shared. A governing intent and an
/// epoch declaration are the caller's, per request.
///
/// A commitment this daemon cannot resolve is `CapabilityDenied`, byte
/// identical with every other denial (RFC 0027 X2), and it is not an
/// existence oracle: a caller names a commitment, and that commitment's
/// preimage is the component set it would have had to hold to derive it.
@mutation
@since("3.6")
operation workspace.create_by_reference {
  authority propose;
  request {
    /// Content identity of a `SnapshotComponents` value this daemon
    /// holds, over that value's `canonical_json` encoding — one value,
    /// one spelling, and not the connection's encoding
    /// (`rule snapshot.by_reference`).
    components: Commitment required;
    /// Toolchain and semantic epochs of the snapshot (plan §4.2; SD-13).
    epochs: SnapshotEpochs required;
    /// Reference to the governing Intent Contract — the identity only,
    /// never the contract itself (plan §4.2, INV-001).
    intent: IntentHandle required;
    /// Seal the snapshot on creation.
    seal: Bool optional;
  };
  response {
    snapshot: WorkspaceHandle required;
    sealed: Bool required;
    diagnostics: list<Diagnostic> required;
  };
  verdict StructuralVerdictValue;
  errors [AcceptanceChainInvalid];
}

/// Fork an existing snapshot, optionally applying patches or overlays.
/// The fork preserves the intent binding by identity; rebinding a
/// lineage to a different intent is privileged and produces an intent
/// diff (plan §4.2, INV-001).
@mutation
operation workspace.fork {
  authority propose;
  request {
    base: WorkspaceHandle required;
    overlay: list<FileOverlay> optional;
    /// Patch content identities to apply to the base.
    patches: list<Commitment> optional;
  };
  response {
    snapshot: WorkspaceHandle required;
    /// The preserved intent binding.
    intent: IntentHandle required;
    /// Pre-computed diff against the base, when available without
    /// evaluation.
    pre_diff: DiffHandle optional;
    diagnostics: list<Diagnostic> required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature];
}

/// Diff two snapshots at the requested layers, producing a
/// `schemas/semantic-diff.schema.json` artifact (RFC 0031).
@readonly @task_starting
operation workspace.diff {
  authority propose;
  request {
    before: WorkspaceHandle required;
    after: WorkspaceHandle required;
    /// Layers to compute: textual, structural, semantic, intent.
    layers: list<DiffLayer> required;
  };
  response {
    diff: DiffHandle required;
    /// The diff artifact, inline, in the form of
    /// `schemas/semantic-diff.schema.json`.
    summary: Opaque required;
  };
  verdict PolicyVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted];
}

enum DiffLayer {
  textual,
  structural,
  semantic,
  intent,
}

/// Seal a snapshot as immutable. Sealed snapshots are the only valid
/// semantic inputs; unsealed snapshots are rejected with
/// `StaleSnapshot`.
@mutation
operation workspace.seal {
  authority propose;
  request {
    snapshot: WorkspaceHandle required;
  };
  response {
    snapshot: WorkspaceHandle required;
    root_digest: Commitment required;
  };
  verdict StructuralVerdictValue;
  errors [];
}

// --- intent ----------------------------------------------------------

/// Return the canonical Intent Contract
/// (`schemas/intent-contract.schema.json`).
@readonly
operation intent.get {
  authority read;
  request {
    intent: IntentHandle required;
  };
  response {
    intent: IntentHandle required;
    contract: Opaque required;
    /// Registry record, including protection status and acceptance
    /// chain (`schemas/intent-registry-record.schema.json`).
    record: Opaque required;
  };
  errors [AcceptanceChainInvalid];
}

/// Classify the changes between two Intent Contracts, with proof
/// obligations and policy impact (plan §5.3, RFC 0031).
@readonly
operation intent.diff {
  authority read;
  request {
    before: IntentHandle required;
    after: IntentHandle required;
  };
  response {
    diff: DiffHandle required;
    summary: Opaque required;
  };
  verdict PolicyVerdictValue;
  errors [UnsupportedSemanticFeature];
}

/// Create a proposal. It cannot mutate existing intent: the result is a
/// `Proposed` revision that gains INV-001 protection only through
/// `intent.accept`.
@mutation
operation intent.propose_revision {
  authority revise_intent;
  request {
    base: IntentHandle required;
    changes: IntentChangeSet required;
  };
  response {
    proposal: IntentHandle required;
    diff: DiffHandle required;
  };
  verdict StructuralVerdictValue;
  errors [IntentMutationDenied, UnsupportedSemanticFeature];
}

/// Accept a proposed intent into the registry. The only transition from
/// `Proposed` to protected status; never performed implicitly by any
/// other operation (plan §5.4).
@mutation @privileged @audit_recorded
operation intent.accept {
  authority revise_intent;
  request {
    proposal: IntentHandle required;
    /// Acceptance record, including the signature chain to verify
    /// (plan §4.2.1).
    acceptance: Opaque required;
    /// The signed intent bundle the acceptance record came from, when
    /// the proposal was imported rather than authored locally. CI fails
    /// closed with `AcceptanceChainInvalid` when the referenced bundle
    /// is absent or its chain does not verify (plan §4.2.1).
    bundle: IntentBundleHandle optional;
  };
  response {
    intent: IntentHandle required;
    record: Opaque required;
  };
  verdict StructuralVerdictValue;
  errors [IntentMutationDenied, AcceptanceChainInvalid, PolicyGateFailed];
}

/// Reject a proposed intent revision with a typed reason.
@mutation @privileged @audit_recorded
operation intent.reject {
  authority revise_intent;
  request {
    proposal: IntentHandle required;
    reason: String required;
  };
  response {
    proposal: IntentHandle required;
  };
  verdict StructuralVerdictValue;
  errors [IntentMutationDenied];
}

/// Edit the plan §5.4 policy table. Verbs are drawn from RFC 0037's
/// closed set; free-form policy strings are rejected. Subsequent
/// mutation attempts against a locked field fail with
/// `IntentMutationDenied`.
@mutation @privileged @audit_recorded
operation intent.lock {
  authority revise_intent;
  request {
    intent: IntentHandle required;
    /// Field-to-verb policy table
    /// (`schemas/intent-contract.schema.json` `policy_verb`).
    policy: map<String, String> required;
  };
  response {
    intent: IntentHandle required;
    policy: map<String, String> required;
  };
  verdict StructuralVerdictValue;
  errors [IntentMutationDenied, MalformedRequest];
}

// --- verification ----------------------------------------------------

/// Start a verification campaign against a target under an intent and a
/// budget. Returns a task handle, or a cached result when one exists for
/// the same snapshot, intent, target, and epochs.
///
/// As of 3.4 (F20), an identity that *already* resolves to a terminal,
/// non-`Completed` task — `Cancelled`, or a non-resumable `Failed` — is
/// answered on the task-observing lane: `status = ok` with the response
/// carrying `task` and not `result`, mirroring `task.resume`'s own
/// terminal short-circuit, because a terminal task is not being started
/// and a cancelled or failed campaign produced no output for the
/// result branch to reuse (RFC 0030 reuse classes; RFC 0026 "What
/// `task_started` means when an identity resolves to a task that will
/// not run again"). `task_started` therefore states that this call's
/// answer names a task this call itself started — whatever status it
/// reached before the answer was written — or one that can still run;
/// an identity that was terminal before the call never takes that lane.
@mutation @task_starting
operation verification.start {
  authority execute;
  request {
    target: Target required;
    portfolio: Portfolio required;
    context_policy: ContextPolicy optional;
    priority_class: PriorityClass optional;
  };
  response {
    task: TaskHandle optional;
    /// Present instead of `task` when a cached result is returned.
    result: VerificationResult optional;
  };
  errors [UnsupportedSemanticFeature, InsufficientEvidence, BudgetExhausted,
          UntrustedDomainBoundary];
}

/// Return the typed result of a verification task.
@readonly
operation verification.result {
  authority execute;
  request {
    task: TaskHandle required;
  };
  response VerificationResult;
  verdict SemanticVerdictValue;
  errors [BudgetExhausted, ContinuationEpochMismatch];
}

/// Block, within the request budget, on a started verification task and
/// return its result. Returns `status = task_started` unchanged when the
/// budget elapses first; waiting never changes a verdict.
@readonly @task_starting
operation verification.await {
  authority execute;
  request {
    task: TaskHandle required;
    timeout_ms: DurationMs optional;
  };
  response VerificationResult;
  verdict SemanticVerdictValue;
  errors [BudgetExhausted, ContinuationEpochMismatch];
}

struct VerificationResult {
  task: TaskHandle required;
  target: Target required;
  /// The intent-scope fragments this result covers. A fragment the
  /// campaign did not cover is reported in `omissions`, never implied.
  fragments: list<Fragment> required;
  /// Evidence roots this verdict rests on.
  evidence: list<EvidenceHandle> required;
  /// Counterexample, when the verdict is `refuted`.
  crashpack: CrashpackHandle optional;
  /// Compiled Context Pack, per `ContextPolicy`.
  context: ContextHandle optional;
  continuation: ContinuationHandle optional;
}

// --- model -----------------------------------------------------------

/// Check a model against a property under intent and budget.
@mutation @task_starting
operation model.check {
  authority execute;
  request {
    model: ModelHandle required;
    target: Target required;
    context_policy: ContextPolicy optional;
  };
  response VerificationResult;
  verdict SemanticVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted, InsufficientEvidence];
}

/// Explore model behavior under a strategy and budget; returns
/// explored-region evidence rather than a claim verdict.
@mutation @task_starting
operation model.explore {
  authority execute;
  request {
    model: ModelHandle required;
    strategy: ExplorationStrategy required;
  };
  response {
    task: TaskHandle optional;
    evidence: list<EvidenceHandle> required;
    causal_graph: CausalGraphHandle optional;
  };
  verdict EvaluationVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted];
}

@open
enum ExplorationStrategy {
  dpor,
  observer_indexed_dpor,
  random_schedules,
  symbolic_bounded,
  unfolding,
}

/// Compare two models or configurations; returns a semantic diff
/// artifact.
@readonly @task_starting
operation model.compare {
  authority execute;
  request {
    before: ModelHandle required;
    after: ModelHandle required;
    layers: list<DiffLayer> required;
  };
  response {
    diff: DiffHandle required;
    summary: Opaque required;
  };
  verdict PolicyVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted];
}

// --- program ---------------------------------------------------------

/// Extract the semantic model from a Rust crate snapshot and its
/// annotations (plan §7).
@mutation @task_starting
operation program.extract {
  authority execute;
  request {
    /// Crate roots within the snapshot; empty means the whole snapshot.
    roots: list<String> required;
  };
  response {
    model: ModelHandle required;
    /// Generated correspondence between source and model (plan §16).
    correspondence: list<Commitment> required;
    diagnostics: list<Diagnostic> required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, AmbiguousCorrespondence, BudgetExhausted];
}

/// Run the program under controlled semantics; returns execution
/// artifacts, not console text.
@mutation @task_starting
operation program.run {
  authority execute;
  request {
    entry: String required;
    /// Controlled-effects configuration (RFC 0002 domain packs).
    configuration: Opaque optional;
  };
  response {
    task: TaskHandle optional;
    causal_graph: CausalGraphHandle optional;
    crashpack: CrashpackHandle optional;
  };
  verdict EvaluationVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted, UntrustedDomainBoundary];
}

/// Replay a recorded execution deterministically. Divergence fails with
/// `ReplayDiverged`; it is never reported as a fresh outcome.
@mutation @task_starting
operation program.replay {
  authority execute;
  request {
    recording: ArtifactHandle required;
  };
  response {
    causal_graph: CausalGraphHandle required;
    divergence: Opaque optional;
    /// Engine-defect report, present on divergence (plan §4.7,
    /// `rule errors.defect_emission`).
    defect: DefectHandle optional;
  };
  verdict EvaluationVerdictValue;
  errors [ReplayDiverged, BudgetExhausted, EpochUnsupported];
}

// --- refinement ------------------------------------------------------

/// Check a refinement correspondence between program and model
/// (plan §9, RFC 0009).
@mutation @task_starting
operation refinement.check {
  authority execute;
  request {
    program: ModelHandle required;
    model: ModelHandle required;
    /// Observer projection to check under (RFC 0014).
    observer: String optional;
  };
  response VerificationResult;
  verdict SemanticVerdictValue;
  errors [UnsupportedSemanticFeature, AmbiguousCorrespondence, BudgetExhausted];
}

/// Explain a refinement result or failure with a Context Pack.
@readonly
operation refinement.explain {
  authority execute;
  request {
    result: EvidenceHandle required;
    audience: Audience optional;
  };
  response {
    context: ContextHandle required;
  };
  errors [UnsupportedSemanticFeature, InsufficientEvidence];
}

// --- proof -----------------------------------------------------------

/// Return the exact goal, its proof Context Pack, and a proof-state
/// handle. Agents operate on goals, never on cursor positions.
@readonly
operation proof.goal {
  authority execute;
  request {
    obligation: String required;
  };
  response {
    proof_state: ProofStateHandle required;
    goal: Opaque required;
    context: ContextHandle required;
  };
  errors [UnsupportedSemanticFeature, InsufficientEvidence];
}

/// Apply a tactic or term to a proof state; returns child states and
/// typed diagnostics.
@mutation @task_starting
operation proof.attempt {
  authority execute;
  request {
    proof_state: ProofStateHandle required;
    /// Tactic script or term, treated strictly as data.
    step: String required;
  };
  response {
    children: list<ProofStateHandle> required;
    diagnostics: list<Diagnostic> required;
    closed: Bool required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted, CertificateRejected];
}

/// Strict isolated kernel check of a proof candidate, returning a
/// receipt (RFC 0024, RFC 0035).
@mutation @task_starting
operation proof.check {
  authority execute;
  request {
    candidate: ProofArtifactHandle required;
  };
  response {
    receipt: ReceiptHandle required;
    /// The proof receipt (`schemas/proof-receipt.schema.json`).
    proof_receipt: Opaque required;
  };
  verdict SemanticVerdictValue;
  errors [CertificateRejected, BudgetExhausted, EpochUnsupported];
}

/// Return the proof dependency slice — the curated declarations a goal
/// depends on.
@readonly @paginated
operation proof.slice {
  authority execute;
  request {
    proof_state: ProofStateHandle required;
  };
  response {
    declarations: list<String> required;
    axioms: list<String> required;
  };
  errors [UnsupportedSemanticFeature];
}

// --- correspondence --------------------------------------------------

/// Create or update a plan §16 correspondence link between source and
/// semantic elements.
@mutation
operation correspondence.bind {
  authority propose;
  request {
    source: SourceSpan required;
    element: String required;
  };
  response {
    correspondence: Commitment required;
  };
  verdict StructuralVerdictValue;
  errors [AmbiguousCorrespondence, UnsupportedSemanticFeature];
}

/// Report correspondence coverage and ambiguity for a snapshot.
@readonly
operation correspondence.status {
  authority read;
  request {
    element: String optional;
  };
  response {
    bound: U64 required;
    unbound: U64 required;
    ambiguous: U64 required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Report correspondence drift between two snapshots.
@readonly
operation correspondence.drift {
  authority read;
  request {
    before: WorkspaceHandle required;
    after: WorkspaceHandle required;
  };
  response {
    drifted: list<String> required;
    diff: DiffHandle optional;
  };
  errors [UnsupportedSemanticFeature, AmbiguousCorrespondence];
}

// --- debug (RFC 0029) ------------------------------------------------

/// Open a causal debugger branch on a crashpack or execution.
@mutation
operation debug.open {
  authority execute;
  request {
    subject: ArtifactHandle required;
    observer: String optional;
  };
  response {
    branch: DebugHandle required;
    frontier: Opaque required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, EpochUnsupported];
}

/// Return the concrete or abstract state view at the branch frontier.
@readonly
operation debug.state {
  authority execute;
  request {
    branch: DebugHandle required;
    observer: String optional;
  };
  response {
    state: Opaque required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Return the events enabled at the current frontier.
@readonly @paginated
operation debug.enabled {
  authority execute;
  request {
    branch: DebugHandle required;
  };
  response {
    events: list<String> required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Step one semantic event, returning a new branch handle.
@mutation
operation debug.step_event {
  authority execute;
  request {
    branch: DebugHandle required;
    event: String required;
  };
  response {
    branch: DebugHandle required;
    delta: Opaque required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature];
}

/// Step one abstract transition, returning a new branch handle.
@mutation
operation debug.step_abstract {
  authority execute;
  request {
    branch: DebugHandle required;
  };
  response {
    branch: DebugHandle required;
    delta: Opaque required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature];
}

/// Move to the causal predecessor of the current frontier.
@mutation
operation debug.reverse_causal {
  authority execute;
  request {
    branch: DebugHandle required;
  };
  response {
    branch: DebugHandle required;
    delta: Opaque required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature];
}

/// Branch on an alternate enabled event or injected fault.
@mutation
operation debug.branch {
  authority execute;
  request {
    branch: DebugHandle required;
    alternate: String required;
  };
  response {
    branch: DebugHandle required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature];
}

/// Compare two debugger branches under an observer projection.
@readonly
operation debug.compare {
  authority execute;
  request {
    left: DebugHandle required;
    right: DebugHandle required;
    observer: String optional;
  };
  response {
    diff: DiffHandle required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Explain why an event is enabled at the frontier.
@readonly
operation debug.why_enabled {
  authority execute;
  request {
    branch: DebugHandle required;
    event: String required;
  };
  response {
    context: ContextHandle required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Explain why an event is blocked at the frontier.
@readonly
operation debug.why_blocked {
  authority execute;
  request {
    branch: DebugHandle required;
    event: String required;
  };
  response {
    context: ContextHandle required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Export a branch as a crashpack or regression scenario.
@mutation
operation debug.export {
  authority execute;
  request {
    branch: DebugHandle required;
    as_regression: Bool optional;
  };
  response {
    crashpack: CrashpackHandle required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, PublicationAborted];
}

// --- context (RFC 0028) ----------------------------------------------

/// Compile a bounded, typed, property-directed Context Pack from an
/// evidence root and a question.
@mutation @task_starting
operation context.compile {
  authority read;
  request {
    evidence_root: ArtifactHandle required;
    question: String required;
    audience: Audience optional;
    /// Required guarantees; the pack declares which it achieved.
    guarantees: list<String> optional;
  };
  response {
    context: ContextHandle required;
    /// The pack (`schemas/context-pack.schema.json`).
    pack: Opaque required;
  };
  verdict EvaluationVerdictValue;
  errors [UnsupportedSemanticFeature, InsufficientEvidence, BudgetExhausted];
}

/// Expand a Context Pack along a relation, returning a new immutable
/// pack that references its parent. Everything beyond the default result
/// is reachable by expansion, never by dumping (RFC 0027).
@mutation @task_starting
operation context.expand {
  authority read;
  request {
    context: ContextHandle required;
    anchor: String required;
    relation: ExpansionRelation required;
    depth: U32 optional;
  };
  response {
    context: ContextHandle required;
    parent: ContextHandle required;
    pack: Opaque required;
  };
  errors [UnsupportedSemanticFeature, BudgetExhausted];
}

// --- failure (RFC 0039) ----------------------------------------------

/// Return a causal explanation of a failure at the requested level.
@readonly @task_starting
operation failure.explain {
  authority execute;
  request {
    failure: CrashpackHandle required;
    level: ExplanationLevel required;
    audience: Audience optional;
  };
  response {
    context: ContextHandle required;
  };
  errors [UnsupportedSemanticFeature, InsufficientEvidence, BudgetExhausted];
}

/// Explanation types of RFC 0039 ("Explanation types"), normative here.
@open
enum ExplanationLevel {
  trace,
  causal,
  contrastive,
  logical,
  correction,
  instrumentation,
  assurance,
}

/// Return a minimized counterexample that preserves the failure, with
/// its declared minimality class.
@mutation @task_starting
operation failure.minimize {
  authority execute;
  request {
    failure: CrashpackHandle required;
    /// Minimality class to target
    /// (`schemas/context-pack.schema.json` guarantees).
    guarantee: String optional;
  };
  response {
    crashpack: CrashpackHandle required;
    guarantees: list<String> required;
  };
  verdict EvaluationVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted];
}

/// Explore an alternate branch from a failure's causal frontier.
@mutation @task_starting
operation failure.branch {
  authority execute;
  request {
    failure: CrashpackHandle required;
    alternate: String required;
  };
  response {
    branch: DebugHandle required;
    context: ContextHandle optional;
  };
  verdict EvaluationVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted];
}

// --- repair (RFC 0032) -----------------------------------------------

/// Open a repair transaction against a failure
/// (`schemas/repair-transaction.schema.json`).
@mutation
operation repair.begin {
  authority propose;
  request {
    failure: CrashpackHandle required;
    gate_profile: GateProfile required;
  };
  response {
    repair: RepairHandle required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, PolicyGateFailed];
}

enum GateProfile {
  phase_b = "phase-b",
  phase_c = "phase-c",
  phase_d = "phase-d",
  default,
}

/// Apply proposed changes and a hypothesis to a transaction, producing a
/// new transaction version and a candidate snapshot.
@mutation
operation repair.apply {
  authority propose;
  request {
    repair: RepairHandle required;
    /// Typed changes: rust, model, proof, correspondence, domain,
    /// intent.
    changes: Opaque required;
    hypothesis: String required;
  };
  response {
    repair: RepairHandle required;
    candidate_snapshot: WorkspaceHandle required;
  };
  verdict StructuralVerdictValue;
  errors [IntentMutationDenied, UnsupportedSemanticFeature];
}

/// Attach additional evidence or artifacts — for example from another
/// agent — producing a new transaction version.
@mutation
operation repair.attach {
  authority propose;
  request {
    repair: RepairHandle required;
    artifacts: list<ArtifactHandle> required;
  };
  response {
    repair: RepairHandle required;
  };
  verdict StructuralVerdictValue;
  errors [InsufficientEvidence, StatusConflict];
}

/// Evaluate a transaction against its gate profile under a budget.
@mutation @task_starting
operation repair.evaluate {
  authority execute;
  request {
    repair: RepairHandle required;
  };
  response {
    task: TaskHandle optional;
    repair: RepairHandle required;
    gates: list<GateOutcome> required;
    continuation: ContinuationHandle optional;
  };
  verdict PolicyVerdictValue;
  errors [BudgetExhausted, InsufficientEvidence, PolicyGateFailed];
}

/// Resume a suspended evaluation from its continuation. Inputs and
/// epochs are validated (`rule task.resume`).
@mutation @task_starting
operation repair.resume {
  authority execute;
  request {
    continuation: ContinuationHandle required;
    budget: Budget optional;
  };
  response {
    task: TaskHandle optional;
    repair: RepairHandle required;
    gates: list<GateOutcome> required;
  };
  verdict PolicyVerdictValue;
  errors [StaleSnapshot, ContinuationEpochMismatch, BudgetExhausted,
          EpochUnsupported];
}

/// Return the reviewer projection of a transaction: semantic and intent
/// diff, gate status, evidence. The review decision it records enters
/// the evidence graph as an audit-recorded append attributed to the
/// named reviewer (RFC 0027), not through agent evidence-write
/// authority.
@readonly
operation repair.review {
  authority read;
  request {
    repair: RepairHandle required;
  };
  response {
    repair: RepairHandle required;
    semantic_diff: DiffHandle nullable;
    gates: list<GateOutcome> required;
    evidence: list<EvidenceHandle> required;
  };
  verdict PolicyVerdictValue;
  errors [InsufficientEvidence];
}

/// Promote a transaction. A service decision gated by RFC 0032, never an
/// agent assertion (INV-015). Returns a receipt or a typed policy
/// failure.
@mutation @privileged @audit_recorded
operation repair.promote {
  authority promote;
  request {
    repair: RepairHandle required;
  };
  response {
    receipt: ReceiptHandle required;
    /// The promotion receipt
    /// (`schemas/promotion-receipt.schema.json`).
    promotion_receipt: Opaque required;
  };
  verdict PolicyVerdictValue;
  errors [PolicyGateFailed, InsufficientEvidence, StatusConflict,
          PublicationAborted, CertificateRejected];
}

/// Reject a transaction with a typed reason.
@mutation @privileged @audit_recorded
operation repair.reject {
  authority promote;
  request {
    repair: RepairHandle required;
    reason: String required;
  };
  response {
    repair: RepairHandle required;
  };
  verdict StructuralVerdictValue;
  errors [StatusConflict];
}

// --- observe (plan §18.2, §18.4) -------------------------------------
//
// Registered ahead of its producing subsystem: until the Phase C
// read-only observation lane ships, these operations MAY fail with
// `UnsupportedSemanticFeature` (`rule errors.unsupported_surface`).

/// Ingest a production trace. Additionally requires the production-trace
/// capability (plan §18.2); capture-time contract in plan §18.4.
@mutation @task_starting @audit_recorded
operation observe.ingest {
  authority execute;
  request {
    /// Trace bundle content identity.
    trace: Commitment required;
    /// Instrumentation profile the trace was captured under.
    instrumentation_profile: String required;
  };
  response {
    task: TaskHandle optional;
    evidence: list<EvidenceHandle> required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, UntrustedDomainBoundary,
          InsufficientEvidence];
}

/// Classify an ingested trace against the model's partial order.
@readonly
operation observe.classify {
  authority read;
  request {
    evidence: EvidenceHandle required;
  };
  response {
    classification: Opaque required;
  };
  errors [UnsupportedSemanticFeature, InsufficientEvidence];
}

/// Return the conformance result for an ingested trace.
@readonly
operation observe.result {
  authority read;
  request {
    evidence: EvidenceHandle required;
  };
  response VerificationResult;
  verdict SemanticVerdictValue;
  errors [UnsupportedSemanticFeature, InsufficientEvidence];
}

// --- forge (RFC 0033) ------------------------------------------------

/// Create a synthesis archive from a sketch, holes, objectives,
/// diversity descriptors, and an assurance target.
@mutation @task_starting
operation forge.create {
  authority execute;
  request {
    sketch: Opaque required;
    objectives: list<String> required;
    diversity_descriptors: list<String> optional;
    assurance_target: AssuranceClass required;
  };
  response {
    forge: ForgeHandle required;
    task: TaskHandle optional;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted];
}

/// Run one bounded portfolio iteration; returns archive deltas and
/// counterexamples.
@mutation @task_starting
operation forge.step {
  authority execute;
  request {
    forge: ForgeHandle required;
    iterations: U32 optional;
  };
  response {
    forge: ForgeHandle required;
    candidates: list<EvidenceHandle> required;
    counterexamples: list<CrashpackHandle> required;
  };
  verdict EvaluationVerdictValue;
  errors [BudgetExhausted, UnsupportedSemanticFeature];
}

/// Query the Pareto / quality-diversity archive by objective,
/// descriptor, or evidence status.
@readonly @paginated
operation forge.archive {
  authority execute;
  request {
    forge: ForgeHandle required;
    statuses: list<EvidenceStatus> optional;
    descriptors: list<String> optional;
  };
  response {
    candidates: list<EvidenceHandle> required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Materialize a candidate into a design transaction carrying model,
/// Rust, and proof artifacts.
@mutation
operation forge.materialize {
  authority execute;
  request {
    forge: ForgeHandle required;
    candidate: EvidenceHandle required;
  };
  response {
    repair: RepairHandle required;
    snapshot: WorkspaceHandle required;
  };
  verdict StructuralVerdictValue;
  errors [UnsupportedSemanticFeature, InsufficientEvidence];
}

// --- benchmark (RFC 0034) --------------------------------------------

/// Run a benchmark task under a declared budget and its graders.
/// Returns evidence; a benchmark never self-scores.
@mutation @task_starting
operation benchmark.run {
  authority execute;
  request {
    /// Benchmark task (`schemas/benchmark-task.schema.json`).
    task_id: String required;
    /// Grader identities to apply; the daemon MUST reject any grader
    /// not registered for the task.
    graders: list<String> required;
  };
  response {
    task: TaskHandle optional;
    evidence: list<EvidenceHandle> required;
  };
  verdict EvaluationVerdictValue;
  errors [UnsupportedSemanticFeature, BudgetExhausted, PolicyGateFailed];
}

// --- task ------------------------------------------------------------

/// Return the task record: semantic milestones, resource use, committed
/// evidence, and terminal reason.
@readonly
operation task.status {
  authority read;
  request {
    task: TaskHandle required;
  };
  response TaskRecord;
  errors [];
}

/// Request cancel-correct shutdown (`rule task.cancel_correct`).
@mutation
operation task.cancel {
  authority execute;
  request {
    task: TaskHandle required;
  };
  response {
    task: TaskHandle required;
    status: TaskStatus required;
    continuation: ContinuationHandle nullable;
    committed_evidence: list<EvidenceHandle> required;
  };
  verdict StructuralVerdictValue;
  errors [PublicationAborted];
}

/// Resume a task from its continuation, optionally with a larger budget
/// (`rule task.resume`).
@mutation @task_starting
operation task.resume {
  authority execute;
  request {
    continuation: ContinuationHandle required;
    budget: Budget optional;
  };
  response {
    task: TaskHandle required;
    status: TaskStatus required;
  };
  errors [StaleSnapshot, ContinuationEpochMismatch, EpochUnsupported,
          BudgetExhausted];
}

/// Stream progress events for a task on this connection. Events are
/// hints (`rule subscription.hints_only`).
@readonly @streaming
operation task.subscribe {
  authority read;
  request {
    task: TaskHandle required;
  };
  response {
    /// Snapshot of the record at subscription time; events follow.
    record: TaskRecord required;
  };
  events TaskEvent;
  errors [];
}

/// Adjust the budget of a running task (`rule task.update_budget`).
@mutation
operation task.update_budget {
  authority execute;
  request {
    task: TaskHandle required;
    budget: Budget required;
  };
  response {
    task: TaskHandle required;
    status: TaskStatus required;
    budget: Budget required;
    /// Present when lowering the budget suspended the task.
    continuation: ContinuationHandle optional;
  };
  verdict StructuralVerdictValue;
  errors [BudgetExhausted, QuotaExhausted];
}

// --- evidence (RFC 0038) ---------------------------------------------

/// Fetch typed artifact metadata or bounded content. Content the daemon
/// has redacted is returned as a typed `Redacted` stub, never as a
/// missing field (plan §4.5).
@readonly
operation evidence.get {
  authority read;
  request {
    evidence: EvidenceHandle required;
    /// Include bounded inline content, subject to `output_policy`.
    inline: Bool optional;
  };
  response {
    node: Opaque nullable;
    edge: Opaque nullable;
    redacted: Redacted optional;
  };
  errors [EpochUnsupported];
}

/// Query the evidence graph by node, edge, status, and property filters.
@readonly @paginated
operation evidence.query {
  authority read;
  request {
    query: EvidenceQuery required;
  };
  response {
    nodes: list<EvidenceHandle> required;
    edges: list<EvidenceHandle> required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Run the relevant independent checker over an evidence node. The
/// daemon MUST NOT accept a client-declared status: status is what the
/// checker establishes, and promotion into `validated` or `proved` is
/// service-restricted (RFC 0038).
@mutation @task_starting
operation evidence.verify {
  authority read;
  request {
    evidence: EvidenceHandle required;
    /// The status the caller expects the claim to currently hold. The
    /// promotion is a compare-and-set against it; a lost CAS returns
    /// `StatusConflict`.
    expected_status: EvidenceStatus optional;
  };
  response {
    evidence: EvidenceHandle required;
    status: EvidenceStatus required;
    /// The class of evidence the checker validated.
    evidence_kind: EvidenceKind required;
    /// The checker's service identity (INV-004).
    checker: String required;
    /// `checked-certificate` or `trusted-solver`.
    validation_basis: String required;
    /// Present when content the verified receipt references is redacted
    /// (plan §4.5, SD-09): the structural result and the redaction are
    /// returned together, never one in place of the other.
    redacted: Redacted optional;
  };
  verdict SemanticVerdictValue;
  errors [StatusConflict, CertificateRejected, InsufficientEvidence,
          EpochUnsupported];
}

/// Stream committed evidence-graph deltas for a declared scope. Distinct
/// from `task.subscribe`: deltas reference committed artifacts
/// (`rule subscription.hints_only`). What an `EvidenceEvent` frame is,
/// which deltas a scope selects, and why one delta is one frame however
/// many scopes select it, are `rule subscription.delivery`.
@readonly @streaming
operation evidence.subscribe {
  authority read;
  request {
    scope: EvidenceQuery required;
  };
  response {
    /// The scope's current frontier at subscription time.
    frontier: list<EvidenceHandle> required;
  };
  events EvidenceEvent;
  errors [UnsupportedSemanticFeature];
}

/// Record that an independent checker checked an evidence node: append the
/// `receipt` node for the check and the `CHECKED_BY` edge naming it, as one
/// write. The only operation that appends an evidence-graph edge.
///
/// The `checker` is **not** a request field. It is the admitted
/// capability's actor, which MUST be a `service:` actor, so an `agent:`,
/// `human:`, or `ci:` capability cannot append a check edge at all
/// (`CapabilityDenied`), and no caller can name someone else as the
/// checker. A checker that is the subject node's own `provenance.actor` is
/// refused with `InsufficientEvidence`: that is INV-004's
/// no-self-certification rule at the edge, and it is decided before the
/// receipt content is read.
///
/// This operation writes **no status**. An edge is evidence that a check
/// ran; what that licenses is `evidence.verify`'s separate decision under
/// RFC 0038's compare-and-set (RFC 0038 "Authority", D1–D3).
@mutation @audit_recorded
@since("3.3")
operation evidence.link {
  authority execute;
  request {
    /// The evidence node the check was performed over — the edge's `from`.
    subject: EvidenceHandle required;
    /// Content identity of the proof receipt the checker produced (RFC
    /// 0024). The daemon MUST already hold it; the `receipt` node this
    /// operation appends is the edge's `to` (RFC 0038 D1).
    receipt: Commitment required;
    /// The checker's tool identity, recorded as the receipt node's
    /// `provenance.tool` and inside its identity, so one receipt checked
    /// under two checker versions is two nodes.
    checker_profile: String required;
  };
  response {
    /// The `CHECKED_BY` edge, named under `rule evidence.edge_identity`.
    edge: EvidenceHandle required;
    /// The `receipt` node the edge points at.
    receipt: EvidenceHandle required;
    /// The checker's service identity (INV-004), from the admitted
    /// capability and never from the request.
    checker: String required;
  };
  verdict StructuralVerdictValue;
  errors [InsufficientEvidence];
}

// --- whiteboard (RFC 0038, plan §11.5) -------------------------------

/// Compile a structured whiteboard note into typed graph proposals: one
/// proposed node per claim line, one `SUPPORTS` edge per artifact a
/// decision cites, and one task proposal per experiment (plan §11.5,
/// docs/44 "Whiteboard", RFC 0038 W1–W9). The semantics are
/// `rule whiteboard.compilation`.
///
/// The note crosses as an `Opaque` governed by
/// `schemas/whiteboard-note.schema.json` and is validated against it
/// before any member is read (INV-016). Its `author` MUST be the
/// admitted capability's actor; there is no other way for the daemon to
/// write a truthful `provenance.actor` without either trusting a
/// request field or rewriting the caller's document.
///
/// Everything a note proposes lands at `proposed`. The note format has
/// **no status member** (RFC 0038 W5), this operation mints no
/// promotion, and it cannot reach the compare-and-set — so a whiteboard
/// is where an agent works and the graph is what it may claim, and this
/// is the one-way door between them. Compilation is a function of the
/// note and the graph: the note supplies its own `created_at`, so the
/// daemon reads no clock (INV-005).
///
/// Refusal is whole-note. A reference the graph cannot resolve is
/// `CapabilityDenied` and never a distinguishable not-found (RFC 0027
/// X2); a note that is not a conforming note is `MalformedRequest`; a
/// decision whose only support would be the decision itself is
/// `InsufficientEvidence`, which is `evidence.link`'s self-edge refusal
/// over the same graph.
@mutation
@since("3.5")
operation whiteboard.compile {
  authority propose;
  request {
    /// The note, in the form of `schemas/whiteboard-note.schema.json`.
    note: Opaque required;
  };
  response {
    /// The proposed nodes, in the note's own section and line order.
    nodes: list<EvidenceHandle> required;
    /// The `SUPPORTS` edges the note's decisions drew (RFC 0038 W6).
    edges: list<EvidenceHandle> required;
    /// One entry per `Experiment` line (RFC 0038 W3). Present and empty
    /// when the note had none: an absent list and an empty list would be
    /// two spellings of one answer.
    tasks: list<WhiteboardTaskProposal> required;
  };
  verdict StructuralVerdictValue;
  errors [InsufficientEvidence];
}

// --- query (RFC 0030) ------------------------------------------------

/// Explain which memoized results were reused for a derivation, and why.
@readonly @paginated
operation query.explain_reuse {
  authority read;
  request {
    derivation: ArtifactHandle required;
  };
  response {
    reused: list<ArtifactHandle> required;
    recomputed: list<ArtifactHandle> required;
    reasons: map<String, String> required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Explain which results a change invalidated, and through which
/// dependency edges.
@readonly @paginated
operation query.explain_invalidation {
  authority read;
  request {
    diff: DiffHandle required;
  };
  response {
    invalidated: list<ArtifactHandle> required;
    unknown: list<ArtifactHandle> required;
    edges: list<String> required;
  };
  errors [UnsupportedSemanticFeature];
}

/// Compare incremental results against a clean recompute — the
/// Incremental Parity Audit (plan §9.5). A mismatch is a defect report,
/// never a silently preferred result.
@mutation @task_starting
operation query.clean_compare {
  authority read;
  request {
    derivation: ArtifactHandle required;
  };
  response {
    parity: Bool required;
    /// Engine-defect report, present when parity fails (plan §4.7).
    defect: DefectHandle optional;
  };
  verdict EvaluationVerdictValue;
  errors [BudgetExhausted, UnsupportedSemanticFeature];
}


// ---------------------------------------------------------------------
// 11. Conformance
// ---------------------------------------------------------------------

rule conformance.golden_traces {
  """
  A conforming implementation MUST ship golden request/result traces
  pinned per protocol version, in both encodings, covering: every
  operation declared here; every error code; idempotency replay
  (identical and conflicting); restart and resume with matching and
  mismatched epochs; cancellation at every instrumented phase;
  deterministic pagination across page boundaries; and an unsupported
  empty task whose result still names every epoch.
  """
}

rule conformance.adapter_parity {
  """
  The same operation invoked through the CLI, MCP, LSP, DAP, or any other
  adapter MUST yield identical artifacts and identical typed results.
  Adapters translate; they do not decide (ADR-0042). An adapter MUST NOT
  expose an operation this file does not declare.
  """
}

rule conformance.adapter_mapping {
  """
  An adapter that renames an operation MUST ship a mapping manifest
  generated from this file, and that manifest is a generated artifact
  under `rule conformance.generated_artifacts`: regenerated, never
  hand-edited. It MUST be total over the names the adapter exposes — a
  name whose mapping target is not an `OperationName` declared here is
  the violation (RFC 0026 correction 23) — and deterministically ordered
  lexicographically by `OperationName`, so two listings under the same
  protocol version, mapping, and capability are byte-identical (RFC 0027
  TS-3). Without the manifest, totality, determinism, and the absence of
  an undeclared surface are three claims no check can make.
  """
}

rule conformance.registry_agreement {
  """
  The operation set declared here MUST equal the plan §10.2 registry
  exactly, and each operation's `authority` clause MUST equal the RFC
  0027 registry-table entry for it. A generator or validator MUST fail
  closed on any disagreement rather than preferring either source.
  """
}

rule conformance.generated_artifacts {
  """
  Generated Rust and TypeScript clients and generated JSON Schema are
  derived artifacts of this file and MUST be regenerated, never
  hand-edited. Where a generated schema and a schema in `schemas/`
  describe the same artifact class, the two MUST agree member-for-member;
  disagreement is a defect in this file or in that schema, resolved
  before release, never by divergence.
  """
}


// ---------------------------------------------------------------------
// 12. Open items
//
// Recorded here so the gaps are visible in the normative artifact rather
// than only in review notes. Each MUST be closed before PR 5 freezes the
// interface; a resolved item keeps its entry, with its resolution, so
// the history stays visible.
//
//   1. Capability administration — resolved by RFC 0026, "Capability
//      administration" (correction 20). Capabilities are minted, scoped,
//      delegated, and revoked through an out-of-band administrative
//      surface at protocol major 3, not through the plan §10.2 registry
//      this file implements exactly: no operation in this protocol may
//      widen the authority of the connection invoking it (INV-015). The
//      audit, descriptor, revocation, and delegation obligations hold
//      wherever that surface lives, and `CapabilityDescriptor` fixes
//      what it manipulates. Bringing it into the protocol at a future
//      major requires plan §10.2 entries, RFC 0027 authority rows, and
//      declarations here, together and in one change.
//   2. Delegation depth and expiry defaults for multi-agent handoff —
//      resolved by RFC 0026, "Delegation and expiry defaults"
//      (correction 21), in the fail-closed direction:
//      `delegation_depth` defaults to `0`; a delegated capability never
//      exceeds its parent in level, scope, expiry, or depth, and
//      revoking a parent revokes its delegation subtree;
//      `expires_at: null` means non-expiring and is confined to a shared
//      trust domain — in remote mode a mint naming no expiry is
//      rejected rather than defaulted. What remains open is the numeric
//      expiry a deployment chooses, which is deployment policy and not
//      protocol.
//   3. `Opaque` fields name their governing schema in prose. The SD-08
//      `$id`/schema-epoch convention is now paid (`schemas/README.md`):
//      every artifact instance carries a `schema_id`/`schema_epoch`
//      header, and every class identity a doc comment cites is a
//      resolvable URI. What remains is declaring the reference here
//      rather than in prose — an `@schema("<class identity>")`
//      annotation on the carrying field, checkable against `schemas/` by
//      the generator. Three groups must be separated first: fields whose
//      payload is a schema in `schemas/` (`changes`, `summary`,
//      `contract`, `record`, `pack`, `node`, `edge`, the receipts) take
//      the annotation as written; fields whose payload is a struct
//      declared in this file (`arguments`, `payload`,
//      `NextOperation.arguments`) name that struct, not a URI, and
//      SHOULD stop being `Opaque` once the generator can express it; and
//      fields that name neither today (`frontier`, `delta`, `state`,
//      `classification`) have no declared shape at all, which is the gap
//      this item is really tracking.
//
//      **Partly resolved at 3.2 (IDL 1.3).** The second group is
//      resolved *behaviourally* by `rule encoding.opaque_payloads`: the
//      envelope's `arguments` and `payload`, and
//      `NextOperation.arguments`, resolve to the request and response
//      structs of the operation the carrying object's own `operation`
//      field names, so a reader decodes them from the message alone. The
//      declaration half of the item stands — they are still spelled
//      `Opaque` here — because narrowing them to a per-operation type is
//      a grammar change (a field whose type varies with a sibling
//      field's value), not an additive one, and that is the same class
//      of change as RFC 0026 F1's `@required_when`.
//
//      One correction to this item's own text: `Error.data` was listed
//      in the second group, and it does not belong there. No struct is
//      declared in this file for any error code's specifics, and no
//      schema in `schemas/` governs them, so `data` belongs with the
//      third group — shapeless — and `rule encoding.opaque_payloads`
//      requires a daemon with no typed specifics to leave it absent
//      rather than invent a shape. RFC 0026 F11 (a typed retry-after for
//      the two retryable codes) is the first concrete proposal for what
//      it would carry.
// ---------------------------------------------------------------------
