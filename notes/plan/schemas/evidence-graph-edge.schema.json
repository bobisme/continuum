{
  "$id": "https://continuum.dev/schema/v1/evidence-graph-edge.json",
  "schema_epoch": 1,
  "schema_kind": "artifact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "description": "A CHECKED_BY edge names the trusted checker/service that performed the check (plan §11.3).",
      "if": {
        "properties": {
          "kind": {
            "const": "CHECKED_BY"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "checker"
        ]
      }
    }
  ],
  "properties": {
    "checker": {
      "description": "Trusted checker/service the edge names when applicable (plan §11.3).",
      "minLength": 1,
      "type": "string"
    },
    "edge_id": {
      "pattern": "^ev_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "evidence": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "from": {
      "pattern": "^ev_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "kind": {
      "description": "The 13 edge types of plan §11.3.",
      "enum": [
        "SUPPORTS",
        "REFUTES",
        "DEPENDS_ON",
        "REFINES",
        "EXPLAINS",
        "REPAIRS",
        "INVALIDATES",
        "GENERALIZES",
        "COUNTEREXAMPLE_TO",
        "CHECKED_BY",
        "DERIVED_FROM",
        "CONFLICTS_WITH",
        "SUPERSEDES"
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "inputs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "actor",
        "created_at",
        "inputs"
      ],
      "type": "object"
    },
    "schema_id": {
      "const": "https://continuum.dev/schema/evidence-graph-edge.json",
      "description": "Artifact-class identity of the governing schema: its `$id` with the `v<schema_epoch>/` segment removed (schemas/README.md). Stable across schema epochs."
    },
    "schema_epoch": {
      "const": 1,
      "description": "Schema epoch this instance was written against (schemas/README.md). It advances only on a breaking change to this artifact class, is not one of the six independently versioned epochs (RFC 0026 `rule versioning.epoch_independence`), and pins no semantics."
    },
    "to": {
      "pattern": "^ev_[A-Za-z0-9_-]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "schema_epoch",
    "edge_id",
    "kind",
    "from",
    "to",
    "provenance"
  ],
  "title": "Evidence Graph Edge",
  "type": "object"
}
