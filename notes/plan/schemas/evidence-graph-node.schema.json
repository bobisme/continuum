{
  "$id": "https://continuum.dev/schema/evidence-graph-node.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "redacted": {
      "$comment": "mirrored from redacted.schema.json; identity-checked by the validator",
      "additionalProperties": false,
      "description": "Typed Redacted(reason, commitment) stub (plan §4.5). Mirrors redacted.schema.json; inlined to keep this file self-contained.",
      "properties": {
        "commitment": {
          "description": "Content commitment (hash) of the redacted original.",
          "type": "string"
        },
        "original_class": {
          "description": "Artifact class of the redacted original (plan §4.4 prefix, e.g. crash, ctx, proof).",
          "type": "string"
        },
        "reason": {
          "enum": [
            "summarized",
            "lost",
            "purged"
          ]
        },
        "redacted": {
          "const": true
        }
      },
      "required": [
        "redacted",
        "reason",
        "commitment",
        "original_class"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "description": "INV-008: inconclusive is never untyped (plan §11.4).",
      "if": {
        "properties": {
          "status": {
            "const": "inconclusive"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "inconclusive_reason"
        ]
      }
    },
    {
      "description": "Validated records whether solver evidence is a checked certificate or a trusted solver; the two never render identically (plan §11.4).",
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "validation_basis"
        ]
      }
    },
    {
      "description": "Assurance-bearing status promotion is service-attributed: sampled, bounded, validated, and proved statuses name the daemon service identity that performed the promotion (plan §11.7 write model).",
      "if": {
        "properties": {
          "status": {
            "enum": [
              "sampled",
              "bounded",
              "validated",
              "proved"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "service_identity"
        ]
      }
    }
  ],
  "properties": {
    "artifact": {
      "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "claim_id": {
      "description": "Claim identity this node's status promotion is linearized against (plan §11.7 write model).",
      "type": "string"
    },
    "idempotency_key": {
      "description": "Idempotency key making agent retries safe (plan §11.7 write model).",
      "minLength": 1,
      "type": "string"
    },
    "inconclusive_reason": {
      "description": "Typed reason required by INV-008 when status is inconclusive (plan §11.4). Budget exhaustion is never a verdict.",
      "enum": [
        "Unsupported",
        "ResourceExhausted",
        "EngineError",
        "InsufficientTelemetry",
        "AbstractionAmbiguity",
        "IncompleteProofSearch"
      ]
    },
    "kind": {
      "description": "Node kinds mirror plan §11.2's 20 node types; `candidate` corresponds to §11.2 `SynthesisCandidate` (see synthesis-candidate.schema.json).",
      "enum": [
        "intent_claim",
        "assumption",
        "property",
        "model",
        "program",
        "proof_goal",
        "candidate",
        "invariant_candidate",
        "ranking_candidate",
        "abstraction_map",
        "counterexample",
        "explanation",
        "repair_hypothesis",
        "patch",
        "run",
        "certificate",
        "receipt",
        "benchmark_result",
        "conflict",
        "decision"
      ]
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "node_id": {
      "pattern": "^ev_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "parameterization": {
      "additionalProperties": false,
      "allOf": [
        {
          "description": "Fail-closed (plan §11.4): proved_universal carries no instance bound — n must be null.",
          "if": {
            "properties": {
              "kind": {
                "const": "proved_universal"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "n": {
                "type": "null"
              }
            }
          }
        },
        {
          "description": "Fail-closed (plan §11.4): checked and cutoff_checked carry a concrete integer instance bound.",
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "checked",
                  "cutoff_checked"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "n": {
                "type": "integer"
              }
            }
          }
        }
      ],
      "description": "Parameterized results are structurally distinct (plan §11.4): checked(N=k), cutoff_checked(N≤k), proved(∀N).",
      "properties": {
        "kind": {
          "enum": [
            "checked",
            "cutoff_checked",
            "proved_universal"
          ]
        },
        "n": {
          "description": "The instance bound k for checked/cutoff_checked; null for proved_universal.",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "n"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "inputs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*_[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "actor",
        "created_at",
        "inputs"
      ],
      "type": "object"
    },
    "redacted_references": {
      "description": "Redacted values referenced by this artifact (plan §4.5, §18.4).",
      "items": {
        "$ref": "#/$defs/redacted"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0"
    },
    "service_identity": {
      "description": "Daemon service identity that performed the assurance-bearing status promotion (plan §11.7); required for sampled/bounded/validated/proved.",
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "observed",
        "sampled",
        "bounded",
        "validated",
        "proved",
        "refuted",
        "inconclusive",
        "superseded"
      ]
    },
    "validation_basis": {
      "description": "For status=validated: whether solver evidence is a checked certificate or a trusted solver verdict (plan §11.4 CHECKED_CERTIFICATE/TRUSTED_SOLVER). The two never render identically.",
      "enum": [
        "checked-certificate",
        "trusted-solver"
      ]
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "artifact",
    "status",
    "provenance"
  ],
  "title": "Evidence Graph Node",
  "type": "object"
}
