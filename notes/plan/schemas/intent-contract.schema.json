{
  "$id": "https://continuum.dev/schema/intent-contract.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "policy_verb": {
      "enum": [
        "unlocked",
        "proposal-only",
        "review",
        "locked",
        "no-decrease",
        "no-removal",
        "no-downgrade",
        "no-expansion"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "classification": {
            "enum": [
              "environment",
              "scheduler",
              "timing",
              "storage",
              "network",
              "trust"
            ]
          },
          "expression": {
            "type": "string"
          },
          "fidelity_profile": {
            "description": "Declared domain-pack fidelity this assumption relies on (RFC 0002). Profiles are not automatically ordered.",
            "enum": [
              "ideal",
              "contractual",
              "platform-qualified",
              "adversarial-envelope"
            ]
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "expression"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "assurance": {
      "additionalProperties": false,
      "properties": {
        "clean_recompute": {
          "type": "boolean"
        },
        "independent_checker": {
          "type": "boolean"
        },
        "minimum": {
          "enum": [
            "observed",
            "sampled",
            "bounded",
            "validated",
            "proved"
          ]
        }
      },
      "required": [
        "minimum"
      ],
      "type": "object"
    },
    "bounds": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "faults": {
          "minimum": 0,
          "type": "integer"
        },
        "nodes": {
          "minimum": 1,
          "type": "integer"
        },
        "values": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "safety",
              "liveness",
              "refinement",
              "hyperproperty",
              "security",
              "performance"
            ]
          },
          "observer": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "expression"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "completion_policy": {
      "description": "Behavior-completion policy for terminal states (RFC 0015). No engine may silently change this.",
      "enum": [
        "stutter-forever",
        "deadlock-violation",
        "finite-trace-only",
        "closed"
      ]
    },
    "fairness": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "weak",
              "strong"
            ]
          }
        },
        "required": [
          "kind",
          "action"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fault_model": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "intent_id": {
      "pattern": "^in_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nondeterminism": {
      "description": "Typed choice classes per choice site. Probabilistic, timed, and epistemic classes are declarative until the ADR-0016 lanes ship (plan B11).",
      "items": {
        "additionalProperties": false,
        "properties": {
          "class": {
            "enum": [
              "demonic",
              "angelic",
              "scheduler",
              "probabilistic",
              "timed",
              "epistemic"
            ]
          },
          "site": {
            "type": "string"
          }
        },
        "required": [
          "site",
          "class"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "observers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "type": "string"
          },
          "knowledge_projection": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "security_projection": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "state_projection": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "events"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "optimization": {
      "additionalProperties": false,
      "properties": {
        "hard": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "non_vacuity": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "soft": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "$ref": "#/$defs/policy_verb"
        },
        "assurance": {
          "$ref": "#/$defs/policy_verb"
        },
        "bounds": {
          "$ref": "#/$defs/policy_verb"
        },
        "completion_policy": {
          "$ref": "#/$defs/policy_verb"
        },
        "fairness": {
          "$ref": "#/$defs/policy_verb"
        },
        "faults": {
          "$ref": "#/$defs/policy_verb"
        },
        "non_vacuity": {
          "$ref": "#/$defs/policy_verb"
        },
        "observers": {
          "$ref": "#/$defs/policy_verb"
        },
        "properties": {
          "$ref": "#/$defs/policy_verb"
        },
        "trust_boundaries": {
          "$ref": "#/$defs/policy_verb"
        }
      },
      "required": [
        "properties",
        "assumptions",
        "fairness",
        "bounds",
        "observers",
        "faults",
        "trust_boundaries",
        "non_vacuity",
        "completion_policy",
        "assurance"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "security_policy": {
      "additionalProperties": false,
      "description": "First-class security policy group (plan §5.2): data classification, redaction classes, and capability requirements.",
      "properties": {
        "capability_requirements": {
          "description": "Capabilities required to exercise the operations this intent governs (e.g. revise-intent).",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "redaction_classes": {
          "description": "Artifact classes subject to redaction/purge semantics (plan §4.5).",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "abstraction_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "components": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "fragments": {
          "description": "Declared semantic fragments (ADR-0025). Intent-diff guarantees apply within declared fragments; outside them classification is Unknown and fails closed (plan §5.3).",
          "items": {
            "enum": [
              "Finite",
              "Symbolic",
              "Temporal",
              "Probabilistic",
              "Theorem",
              "Runtime"
            ]
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "components",
        "fragments"
      ],
      "type": "object"
    },
    "trust_boundaries": {
      "additionalProperties": false,
      "properties": {
        "opaque": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "trusted": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "trusted",
        "opaque"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "intent_id",
    "claims",
    "assumptions",
    "observers",
    "scope",
    "trust_boundaries",
    "bounds",
    "fault_model",
    "fairness",
    "completion_policy",
    "assurance",
    "policy"
  ],
  "title": "Intent Contract",
  "type": "object"
}
