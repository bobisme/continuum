{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.dev/schema/v1/domain-pack.json",
  "schema_epoch": 1,
  "schema_kind": "artifact",
  "title": "Continuum Domain Pack Manifest",
  "type": "object",
  "required": [
    "schema_id",
    "schema_epoch",
    "pack",
    "operations",
    "profiles",
    "resources"
  ],
  "properties": {
    "schema_id": {
      "const": "https://continuum.dev/schema/domain-pack.json",
      "description": "Artifact-class identity of the governing schema: its `$id` with the `v<schema_epoch>/` segment removed (schemas/README.md). Stable across schema epochs."
    },
    "schema_epoch": {
      "const": 1,
      "description": "Schema epoch this instance was written against (schemas/README.md). It advances only on a breaking change to this artifact class, is not one of the six independently versioned epochs (RFC 0026 `rule versioning.epoch_independence`), and pins no semantics."
    },
    "pack": {
      "type": "object",
      "required": [
        "name",
        "semantic_version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "semantic_version": {
          "type": "string"
        },
        "implementation_version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path_schema"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path_schema": {
            "type": "string"
          },
          "ownership": {
            "enum": [
              "linear",
              "affine",
              "shared",
              "external"
            ]
          },
          "range_semantics": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command_type",
          "response_type",
          "effect_phases"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command_type": {
            "type": "string"
          },
          "response_type": {
            "type": "string"
          },
          "effect_phases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "footprint_rule": {
            "type": "string"
          },
          "cancellation_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observer_events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "assumptions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class": {
            "enum": [
              "ideal",
              "contractual",
              "platform-qualified",
              "adversarial-envelope"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "faults": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "qualifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "refines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "independence": {
      "type": "object",
      "properties": {
        "default": {
          "enum": [
            "conservative-dependent",
            "footprint",
            "semantic-oracle"
          ]
        },
        "oracle": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "crate"
        ],
        "properties": {
          "kind": {
            "enum": [
              "production",
              "lab",
              "abstract",
              "trace",
              "foreign"
            ]
          },
          "crate": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
